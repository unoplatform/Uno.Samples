<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Seed exceptions, not a palette. Three seeds in App.xaml generate every semantic role; the
      roles below are the ones the generator's recipe structurally cannot reach, so they are pinned
      back to the authored brand value. Colors.OverrideSource merges last and wins over the
      generated palette, and Uno.Themes rewrites the matching *Brush keys (and their hover/pressed/
      disabled variants) from these values.

      Both themes are declared for every role on purpose: the brush resolver probes Light then
      Default, so a role given only a Default value would bleed its dark color into light.

      Why these:
      - PrimaryColor / TertiaryColor (dark) — the generator pins dark accents to tone 80 so a brand
        color stays legible on a dark surface. This app authored mid-tone terracotta and amber, which
        come back noticeably paler. The light values are the seeds verbatim (SeedColorMode.Fidelity)
        and are restated only to keep each role complete.
    -->
    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="PrimaryColor">#B23A0A</Color>
            <Color x:Key="TertiaryColor">#B45309</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Default">
            <Color x:Key="PrimaryColor">#FB923C</Color>
            <Color x:Key="TertiaryColor">#FBBF24</Color>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
