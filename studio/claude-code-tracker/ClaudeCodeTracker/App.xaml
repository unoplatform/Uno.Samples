<Application x:Class="ClaudeCodeTracker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utu="using:Uno.Toolkit.UI"
             xmlns:utus="using:Uno.Toolkit.UI.Simple"
             xmlns:ut="using:Uno.Themes">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Load WinUI resources -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />

                <!-- Simple theme: the palette is generated from the three seeds below; typography tuned after -->
                <utus:SimpleToolkitTheme>
                  <utus:SimpleToolkitTheme.Colors>
                    <ut:ThemeColors PrimarySeed="#B23A0A" SecondarySeed="#0F766E" TertiarySeed="#B45309"
                                    OverrideSource="ms-appx:///ColorOverrides.xaml" />
                  </utus:SimpleToolkitTheme.Colors>
                  <utus:SimpleToolkitTheme.FontOverrideDictionary>
                        <ResourceDictionary>
                            <!--
                                Base face. The Simple theme's default is Uno's OpenSans, which has no
                                Regular face on the Skia stack, so Regular-weight body text can fall
                                back to a monospace face while only the bold headings stay
                                proportional. Roboto is a framework font that ships Regular / Medium /
                                Bold, so FontWeight selects real weights instead of faux-bold, and it
                                serves in hosted previews where bundled ms-appx fonts do not.
                            -->
                            <FontFamily x:Key="SimpleFontFamily">ms-appx:///Uno.Fonts.Roboto/Fonts/Roboto-Regular.ttf#Roboto</FontFamily>
                            <x:Double x:Key="DisplayLargeFontSize">52</x:Double>
                            <x:Double x:Key="DisplaySmallFontSize">34</x:Double>
                            <x:Double x:Key="HeadlineLargeFontSize">28</x:Double>
                            <FontFamily x:Key="TitleLargeFontFamily">Segoe UI Variable Display, Inter, system-ui</FontFamily>
                            <FontWeight x:Key="TitleLargeFontWeight">600</FontWeight>
                            <FontWeight x:Key="TitleMediumFontWeight">600</FontWeight>
                            <FontFamily x:Key="BodySmallFontFamily">Cascadia Code, JetBrains Mono, Consolas, monospace</FontFamily>
                            <FontFamily x:Key="LabelSmallFontFamily">Cascadia Code, JetBrains Mono, Consolas, monospace</FontFamily>
                            <x:Double x:Key="LabelSmallFontSize">12</x:Double>
                            <FontWeight x:Key="LabelMediumFontWeight">500</FontWeight>
                        </ResourceDictionary>
                  </utus:SimpleToolkitTheme.FontOverrideDictionary>
                </utus:SimpleToolkitTheme>

                <!-- Merged last so its ThemeDictionaries win over the Simple theme: pulls the Chip
                     states and the NavigationView selection indicator onto the warm palette. -->
                <ResourceDictionary Source="ms-appx:///ControlThemeOverrides.xaml" />

                <!-- Templates shared by the app's FeedViews (the failure state) -->
                <ResourceDictionary Source="ms-appx:///DataTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
              Slightly rounder corners than the Simple defaults, app-wide — aliased onto the theme's
              generated shape scale so they follow DefaultCornerRadius rather than pinning literals.
              Simple's own styles never read these; stock WinUI templates do, and would otherwise sit
              at WinUI's 4/8. At the default DefaultCornerRadius of 4 they resolve to 12/20, the
              values this app hard-coded. ControlCornerRadiusSmall is dropped: not a WinUI key, and
              read by nothing in Uno.UI, Uno.Themes or this app.
            -->
            <StaticResource x:Key="ControlCornerRadius" ResourceKey="Radius300CornerRadius" />
            <StaticResource x:Key="OverlayCornerRadius" ResourceKey="Radius500CornerRadius" />


        </ResourceDictionary>
    </Application.Resources>

</Application>
