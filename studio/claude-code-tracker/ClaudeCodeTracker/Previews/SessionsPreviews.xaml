<hd:PreviewGroup x:Class="ClaudeCodeTracker.Previews.SessionsPreviews"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="using:ClaudeCodeTracker.Presentation"
                 xmlns:mock="using:ClaudeCodeTracker.Presentation.MockData"
                 xmlns:hd="using:Uno.UI.HotDesign"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d">

    <!-- SessionsPage across the states the search and filter produce — the full history, a single
         model's sessions, and a query that matches nothing (the FeedView's NoneTemplate). The
         last two cannot be reached on a design surface by typing or tapping.
         Each child supplies the page's design-time DataContext in XAML — the only place the
         generated-ViewModel mock may be built, since the page Models now take ITrackerService
         by constructor injection. No size on the <hd:Preview>: a page fills the canvas. -->
    <hd:Preview PreviewName="All Sessions" Visibility="Collapsed">
        <local:SessionsPage DataContext="{x:Bind mock:SessionsPageMockData.Data}" />
    </hd:Preview>

    <hd:Preview PreviewName="Opus Only" Visibility="Collapsed">
        <local:SessionsPage DataContext="{x:Bind mock:SessionsPageMockData.OpusOnly}" />
    </hd:Preview>

    <hd:Preview PreviewName="No Results" Visibility="Collapsed">
        <local:SessionsPage DataContext="{x:Bind mock:SessionsPageMockData.NoResults}" />
    </hd:Preview>

</hd:PreviewGroup>
