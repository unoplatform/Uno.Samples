<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utu="using:Uno.Toolkit.UI"
                    xmlns:uen="using:Uno.Extensions.Navigation.UI">

    <!--
        Templates shared by the FeedViews across the app.

        Each list on Dashboard, Sessions and Usage is an IListFeed<T> fed by ITrackerService, so it
        can be in four states. The Value and None templates live next to the list they belong to,
        because their layout and their wording are specific to it. The failure state is not: a request
        that failed reads the same wherever it happened, so it is defined once here and every FeedView
        points its ErrorTemplate at it.

        The retry button binds the FeedView's own Refresh command, which re-issues the request that
        failed — no code-behind, and nothing for a page to remember to wire up.
    -->
    <DataTemplate x:Key="TrackerErrorTemplate">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="20,48,20,24"
                    Spacing="12">
            <TextBlock HorizontalAlignment="Center"
                       Style="{StaticResource BodyMedium}"
                       Foreground="{ThemeResource OnSurfaceVariantBrush}"
                       TextAlignment="Center"
                       Text="Couldn't load this from the tracker." />
            <Button HorizontalAlignment="Center"
                    Content="Try again"
                    Command="{Binding Refresh}" />
        </StackPanel>
    </DataTemplate>

    <!-- A session row on the Sessions page: clickable, and it navigates to the detail page. -->
    <DataTemplate x:Key="SessionRowTemplate">
                            <utu:CardContentControl Content="{Binding}"
                                                    Style="{StaticResource ElevatedCardContentControlStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    IsClickable="True"
                                                    AutomationProperties.Name="Session entry"
                                                    uen:Navigation.Request="SessionDetail"
                                                    uen:Navigation.Data="{Binding}">
                                <utu:CardContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <Grid Padding="14,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="6">
                                                <TextBlock Style="{StaticResource LabelMedium}"
                                                           Foreground="{ThemeResource OnSurfaceBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding ProjectName}" />
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Border Background="{ThemeResource SecondaryContainerBrush}"
                                                            CornerRadius="4"
                                                            Padding="6,2">
                                                        <TextBlock Style="{StaticResource LabelSmall}"
                                                                   Foreground="{ThemeResource OnSecondaryContainerBrush}"
                                                                   Text="{Binding ModelDisplayName}" />
                                                    </Border>
                                                    <TextBlock Style="{StaticResource LabelSmall}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                                               Text="&#xB7;" />
                                                    <TextBlock Style="{StaticResource LabelSmall}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{ThemeResource OnSurfaceVariantBrush}">
                                                        <Run Text="{Binding DurationMinutes}" /><Run Text=" min" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Style="{StaticResource LabelMedium}"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{ThemeResource PrimaryBrush}"
                                                           Text="{Binding CostDisplay}" />
                                                <TextBlock Style="{StaticResource LabelSmall}"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                                           Text="{Binding StartedAtDisplay}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </utu:CardContentControl.ContentTemplate>
                            </utu:CardContentControl>
                        </DataTemplate>
    <!-- A session in the Dashboard's recent-activity strip — the same data as
         SessionRowTemplate but not clickable, so it stays its own template. -->
    <DataTemplate x:Key="RecentSessionCardTemplate">
                                    <utu:CardContentControl Content="{Binding}"
                                                            Style="{StaticResource ElevatedCardContentControlStyle}"
                                                            IsClickable="False"
                                                            HorizontalAlignment="Stretch">
                                        <utu:CardContentControl.ContentTemplate>
                                            <DataTemplate>
                                                <Grid Padding="14,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Spacing="3">
                                                        <TextBlock Style="{StaticResource LabelMedium}"
                                                                   Foreground="{ThemeResource OnSurfaceBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Text="{Binding ProjectName}" />
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Style="{StaticResource LabelSmall}"
                                                                       Foreground="{ThemeResource SecondaryBrush}"
                                                                       Text="{Binding ModelDisplayName}" />
                                                            <TextBlock Style="{StaticResource LabelSmall}"
                                                                       Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                                                       Text="&#xB7;" />
                                                            <TextBlock Style="{StaticResource LabelSmall}"
                                                                       Foreground="{ThemeResource OnSurfaceVariantBrush}">
                                                                <Run Text="{Binding DurationMinutes}" /><Run Text=" min" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Style="{StaticResource LabelMedium}"
                                                                   HorizontalAlignment="Right"
                                                                   Foreground="{ThemeResource PrimaryBrush}"
                                                                   Text="{Binding CostDisplay}" />
                                                        <TextBlock Style="{StaticResource LabelSmall}"
                                                                   HorizontalAlignment="Right"
                                                                   Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                                                   Text="{Binding StartedAtDisplay}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </utu:CardContentControl.ContentTemplate>
                                    </utu:CardContentControl>
                                </DataTemplate>
    <!-- A model's spend and token share. Shared by the Dashboard's Model Usage panel and
         the Usage page's Model Usage & Cost table, which held byte-identical copies of it. -->
    <DataTemplate x:Key="ModelUsageRowTemplate">
                                                <StackPanel Spacing="4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Style="{StaticResource LabelMedium}"
                                                                   Foreground="{ThemeResource OnSurfaceBrush}"
                                                                   Text="{Binding ModelDisplayName}"
                                                                   Width="160" />
                                                        <TextBlock Grid.Column="2"
                                                                   Style="{StaticResource LabelSmall}"
                                                                   Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                                                   Text="{Binding TotalCostDisplay}" />
                                                    </Grid>
                                                    <ProgressBar Value="{Binding SharePercent}"
                                                                 Maximum="100"
                                                                 HorizontalAlignment="Stretch"
                                                                 Height="6" />
                                                    <TextBlock Style="{StaticResource LabelSmall}"
                                                               Foreground="{ThemeResource OnSurfaceVariantBrush}">
                                                        <Run Text="{Binding SessionCount}" /><Run Text=" sessions · " /><Run Text="{Binding SharePercentDisplay}" /><Run Text="% of tokens" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
    <!-- One plan rate limit with the fraction of it consumed. -->
    <DataTemplate x:Key="RateLimitCardTemplate">
                                    <utu:CardContentControl Content="{Binding}" Style="{StaticResource ElevatedCardContentControlStyle}" IsClickable="False" HorizontalAlignment="Stretch">
                                        <utu:CardContentControl.ContentTemplate>
                                            <DataTemplate>
                                                <StackPanel Padding="14,12" Spacing="8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Spacing="2">
                                                            <TextBlock Style="{StaticResource LabelMedium}" Foreground="{ThemeResource OnSurfaceBrush}" Text="{Binding LimitType}" />
                                                            <TextBlock Style="{StaticResource LabelSmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" Text="{Binding Description}" />
                                                        </StackPanel>
                                                        <!-- 12px gutter so the right-hand percent/reset never collide with a
                                                             wrapped left-column description on narrow widths -->
                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="1" Margin="12,0,0,0">
                                                            <TextBlock Style="{StaticResource LabelMedium}" HorizontalAlignment="Right" Foreground="{ThemeResource OnSurfaceBrush}">
                                                                <Run Text="{Binding UsedPercent}" /><Run Text="%" />
                                                            </TextBlock>
                                                            <TextBlock Style="{StaticResource LabelSmall}" HorizontalAlignment="Right" Foreground="{ThemeResource OnSurfaceVariantBrush}" Text="{Binding ResetIn}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <ProgressBar Value="{Binding UsedPercent}" Maximum="100" HorizontalAlignment="Stretch" Height="6" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </utu:CardContentControl.ContentTemplate>
                                    </utu:CardContentControl>
                                </DataTemplate>
    <!-- A row of the model price list. -->
    <DataTemplate x:Key="ModelPricingRowTemplate">
                                                <StackPanel Spacing="2">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="80" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Style="{StaticResource LabelMedium}" Foreground="{ThemeResource OnSurfaceBrush}" TextTrimming="CharacterEllipsis" Text="{Binding DisplayName}" />
                                                        <TextBlock Grid.Column="1" Style="{StaticResource LabelSmall}" Foreground="{ThemeResource PrimaryBrush}" HorizontalAlignment="Right" Text="{Binding InputPriceDisplay}" />
                                                        <TextBlock Grid.Column="2" Style="{StaticResource LabelSmall}" Foreground="{ThemeResource SecondaryBrush}" HorizontalAlignment="Right" Text="{Binding OutputPriceDisplay}" />
                                                    </Grid>
                                                    <TextBlock Style="{StaticResource LabelSmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}">
                                                        <Run Text="Cache " /><Run Text="{Binding CacheReadPriceDisplay}" /><Run Text=" read · " /><Run Text="{Binding CacheWritePriceDisplay}" /><Run Text=" write / 1M" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
    <!-- A swatch-and-label legend row. Shared by both Charts legends, which held
         byte-identical copies of it. -->
    <DataTemplate x:Key="ChartLegendRowTemplate">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{Binding Swatch, Converter={StaticResource ColorToBrush}}" />
                                                        <TextBlock Style="{StaticResource LabelSmall}" VerticalAlignment="Center" Foreground="{ThemeResource OnSurfaceVariantBrush}" Text="{Binding Label}" />
                                                        <TextBlock Style="{StaticResource LabelSmall}" VerticalAlignment="Center" Foreground="{ThemeResource OnSurfaceBrush}" Text="{Binding ValueDisplay}" />
                                                    </StackPanel>
                                                </DataTemplate>
    <!-- A topic tag chip on the session detail page. -->
    <DataTemplate x:Key="TopicTagTemplate">
                                                <Border Background="{ThemeResource SurfaceVariantBrush}"
                                                        CornerRadius="6"
                                                        Padding="10,4">
                                                    <TextBlock Style="{StaticResource LabelSmall}"
                                                               Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                                               Text="{Binding}" />
                                                </Border>
                                            </DataTemplate>

</ResourceDictionary>
