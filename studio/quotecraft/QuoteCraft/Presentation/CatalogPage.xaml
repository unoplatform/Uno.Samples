<Page x:Class="QuoteCraft.Presentation.CatalogPage"
      x:Name="CatalogRoot"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:QuoteCraft.Presentation"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:um="using:Uno.Material"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      Background="{ThemeResource BackgroundBrush}">

  <!--
    Catalog per category (same frame as Quotes):
      Narrow   header on two rows; category cards two across; a category opens over the cards with a back button.
      Normal   header on one row; three or more cards across; otherwise as Narrow.
      Wide     as Normal, with more cards across.
      Widest   cards (380) and the category's items side by side, content capped at PageMaxWidth.
  -->
  <Grid utu:SafeArea.Insets="Top">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>

    <!-- Header band -->
    <Border Background="{ThemeResource SurfaceBrush}"
            BorderBrush="{ThemeResource OutlineVariantBrush}"
            BorderThickness="0,0,0,1">
      <Grid MaxWidth="{StaticResource PageMaxWidth}"
            MinHeight="{StaticResource PageHeaderHeight}"
            Padding="{utu:Responsive Narrow={StaticResource PageHeaderInsetNarrow}, Normal={StaticResource Space300HorizontalThickness}, Wide={StaticResource Space400HorizontalThickness}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Catalog"
                   Style="{StaticResource TitleLargeBold}"
                   AutomationProperties.HeadingLevel="Level1"
                   VerticalAlignment="Center" />

        <!-- A primitive feed binds directly: a FeedView over IFeed<int> never leaves its progress template -->
        <TextBlock Grid.Column="1"
                   Style="{StaticResource BodyMedium}"
                   Foreground="{ThemeResource OnSurfaceVariantBrush}"
                   VerticalAlignment="Center" Margin="{StaticResource Space100LeftThickness}">
          <Run Text="{Binding CatalogItemCount}" /><Run Text=" items" />
        </TextBlock>

        <!-- Search (under the title row on Narrow) -->
        <utu:CardContentControl Style="{StaticResource TonalCardStyle}" Grid.Row="{utu:Responsive Narrow=1, Normal=0}"
                Grid.Column="{utu:Responsive Narrow=0, Normal=2}"
                Grid.ColumnSpan="{utu:Responsive Narrow=4, Normal=1}"
                Padding="{StaticResource Space150HorizontalThickness}"
                Height="{StaticResource ControlHeightMedium}"
                MinWidth="{utu:Responsive Narrow=0, Normal={StaticResource SearchMinWidth}}"
                MaxWidth="{utu:Responsive Narrow={StaticResource SearchMaxWidthNarrow}, Normal={StaticResource SearchMaxWidth}}"
                HorizontalAlignment="{utu:Responsive Narrow=Stretch, Normal=Right}"
                VerticalAlignment="Center"
                Margin="{utu:Responsive Narrow={StaticResource Space100VerticalThickness}, Normal={StaticResource Space200HorizontalThickness}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE721;" FontSize="{StaticResource BodyMediumFontSize}"
                      Foreground="{ThemeResource OnSurfaceVariantBrush}"
                      VerticalAlignment="Center" Margin="{StaticResource Space100RightThickness}" />
            <TextBox Grid.Column="1"
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Search catalog..."
                     AutomationProperties.Name="Search catalog"
                     BorderThickness="0" Background="Transparent"
                     Padding="0" MinHeight="0"
                     VerticalAlignment="Center"
                     VerticalContentAlignment="Center" />
          </Grid>
        </utu:CardContentControl>

        <Button Grid.Column="3"
                Command="{Binding AddItem}"
                AutomationProperties.Name="Add catalog item"
                Style="{StaticResource AccentButtonStyle}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}">
            <FontIcon Glyph="&#xE710;" FontSize="{StaticResource BodySmallFontSize}" />
            <TextBlock Text="Add Item" Style="{StaticResource LabelLargeSemiBold}" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- Body: category cards, and the category's items (beside them from 1080, over them below) -->
    <Grid Grid.Row="1" MaxWidth="{StaticResource PageMaxWidth}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Grid Grid.ColumnSpan="{utu:Responsive Narrow=2, Widest=1}"
            Width="{utu:Responsive Narrow=NaN, Widest={StaticResource ListPaneWidth}}"
            BorderBrush="{ThemeResource OutlineVariantBrush}"
            BorderThickness="{utu:Responsive Narrow='0', Widest='0,0,1,0'}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition />
        </Grid.RowDefinitions>

        <TextBlock Text="Select a category to view and manage items"
                   Style="{StaticResource BodySmall}"
                   Foreground="{ThemeResource OnSurfaceVariantBrush}"
                   TextWrapping="Wrap"
                   Margin="{utu:Responsive Narrow={StaticResource BandInsetNarrow}, Normal={StaticResource BandInsetNormal}, Widest={StaticResource BandInsetNarrow}}" />

        <!-- Category Cards -->
        <mvux:FeedView Grid.Row="1" Source="{Binding CategoryCards}">
          <DataTemplate>
            <ScrollViewer Padding="{utu:Responsive Narrow={StaticResource ListInsetNarrow}, Normal={StaticResource ListInsetNormal}, Widest={StaticResource ListInsetWidest}}">
              <muxc:ItemsRepeater ItemsSource="{Binding Data}" TabFocusNavigation="Local">
                <muxc:ItemsRepeater.Layout>
                  <muxc:UniformGridLayout MinItemWidth="156" MinItemHeight="130"
                                          MinColumnSpacing="{StaticResource Space100}" MinRowSpacing="{StaticResource Space100}"
                                          ItemsStretch="Fill" />
                </muxc:ItemsRepeater.Layout>
                <muxc:ItemsRepeater.ItemTemplate>
                  <DataTemplate>
                    <!-- The card is a button: tap, Enter or Space opens the category (again closes it) -->
                    <utu:CardContentControl Style="{StaticResource StaticCardStyle}">
                      <Button Command="{Binding DataContext.SelectCategoryCard, ElementName=CatalogRoot}"
                              CommandParameter="{Binding}"
                              AutomationProperties.Name="{Binding Name}"
                              Style="{StaticResource ListCardButtonStyle}"
                              CornerRadius="{StaticResource Radius300CornerRadius}"
                              Padding="{StaticResource Space200Thickness}"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center">
                        <StackPanel Spacing="{StaticResource Space100}" VerticalAlignment="Center" HorizontalAlignment="Center">
                          <utu:CardContentControl Style="{StaticResource AvatarCardStyle}" Width="{StaticResource AvatarSize}" Height="{StaticResource AvatarSize}" CornerRadius="{StaticResource RadiusFullCornerRadius}">
                            <FontIcon Glyph="{Binding IconGlyph}"
                                      FontSize="{StaticResource IconSizeSmall}"
                                      Foreground="{ThemeResource OnPrimaryContainerBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </utu:CardContentControl>
                          <TextBlock Text="{Binding Name}"
                                     Style="{StaticResource TitleSmall}"
                                     FontWeight="SemiBold"
                                     HorizontalAlignment="Center"
                                     TextAlignment="Center" TextWrapping="Wrap" />
                          <TextBlock Style="{StaticResource BodySmall}"
                                     Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                     HorizontalAlignment="Center">
                            <Run Text="{Binding ItemCount}" />
                            <Run Text=" items" />
                          </TextBlock>
                        </StackPanel>
                      </Button>
                    </utu:CardContentControl>
                  </DataTemplate>
                </muxc:ItemsRepeater.ItemTemplate>
              </muxc:ItemsRepeater>
            </ScrollViewer>
          </DataTemplate>

          <mvux:FeedView.NoneTemplate>
            <DataTemplate>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                          Spacing="{StaticResource Space150}" Padding="{StaticResource Space300Thickness}">
                <FontIcon Glyph="&#xE82D;" FontSize="{StaticResource IconSizeLarge}"
                          Foreground="{ThemeResource OnSurfaceVariantBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Nothing in the catalog here" Style="{StaticResource TitleSmall}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                <TextBlock Text="Add items to your pricing catalog for faster quoting, or clear the search."
                           Style="{StaticResource BodyMedium}"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="{StaticResource HintMaxWidth}" />
                <Button Command="{Binding DataContext.AddItem, ElementName=CatalogRoot}"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center" Margin="{StaticResource Space100TopThickness}"
                        AutomationProperties.Name="Add catalog item">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}">
                    <FontIcon Glyph="&#xE710;" FontSize="{StaticResource BodySmallFontSize}" />
                    <TextBlock Text="Add Item" Style="{StaticResource LabelLargeSemiBold}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </DataTemplate>
          </mvux:FeedView.NoneTemplate>

          <mvux:FeedView.ProgressTemplate>
            <DataTemplate>
              <ProgressRing IsActive="True" HorizontalAlignment="Center" VerticalAlignment="Center"
                            AutomationProperties.Name="Loading catalog" />
            </DataTemplate>
          </mvux:FeedView.ProgressTemplate>

          <mvux:FeedView.ErrorTemplate>
            <DataTemplate>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                          Spacing="{StaticResource Space150}" Padding="{StaticResource Space300Thickness}"
                          AutomationProperties.LiveSetting="Polite">
                <FontIcon Glyph="&#xE783;" FontSize="{StaticResource IconSizeLarge}"
                          Foreground="{ThemeResource ErrorBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="The catalog could not be loaded." Style="{StaticResource TitleSmall}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                <Button Content="Retry"
                        Command="{Binding DataContext.RefreshList, ElementName=CatalogRoot}"
                        Style="{StaticResource OutlinedButtonStyle}"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="Retry loading the catalog" />
              </StackPanel>
            </DataTemplate>
          </mvux:FeedView.ErrorTemplate>
        </mvux:FeedView>
      </Grid>

      <!-- Category Detail: beside the cards from 1080, over them below -->
      <mvux:FeedView Grid.Column="{utu:Responsive Narrow=0, Widest=1}"
                     Grid.ColumnSpan="{utu:Responsive Narrow=2, Widest=1}"
                     Source="{Binding SelectedCategoryDetail}">
        <DataTemplate>
          <ScrollViewer Background="{ThemeResource BackgroundBrush}"
                        Padding="{utu:Responsive Narrow={StaticResource PaneInsetNarrow}, Normal={StaticResource PaneInsetNormal}, Wide={StaticResource PaneInsetWide}, Widest={StaticResource PaneInsetWide}}">
            <StackPanel Spacing="{StaticResource Space200}" HorizontalAlignment="Stretch">

              <!-- Back to the categories (one-pane layouts) -->
              <Button Command="{Binding DataContext.BackToList, ElementName=CatalogRoot}"
                      Visibility="{utu:Responsive Narrow=Visible, Widest=Collapsed}"
                      Style="{StaticResource TextButtonStyle}"
                      MinHeight="{StaticResource ControlHeightMediumLarge}"
                      Margin="{StaticResource LeadingIconNudge}"
                      AutomationProperties.Name="Back to categories">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}">
                  <FontIcon Glyph="&#xE72B;" FontSize="{StaticResource BodyMediumFontSize}" />
                  <TextBlock Text="Categories" />
                </StackPanel>
              </Button>

              <!-- Category Detail Header -->
              <Grid ColumnSpacing="{StaticResource Space200}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <utu:CardContentControl Style="{StaticResource AvatarCardStyle}" Width="{StaticResource LogoSize}" Height="{StaticResource LogoSize}" CornerRadius="{StaticResource RadiusFullCornerRadius}">
                  <FontIcon Glyph="{Binding Data.IconGlyph}" FontSize="{StaticResource IconSizeMedium}"
                            Foreground="{ThemeResource OnPrimaryContainerBrush}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                </utu:CardContentControl>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource Space025}">
                  <TextBlock Text="{Binding Data.Name}"
                             Style="{StaticResource HeadlineMedium}"
                             AutomationProperties.HeadingLevel="Level2"
                             TextWrapping="Wrap" />
                  <TextBlock Style="{StaticResource BodySmall}"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}">
                    <Run Text="{Binding Data.Items.Count}" />
                    <Run Text=" items in this category" />
                  </TextBlock>
                </StackPanel>

                <Button Grid.Column="2"
                        Command="{Binding DataContext.AddItemToCategory, ElementName=CatalogRoot}"
                        AutomationProperties.Name="Add item to category"
                        ToolTipService.ToolTip="Add item to category"
                        Style="{StaticResource AccentButtonStyle}"
                        MinWidth="{StaticResource ControlHeightMediumLarge}">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}">
                    <FontIcon Glyph="&#xE710;" FontSize="{StaticResource BodySmallFontSize}" />
                    <TextBlock Text="Add Item" Visibility="{utu:Responsive Narrow=Collapsed, Normal=Visible}" Style="{StaticResource LabelLargeSemiBold}" />
                  </StackPanel>
                </Button>
              </Grid>

              <!-- Items List -->
              <utu:CardContentControl Style="{StaticResource StaticCardStyle}"
                      Padding="{utu:Responsive Narrow={StaticResource Space100Thickness}, Normal={StaticResource Space200Thickness}}">
                <muxc:ItemsRepeater ItemsSource="{Binding Data.Items}" TabFocusNavigation="Local">
                  <muxc:ItemsRepeater.Layout>
                    <muxc:StackLayout Spacing="{StaticResource Space050}" />
                  </muxc:ItemsRepeater.Layout>
                  <muxc:ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                      <!-- The row is a button: tap, Enter or Space opens the item -->
                      <utu:CardContentControl Style="{StaticResource StaticCardStyle}" Background="{ThemeResource BackgroundBrush}"
                              CornerRadius="{StaticResource Radius200CornerRadius}">
                        <Button Command="{Binding DataContext.EditItem, ElementName=CatalogRoot}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding Description}"
                                Style="{StaticResource ListCardButtonStyle}"
                                Padding="{StaticResource Inset16x12}"
                                MinHeight="{StaticResource TouchTargetMinSize}">
                          <Grid ColumnSpacing="{StaticResource Space150}">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Description}"
                                       Style="{StaticResource BodyMedium}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding UnitPrice, Converter={StaticResource CurrencyFormatConverter}}"
                                       FontFamily="{StaticResource MonospaceFontFamily}"
                                       Style="{StaticResource BodyMedium}"
                                       Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                       VerticalAlignment="Center" />
                          </Grid>
                        </Button>
                      </utu:CardContentControl>
                    </DataTemplate>
                  </muxc:ItemsRepeater.ItemTemplate>
                </muxc:ItemsRepeater>
              </utu:CardContentControl>

            </StackPanel>
          </ScrollViewer>
        </DataTemplate>

        <mvux:FeedView.NoneTemplate>
          <DataTemplate>
            <!-- Only beside the cards: in the one-pane layouts the cards show until a category is picked. -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{utu:Responsive Narrow=Collapsed, Widest=Visible}"
                        Spacing="{StaticResource Space150}" Padding="{StaticResource Space400Thickness}">
              <FontIcon Glyph="&#xE82D;" FontSize="{StaticResource HeroIconSize}"
                        Foreground="{ThemeResource OnSurfaceVariantBrush}" HorizontalAlignment="Center" />
              <TextBlock Text="Select a category" Style="{StaticResource TitleSmall}"
                         HorizontalAlignment="Center"
                         Foreground="{ThemeResource OnSurfaceVariantBrush}" />
              <TextBlock Text="Choose a category from the list to browse and manage items."
                         Style="{StaticResource BodyMedium}" HorizontalAlignment="Center"
                         Foreground="{ThemeResource OnSurfaceVariantBrush}"
                         TextAlignment="Center" TextWrapping="Wrap" MaxWidth="{StaticResource HintMaxWidth}" />
            </StackPanel>
          </DataTemplate>
        </mvux:FeedView.NoneTemplate>

        <mvux:FeedView.ProgressTemplate>
          <DataTemplate>
            <ProgressRing IsActive="True" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Visibility="{utu:Responsive Narrow=Collapsed, Widest=Visible}"
                          AutomationProperties.Name="Loading category" />
          </DataTemplate>
        </mvux:FeedView.ProgressTemplate>

        <mvux:FeedView.ErrorTemplate>
          <DataTemplate>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{ThemeResource BackgroundBrush}"
                        Spacing="{StaticResource Space150}" Padding="{StaticResource Space400Thickness}"
                        AutomationProperties.LiveSetting="Polite">
              <FontIcon Glyph="&#xE783;" FontSize="{StaticResource HeroIconSize}"
                        Foreground="{ThemeResource ErrorBrush}" HorizontalAlignment="Center" />
              <TextBlock Text="This category could not be loaded." Style="{StaticResource TitleSmall}"
                         HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}" HorizontalAlignment="Center">
                <Button Content="Back"
                        Command="{Binding DataContext.BackToList, ElementName=CatalogRoot}"
                        Style="{StaticResource TextButtonStyle}"
                        AutomationProperties.Name="Back to categories" />
                <Button Content="Retry"
                        Command="{Binding DataContext.RefreshList, ElementName=CatalogRoot}"
                        Style="{StaticResource OutlinedButtonStyle}"
                        AutomationProperties.Name="Retry loading the category" />
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </mvux:FeedView.ErrorTemplate>
      </mvux:FeedView>
    </Grid>
  </Grid>
</Page>
