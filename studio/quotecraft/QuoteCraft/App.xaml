<Application x:Class="QuoteCraft.App"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
       xmlns:helpers="using:QuoteCraft.Helpers"
       xmlns:utu="using:Uno.Toolkit.UI"
       xmlns:utum="using:Uno.Toolkit.UI.Material"
       xmlns:ut="using:Uno.Themes"
       xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <!--
          Material with the Toolkit. The palette (Styles/ColorPaletteOverride.xaml, Light and Dark) is the one place the
          brand's colours live: Uno Platform Studio's Themes tab edits it, and every role brush, control and page follows.
          The design's typeface is DM Sans: DefaultFontFamily sets the theme's root font and every type-scale family
          (BodyMedium, TitleLarge...); weights resolve through Assets/Fonts/DMSans-Regular.ttf.manifest.
          The design's bases are the theme's own: an 8 px spacing unit (Space100 = 8, Space200 = 16...) and a 4 px corner
          unit (Radius100 = 4, Radius200 = 8...). Pages take those tokens, so a change here or in Studio respaces them.
        -->
        <utum:MaterialToolkitTheme DefaultFontFamily="ms-appx:///Assets/Fonts/DMSans-Regular.ttf#DM Sans"
                                   DefaultSpacing="8"
                                   DefaultCornerRadius="4">
          <utum:MaterialToolkitTheme.Colors>
            <ut:ThemeColors OverrideSource="ms-appx:///Styles/ColorPaletteOverride.xaml" />
          </utum:MaterialToolkitTheme.Colors>
        </utum:MaterialToolkitTheme>
        <ResourceDictionary Source="ms-appx:///Styles/Layout.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/Cards.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!--
        Light and Default (Dark) colours the palette has no role for, the only hex outside it. Every colour with a role is
        the palette's (Styles/ColorPaletteOverride.xaml), used through the role's brush: Draft and Expired are the
        SurfaceVariant pair, Viewed the SecondaryContainer pair and Declined the ErrorContainer pair. What stays here is
        green for an accepted quote and a done step (Success), and the blue of a sent quote. Each pair is at least
        4.5:1, and a status pill always carries its name and an icon, so colour is never the only signal.
        The rail's Theme button shows the window's theme: a sun in Light, a moon in Dark.
      -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="SuccessBrush" Color="#047857" />
          <SolidColorBrush x:Key="SuccessContainerBrush" Color="#D1FAE5" />
          <SolidColorBrush x:Key="StatusSentBrush" Color="#1D4ED8" />
          <SolidColorBrush x:Key="StatusSentContainerBrush" Color="#DBEAFE" />
          <x:String x:Key="ThemeIconGlyph">&#xE706;</x:String>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
          <SolidColorBrush x:Key="SuccessBrush" Color="#6EE7B7" />
          <SolidColorBrush x:Key="SuccessContainerBrush" Color="#064E3B" />
          <SolidColorBrush x:Key="StatusSentBrush" Color="#93BBFD" />
          <SolidColorBrush x:Key="StatusSentContainerBrush" Color="#1E3A5F" />
          <x:String x:Key="ThemeIconGlyph">&#xE708;</x:String>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!--
        Cards here are surfaces, not buttons (Styles/Cards.xaml, D16): no Material hover, pressed or focus wash. On
        touch, a swipe that starts on a card could leave the hover wash up. A list card's states come from the button it
        holds (ListCardButtonStyle).
      -->
      <SolidColorBrush x:Key="FilledCardContentBorderBrushPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="FilledCardContentBorderBrushPressed" Color="Transparent" />
      <SolidColorBrush x:Key="FilledCardContentBorderBrushFocused" Color="Transparent" />
      <SolidColorBrush x:Key="ElevatedCardContentBorderBrushPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="ElevatedCardContentBorderBrushPressed" Color="Transparent" />
      <SolidColorBrush x:Key="ElevatedCardContentBorderBrushFocused" Color="Transparent" />

      <!-- Bold/SemiBold typography variants (derived from Material styles) -->
      <Style x:Key="HeadlineMediumBold" TargetType="TextBlock" BasedOn="{StaticResource HeadlineMedium}">
        <Setter Property="FontWeight" Value="Bold" />
      </Style>
      <Style x:Key="HeadlineSmallBold" TargetType="TextBlock" BasedOn="{StaticResource HeadlineSmall}">
        <Setter Property="FontWeight" Value="Bold" />
      </Style>
      <Style x:Key="TitleLargeBold" TargetType="TextBlock" BasedOn="{StaticResource TitleLarge}">
        <Setter Property="FontWeight" Value="Bold" />
      </Style>
      <Style x:Key="TitleMediumBold" TargetType="TextBlock" BasedOn="{StaticResource TitleMedium}">
        <Setter Property="FontWeight" Value="Bold" />
      </Style>
      <Style x:Key="LabelLargeSemiBold" TargetType="TextBlock" BasedOn="{StaticResource LabelLarge}">
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="BodyMediumWeightMedium" TargetType="TextBlock" BasedOn="{StaticResource BodyMedium}">
        <Setter Property="FontWeight" Value="Medium" />
      </Style>
      <Style x:Key="BodyMediumSemiBold" TargetType="TextBlock" BasedOn="{StaticResource BodyMedium}">
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="BodySmallSemiBold" TargetType="TextBlock" BasedOn="{StaticResource BodySmall}">
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>

      <!--
        Keyboard: a FeedView is a Control and a tab stop by default, so Tab stopped on an invisible wrapper before
        the content it shows. Its templates' controls take focus; the FeedView itself never does.
        States: every message sets the loading, error and data states (WholeFeedViewStateSelector says why).
      -->
      <helpers:WholeFeedViewStateSelector x:Key="WholeFeedViewStateSelector" />
      <Style TargetType="mvux:FeedView">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="VisualStateSelector" Value="{StaticResource WholeFeedViewStateSelector}" />
      </Style>

      <!-- Value Converters -->
      <helpers:CurrencyFormatConverter x:Key="CurrencyFormatConverter" />
      <helpers:RateFormatConverter x:Key="RateFormatConverter" />
      <helpers:RelativeDateConverter x:Key="RelativeDateConverter" />
      <helpers:InitialsConverter x:Key="InitialsConverter" />
      <helpers:EmptyToVisibleConverter x:Key="EmptyToVisibleConverter" />
      <helpers:ShortDateConverter x:Key="ShortDateConverter" />
      <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />
      <helpers:StepVisibilityConverter x:Key="StepVisibilityConverter" />
      <!-- WinUI's {Binding} does not turn a bool into a Visibility (only x:Bind does): every bool-bound Visibility uses this. -->
      <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
      <helpers:ZeroToVisibleConverter x:Key="ZeroToVisibleConverter" />

      <!-- Disabled controls -->
      <x:Double x:Key="DisabledOpacity">0.4</x:Double>

      <!-- The design's figure font (amounts, quantities, quote numbers): a second family, which the theme has no key for -->
      <FontFamily x:Key="MonospaceFontFamily">ms-appx:///Assets/Fonts/JetBrainsMono-Regular.ttf#JetBrains Mono</FontFamily>

      <!--
        The amber call to action (New Quote, Send, Add Item...): the theme's filled button on the Secondary role, through
        its lightweight-styling keys. The design keeps the amber the same in Light and Dark, so the palette gives
        Secondary one value in both. Content inherits OnSecondary; hover and pressed are the theme's state layers.
      -->
      <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource FilledButtonStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource Radius200CornerRadius}" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeightMediumLarge}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="utu:ResourceExtensions.Resources">
          <Setter.Value>
            <ResourceDictionary>
              <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                  <StaticResource x:Key="FilledButtonBackground" ResourceKey="SecondaryBrush" />
                  <StaticResource x:Key="FilledButtonBackgroundPointerOver" ResourceKey="SecondaryBrush" />
                  <StaticResource x:Key="FilledButtonBackgroundPressed" ResourceKey="SecondaryBrush" />
                  <StaticResource x:Key="FilledButtonForeground" ResourceKey="OnSecondaryBrush" />
                  <StaticResource x:Key="FilledButtonForegroundPointerOver" ResourceKey="OnSecondaryBrush" />
                  <StaticResource x:Key="FilledButtonForegroundPressed" ResourceKey="OnSecondaryBrush" />
                  <StaticResource x:Key="FilledButtonIconForeground" ResourceKey="OnSecondaryBrush" />
                  <StaticResource x:Key="FilledButtonIconForegroundPointerOver" ResourceKey="OnSecondaryBrush" />
                  <StaticResource x:Key="FilledButtonIconForegroundPressed" ResourceKey="OnSecondaryBrush" />
                  <StaticResource x:Key="FilledButtonStateLayerBackgroundPointerOver" ResourceKey="OnSecondaryHoverBrush" />
                  <StaticResource x:Key="FilledButtonStateLayerBackgroundPressed" ResourceKey="OnSecondaryPressedBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                  <StaticResource x:Key="FilledButtonBackground" ResourceKey="SecondaryBrush" />
                  <StaticResource x:Key="FilledButtonBackgroundPointerOver" ResourceKey="SecondaryBrush" />
                  <StaticResource x:Key="FilledButtonBackgroundPressed" ResourceKey="SecondaryBrush" />
                  <StaticResource x:Key="FilledButtonForeground" ResourceKey="OnSecondaryBrush" />
                  <StaticResource x:Key="FilledButtonForegroundPointerOver" ResourceKey="OnSecondaryBrush" />
                  <StaticResource x:Key="FilledButtonForegroundPressed" ResourceKey="OnSecondaryBrush" />
                  <StaticResource x:Key="FilledButtonIconForeground" ResourceKey="OnSecondaryBrush" />
                  <StaticResource x:Key="FilledButtonIconForegroundPointerOver" ResourceKey="OnSecondaryBrush" />
                  <StaticResource x:Key="FilledButtonIconForegroundPressed" ResourceKey="OnSecondaryBrush" />
                  <StaticResource x:Key="FilledButtonStateLayerBackgroundPointerOver" ResourceKey="OnSecondaryHoverBrush" />
                  <StaticResource x:Key="FilledButtonStateLayerBackgroundPressed" ResourceKey="OnSecondaryPressedBrush" />
                </ResourceDictionary>
              </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
          </Setter.Value>
        </Setter>
      </Style>

      <!--
        The app's dialogs: the theme's dialog with its surface through ThemeResource. Material's style sets the dialog's
        Background with a StaticResource alias of SurfaceBrush, which keeps the first theme's surface: a dialog open while
        the theme changed, or opened in the other theme, drew Light under Dark content. Each dialog also takes the window's
        theme as it is built (Helpers/DialogTheme), since it opens in a popup outside the content the theme service themes.
      -->
      <Style x:Key="AppDialogStyle" TargetType="ContentDialog" BasedOn="{StaticResource ContentDialogStyle}">
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
      </Style>

      <!-- Drawers opened by "!" Page routes (Presentation/DrawerFlyout): from the right, sized for a list. -->
      <Style x:Key="SideDrawerFlyoutPresenterStyle" TargetType="FlyoutPresenter" BasedOn="{StaticResource RightDrawerFlyoutPresenterStyle}">
        <Setter Property="utu:DrawerFlyoutPresenter.DrawerLength" Value="420" />
      </Style>
      <!--
        microsoft/microsoft-ui-xaml#6388 (WinAppSDK only): an attached-property setter in a style BasedOn a style whose
        template lives in another library throws when the template is created, unless the consuming assembly also
        references those properties in a template. The Toolkit docs prescribe this definition-only style; it is never used.
      -->
      <win:Style x:Key="MUX6388_Workaround_ForDefinitionOnly" TargetType="FlyoutPresenter">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="FlyoutPresenter">
              <utu:DrawerFlyoutPresenter OpenDirection="{TemplateBinding utu:DrawerFlyoutPresenter.OpenDirection}"
                                         DrawerLength="{TemplateBinding utu:DrawerFlyoutPresenter.DrawerLength}"
                                         LightDismissOverlayBackground="{TemplateBinding utu:DrawerFlyoutPresenter.LightDismissOverlayBackground}"
                                         IsGestureEnabled="{TemplateBinding utu:DrawerFlyoutPresenter.IsGestureEnabled}"
                                         IsLightDismissEnabled="{TemplateBinding utu:DrawerFlyoutPresenter.IsLightDismissEnabled}" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </win:Style>

      <!-- Inline TextBox Style (compact, no Material chrome, with focus states): Settings' right-aligned value fields -->
      <Style x:Key="InlineTextBoxStyle" TargetType="TextBox">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="{StaticResource Inset8x4}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
        <Setter Property="FontSize" Value="{StaticResource BodyMediumFontSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TextBox">
              <Border x:Name="RootBorder"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      Padding="{TemplateBinding Padding}"
                      CornerRadius="{StaticResource Radius100CornerRadius}">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                       Storyboard.TargetProperty="BorderBrush">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource OnSurfaceVariantBrush}" />
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Focused">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                       Storyboard.TargetProperty="BorderBrush">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource PrimaryBrush}" />
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                       Storyboard.TargetProperty="BorderThickness">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="0,0,0,2" />
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                       Storyboard.TargetProperty="Opacity">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource DisabledOpacity}" />
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid>
                  <!-- The TextBox shows this part while the text is empty (inline fields are right-aligned) -->
                  <ContentControl x:Name="PlaceholderTextContentPresenter"
                                  Content="{TemplateBinding PlaceholderText}"
                                  Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                  HorizontalContentAlignment="Right"
                                  HorizontalAlignment="Stretch"
                                  IsHitTestVisible="False"
                                  IsTabStop="False" />
                  <ScrollViewer x:Name="ContentElement"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden"
                                HorizontalScrollMode="Auto"
                                VerticalScrollMode="Disabled"
                                IsHorizontalRailEnabled="True"
                                IsVerticalRailEnabled="False"
                                IsTabStop="False"
                                AutomationProperties.AccessibilityView="Raw" />
                </Grid>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Vertical TabBar Style (no background, no chrome) -->
      <Style x:Key="VerticalTabBarStyle" TargetType="utu:TabBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
      </Style>

      <!--
        Side Nav TabBarItem Style (horizontal icon + label, which the Toolkit's vertical tab bar does not lay out). Its
        states are the Primary role's: the hover and pressed state layers, and the PrimaryContainer pair when selected.
      -->
      <Style x:Key="SideNavTabBarItemStyle" TargetType="utu:TabBarItem">
        <Setter Property="Height" Value="{StaticResource ControlHeightMediumLarge}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="utu:TabBarItem">
              <Border x:Name="RootBorder"
                      Background="Transparent"
                      CornerRadius="{StaticResource Radius200CornerRadius}"
                      Padding="{StaticResource RailItemInset}"
                      Margin="{StaticResource RailItemMargin}">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                       Storyboard.TargetProperty="Background">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource PrimaryHoverBrush}" />
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                       Storyboard.TargetProperty="Background">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource PrimaryPressedBrush}" />
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                       Storyboard.TargetProperty="Opacity">
                          <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{StaticResource DisabledOpacity}" />
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Selected">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                       Storyboard.TargetProperty="Background">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource PrimaryContainerBrush}" />
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="IconHost"
                                                       Storyboard.TargetProperty="Foreground">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource OnPrimaryContainerBrush}" />
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LabelText"
                                                       Storyboard.TargetProperty="Foreground">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource OnPrimaryContainerBrush}" />
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space150}">
                  <ContentControl x:Name="IconHost"
                                  Content="{TemplateBinding Icon}"
                                  Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                  IsTabStop="False"
                                  VerticalAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  HorizontalContentAlignment="Center" />
                  <TextBlock x:Name="LabelText"
                             Text="{TemplateBinding Content}"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}"
                             Style="{StaticResource LabelLarge}"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

    </ResourceDictionary>
  </Application.Resources>

</Application>
