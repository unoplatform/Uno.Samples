<hd:PreviewGroup x:Class="Voyago.Previews.DestinationDetailDialogPreviews"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="using:Voyago.Presentation"
                 xmlns:mock="using:Voyago.Presentation.MockData"
                 xmlns:hd="using:Uno.UI.HotDesign"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d">

    <!-- The same detail as the desktop modal (lesson 64) — the surface a wide window opens instead of
         the page, so it is worth previewing separately.
         Each child supplies the design-time DataContext in XAML — the only safe place for the
         generated-ViewModel mock, which must never be seeded from a page constructor. No size on the
         <hd:Preview>: the surface fills the canvas / device frame. -->
    <hd:Preview PreviewName="Not Booked" Visibility="Collapsed">
        <local:DestinationDetailDialog DataContext="{x:Bind mock:DestinationDetailMockData.Data}" />
    </hd:Preview>

    <hd:Preview PreviewName="Booked" Visibility="Collapsed">
        <local:DestinationDetailDialog DataContext="{x:Bind mock:DestinationDetailMockData.Booked}" />
    </hd:Preview>

</hd:PreviewGroup>
