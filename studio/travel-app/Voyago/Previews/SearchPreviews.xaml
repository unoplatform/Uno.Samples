<hd:PreviewGroup x:Class="Voyago.Previews.SearchPreviews"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="using:Voyago.Presentation"
                 xmlns:mock="using:Voyago.Presentation.MockData"
                 xmlns:hd="using:Uno.UI.HotDesign"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d">

    <!-- The search page with the popular set (an empty query) and with a query that matches nothing —
         the results FeedView's NoneTemplate.
         Each child supplies the design-time DataContext in XAML — the only safe place for the
         generated-ViewModel mock, which must never be seeded from a page constructor. No size on the
         <hd:Preview>: the surface fills the canvas / device frame. -->
    <hd:Preview PreviewName="Popular" Visibility="Collapsed">
        <local:SearchPage DataContext="{x:Bind mock:SearchPageMockData.Data}" />
    </hd:Preview>

    <hd:Preview PreviewName="No Results" Visibility="Collapsed">
        <local:SearchPage DataContext="{x:Bind mock:SearchPageMockData.NoResults}" />
    </hd:Preview>

</hd:PreviewGroup>
