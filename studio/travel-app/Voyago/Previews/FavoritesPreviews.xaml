<hd:PreviewGroup x:Class="Voyago.Previews.FavoritesPreviews"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="using:Voyago.Presentation"
                 xmlns:mock="using:Voyago.Presentation.MockData"
                 xmlns:hd="using:Uno.UI.HotDesign"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d">

    <!-- Saved destinations, and nothing saved yet — where the count reads 0 rather than blank, which is
         what the Model's Option-aware projection is for.
         Each child supplies the design-time DataContext in XAML — the only safe place for the
         generated-ViewModel mock, which must never be seeded from a page constructor. No size on the
         <hd:Preview>: the surface fills the canvas / device frame. -->
    <hd:Preview PreviewName="Saved" Visibility="Collapsed">
        <local:FavoritesPage DataContext="{x:Bind mock:FavoritesPageMockData.Data}" />
    </hd:Preview>

    <hd:Preview PreviewName="Nothing Saved" Visibility="Collapsed">
        <local:FavoritesPage DataContext="{x:Bind mock:FavoritesPageMockData.Empty}" />
    </hd:Preview>

</hd:PreviewGroup>
