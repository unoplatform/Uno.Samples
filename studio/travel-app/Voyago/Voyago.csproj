<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-browserwasm;net10.0-desktop</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!--
      Design tokens (seed colours, DefaultCornerRadius/Spacing/FontFamily) need Uno.Themes 8.0, and
      the runtime-token fixes land in 8.0.0-dev.15. The Toolkit matters too: SimpleToolkitTheme only
      inherits BaseTheme — and so surfaces Colors and DefaultFontFamily — from 9.x. Both are ahead
      of the SDK's implicit versions.
    -->
    <UnoThemesVersion>8.0.0-dev.15</UnoThemesVersion>
    <UnoToolkitVersion>9.1.3</UnoToolkitVersion>

    <!-- Display name -->
    <ApplicationTitle>Voyago</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.companyname.travelapp</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>Voyago</ApplicationPublisher>
    <!-- Package Description -->
    <Description>Voyago powered by Uno Platform.</Description>

    <!-- Branded app icon + splash (Uno.Resizetizer): one source drives every platform -->
    <UnoIconForegroundFile>Assets/Icons/icon_foreground.svg</UnoIconForegroundFile>
    <UnoIconBackgroundColor>#151515</UnoIconBackgroundColor>
    <UnoSplashScreenFile>Assets/Splash/splash_screen.svg</UnoSplashScreenFile>
    <UnoSplashScreenColor>#151515</UnoSplashScreenColor>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      SimpleTheme;
      Hosting;
      Toolkit;
      Logging;
      MVUX;
      Configuration;
      Localization;
      Navigation;
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

  <!--
    Hot Design Previews live in Previews/. Hot Design locates them at runtime via the
    ApplicationPreviewsFolder assembly-metadata the SDK generates from this property, so it MUST
    point at our folder or no previews are listed. (The SDK's default is HotDesignPreviews/, so
    without this the Previews/ folder is invisible in the tool even though it compiles fine. The
    legacy HotDesignStoriesFolder name is no longer bridged, so setting that one instead resolves
    nothing.) The SDK also drops this folder from the Release compile, which it has to: the
    Uno.UI.HotDesign package contributes no assets there, so the hd: types do not exist.
  -->
  <PropertyGroup>
    <HotDesignPreviewsFolder>Previews</HotDesignPreviewsFolder>
  </PropertyGroup>

</Project>
