<Page x:Class="Voyago.Presentation.FavoritesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Voyago.Presentation"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      Background="{ThemeResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header with saved-count badge -->
        <Grid Grid.Row="0" Background="{ThemeResource SurfaceBrush}" Padding="20,14" utu:SafeArea.Insets="Top">
            <!-- Cap + stretch so the title and badge sit within the same column as the body below -->
            <Grid MaxWidth="{StaticResource ContentMaxWidthWide}" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Favorites" Style="{StaticResource TitleLarge}" Foreground="{ThemeResource OnSurfaceBrush}" VerticalAlignment="Center" />
                <Border Grid.Column="1" Background="{ThemeResource PrimaryContainerBrush}" CornerRadius="{StaticResource PillCornerRadius}" Padding="10,4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <Viewbox Width="12" Height="12" VerticalAlignment="Center">
                            <Path Data="{Binding Converter={StaticResource Icon}, ConverterParameter=heart_filled}" Fill="{ThemeResource OnPrimaryContainerBrush}" Stretch="Uniform" />
                        </Viewbox>
                        <TextBlock Text="{Binding TotalFavorites}" Style="{StaticResource LabelMedium}" Foreground="{ThemeResource OnPrimaryContainerBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="16,20,16,26" Spacing="14" MaxWidth="{StaticResource ContentMaxWidthWide}" HorizontalAlignment="Stretch" local:Motion.Stagger="True">

                <TextBlock Text="Your saved destinations" Style="{StaticResource BodyMedium}" Foreground="{ThemeResource OnSurfaceVariantBrush}" />

                <!-- An empty saved list is a real state for a new traveller, so the grid is a
                     FeedView and "nothing saved yet" is a designed template. -->
                <mvux:FeedView Source="{Binding SavedDestinations}"
                               ValueTemplate="{StaticResource FavoritesGridTemplate}"
                               NoneTemplate="{StaticResource NoFavoritesTemplate}"
                               ErrorTemplate="{StaticResource DiscoveryErrorTemplate}" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
