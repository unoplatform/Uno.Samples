<Page x:Class="Voyago.Presentation.TripsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Voyago.Presentation"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      Background="{ThemeResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{ThemeResource SurfaceBrush}" Padding="20,14" utu:SafeArea.Insets="Top">
            <TextBlock Text="My trips" Style="{StaticResource TitleLarge}" Foreground="{ThemeResource OnSurfaceBrush}"
                       MaxWidth="820" HorizontalAlignment="Stretch" />
        </Grid>

        <!-- A trip is a wide horizontal card, so cap the list narrower than the grid pages (a full
             1080 leaves the text hugging the left with dead space to the right). -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="0" Padding="16,20,16,26" MaxWidth="820" HorizontalAlignment="Stretch" local:Motion.Stagger="True">

                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Viewbox Width="17" Height="17" VerticalAlignment="Center">
                            <Path Data="{Binding Converter={StaticResource Icon}, ConverterParameter=calendar}" Fill="{ThemeResource PrimaryBrush}" Stretch="Uniform" />
                        </Viewbox>
                        <TextBlock Text="Upcoming" Style="{StaticResource TitleMedium}" Foreground="{ThemeResource OnBackgroundBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- The trip book is a list STATE (booking prepends to it) whose initial
                         contents load from the service, so it genuinely has Progress, Value, a
                         first-run empty state and Error. -->
                    <mvux:FeedView Source="{Binding UpcomingTrips}"
                                   ValueTemplate="{StaticResource UpcomingTripListTemplate}"
                                   NoneTemplate="{StaticResource NoUpcomingTripsTemplate}"
                                   ErrorTemplate="{StaticResource DiscoveryErrorTemplate}" />
                </StackPanel>

                <StackPanel Spacing="12" Margin="0,28,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Viewbox Width="17" Height="17" VerticalAlignment="Center">
                            <Path Data="{Binding Converter={StaticResource Icon}, ConverterParameter=history}" Fill="{ThemeResource OnSurfaceVariantBrush}" Stretch="Uniform" />
                        </Viewbox>
                        <TextBlock Text="Past trips" Style="{StaticResource TitleMedium}" Foreground="{ThemeResource OnBackgroundBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Read-only history pulled from the service — a list feed, per the docs. -->
                    <mvux:FeedView Source="{Binding PastTrips}"
                                   ValueTemplate="{StaticResource PastTripListTemplate}"
                                   NoneTemplate="{StaticResource NoPastTripsTemplate}"
                                   ErrorTemplate="{StaticResource DiscoveryErrorTemplate}" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
