<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Seed exceptions, not a palette. Three seeds in App.xaml generate every semantic role; the roles
    below are the ones the generator's recipe structurally cannot reach, so they are pinned back to
    the authored brand value. Colors.OverrideSource merges last and wins over the generated palette,
    and Uno.Themes rewrites the matching *Brush keys (and their hover/pressed/disabled variants)
    from these values.

    Both themes are declared for every role on purpose: the brush resolver probes Light then
    Default, so a role given only a Default value would bleed its dark color into light.

    Why these:
    - BackgroundColor / SurfaceColor — the generated neutral palette is capped at chroma 4, which
      flattens Voyago's violet "dusk" ground to a neutral charcoal. These cover the whole page, so
      the difference reads as a different app even though the measured shift is modest.
  -->
  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Light">
      <Color x:Key="BackgroundColor">#F5F1FB</Color>
      <Color x:Key="SurfaceColor">#FFFFFF</Color>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Default">
      <Color x:Key="BackgroundColor">#2E283F</Color>
      <Color x:Key="SurfaceColor">#3D3658</Color>
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
