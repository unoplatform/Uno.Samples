<Page x:Class="DenimOverallsApp.Presentation.SummaryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:conv="using:DenimOverallsApp.Converters"
      xmlns:local="using:DenimOverallsApp.Presentation"
      Background="{ThemeResource BackgroundBrush}">

    <Page.Resources>
        <conv:HexColorToBrushConverter x:Key="HexToBrush"/>
    </Page.Resources>

    <Grid utu:SafeArea.Insets="VisibleBounds">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Navigation Bar ─────────────────────────────────────────── -->
        <utu:NavigationBar Grid.Row="0"
                           Content="Review Your Order"
                           AutomationProperties.Name="Review Your Order navigation bar"/>

        <!-- ── Scrollable body ────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="{ThemeResource Space400Thickness}" Spacing="{ThemeResource Space400}">

                <!-- ── Mini overall preview + config ──────────────────── -->
                <utu:CardContentControl Style="{StaticResource ElevatedCardContentControlStyle}"
                                        IsClickable="False"
                                        HorizontalAlignment="Stretch">
                    <Grid Padding="{ThemeResource Space400Thickness}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Overall preview — same reactive figure as the configurator -->
                        <local:OverallPreview Grid.Column="0"
                                              Width="96"
                                              Height="170"
                                              Margin="{ThemeResource Space400RightThickness}"
                                              VerticalAlignment="Center"
                                              ColorHex="{Binding ColorHex}"
                                              LengthOption="{Binding Configuration.LengthOption}"
                                              BibType="{Binding Configuration.BibType}"
                                              PocketType="{Binding Configuration.PocketType}"
                                              HasLogo="{Binding Configuration.HasLogo}"
                                              EmbroideryText="{Binding CustomText}"/>

                        <!-- Config details -->
                        <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="YOUR CUSTOM OVERALLS"
                                       Style="{StaticResource LabelExtraSmall}"
                                       CharacterSpacing="100"
                                       Foreground="{ThemeResource SecondaryBrush}"/>

                            <StackPanel Spacing="{ThemeResource Space150}">
                                <StackPanel Orientation="Horizontal" Spacing="{ThemeResource Space200}">
                                    <TextBlock Text="Length"
                                               Style="{StaticResource LabelMedium}"
                                               Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                               Width="80"/>
                                    <TextBlock Text="{Binding LengthLabel}"
                                               Style="{StaticResource BodyMedium}"
                                               Foreground="{ThemeResource OnSurfaceBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="{ThemeResource Space200}">
                                    <TextBlock Text="Bib Type"
                                               Style="{StaticResource LabelMedium}"
                                               Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                               Width="80"/>
                                    <TextBlock Text="{Binding BibLabel}"
                                               Style="{StaticResource BodyMedium}"
                                               Foreground="{ThemeResource OnSurfaceBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="{ThemeResource Space200}">
                                    <TextBlock Text="Color"
                                               Style="{StaticResource LabelMedium}"
                                               Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                               Width="80"/>
                                    <StackPanel Orientation="Horizontal" Spacing="{ThemeResource Space150}">
                                        <Ellipse Width="12" Height="12"
                                                 Fill="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ColorName}"
                                                   Style="{StaticResource BodyMedium}"
                                                   Foreground="{ThemeResource OnSurfaceBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="{ThemeResource Space200}">
                                    <TextBlock Text="Pockets"
                                               Style="{StaticResource LabelMedium}"
                                               Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                               Width="80"/>
                                    <TextBlock Text="{Binding PocketLabel}"
                                               Style="{StaticResource BodyMedium}"
                                               Foreground="{ThemeResource OnSurfaceBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </utu:CardContentControl>

                <!-- ── Price Breakdown ────────────────────────────────── -->
                <StackPanel Spacing="{ThemeResource Space200}">
                    <StackPanel Orientation="Horizontal" Spacing="{ThemeResource Space200}">
                        <FontIcon Glyph="&#xE7BF;" FontSize="16" Foreground="{ThemeResource SecondaryBrush}"/>
                        <TextBlock Text="PRICE BREAKDOWN"
                                   Style="{StaticResource LabelLarge}"
                                   CharacterSpacing="80"
                                   Foreground="{ThemeResource OnBackgroundBrush}"/>
                    </StackPanel>

                    <utu:CardContentControl Style="{StaticResource ElevatedCardContentControlStyle}"
                                            IsClickable="False"
                                            HorizontalAlignment="Stretch">
                        <StackPanel Padding="{ThemeResource Space400Thickness}" Spacing="{ThemeResource Space300}">
                            <ItemsRepeater ItemsSource="{Binding LineItems}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="{ThemeResource Space100BottomThickness}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Label}"
                                                       Style="{StaticResource BodyMedium}"
                                                       Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Amount}"
                                                       Style="{StaticResource LabelMedium}"
                                                       Foreground="{ThemeResource OnSurfaceBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <!-- Divider -->
                            <Border Height="1" Background="{ThemeResource OutlineVariantBrush}" Margin="{ThemeResource Space100VerticalThickness}"/>

                            <!-- Subtotal -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Subtotal"
                                           Style="{StaticResource BodyMedium}"
                                           Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SubtotalLabel}"
                                           Style="{StaticResource LabelLarge}"
                                           Foreground="{ThemeResource OnSurfaceBrush}"/>
                            </Grid>

                            <!-- Shipping -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Shipping"
                                           Style="{StaticResource BodyMedium}"
                                           Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ShippingLabel}"
                                           Style="{StaticResource LabelLarge}"
                                           Foreground="{ThemeResource OnSurfaceBrush}"/>
                            </Grid>

                            <Border Height="1" Background="{ThemeResource PrimaryBrush}" Margin="{ThemeResource Space100VerticalThickness}" Opacity="0.3"/>

                            <!-- Total -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="TOTAL"
                                           Style="{StaticResource TitleMedium}"
                                           Foreground="{ThemeResource OnSurfaceBrush}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TotalLabel}"
                                           Style="{StaticResource TitleLarge}"
                                           Foreground="{ThemeResource PrimaryBrush}"/>
                            </Grid>
                        </StackPanel>
                    </utu:CardContentControl>
                </StackPanel>

                <!-- ── Delivery Info ──────────────────────────────────── -->
                <utu:CardContentControl Style="{StaticResource FilledCardContentControlStyle}"
                                        IsClickable="False"
                                        HorizontalAlignment="Stretch">
                    <StackPanel Padding="16,12" Spacing="{ThemeResource Space200}">
                        <StackPanel Orientation="Horizontal" Spacing="{ThemeResource Space200}">
                            <FontIcon Glyph="&#xE8A5;" FontSize="16" Foreground="{ThemeResource TertiaryBrush}"/>
                            <TextBlock Text="PRODUCTION &#x26; DELIVERY"
                                       Style="{StaticResource LabelLarge}"
                                       CharacterSpacing="60"
                                       Foreground="{ThemeResource OnSurfaceBrush}"/>
                        </StackPanel>
                        <StackPanel Spacing="{ThemeResource Space100}">
                            <StackPanel Orientation="Horizontal" Spacing="{ThemeResource Space150}">
                                <FontIcon Glyph="&#xE787;" FontSize="13" Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
                                <TextBlock Text="{Binding LeadTime}"
                                           Style="{StaticResource BodyMedium}"
                                           Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="{ThemeResource Space150}">
                                <FontIcon Glyph="&#xE72D;" FontSize="13" Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
                                <TextBlock Text="{Binding ShipMethod}"
                                           Style="{StaticResource BodyMedium}"
                                           Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </utu:CardContentControl>

                <Border Height="16"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ── CTA bar ────────────────────────────────────────────────── -->
        <utu:CardContentControl Grid.Row="2"
                                Style="{StaticResource FilledCardContentControlStyle}"
                                HorizontalAlignment="Stretch"
                                IsClickable="False">
            <Grid Padding="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="{ThemeResource Space050}" VerticalAlignment="Center">
                    <TextBlock Text="ORDER TOTAL"
                               Style="{StaticResource LabelExtraSmall}"
                               CharacterSpacing="80"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
                    <TextBlock Text="{Binding TotalLabel}"
                               Style="{StaticResource HeadlineSmall}"
                               Foreground="{ThemeResource PrimaryBrush}"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Proceed to Checkout"
                        Style="{StaticResource FilledButtonStyle}"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Proceed to checkout"
                        Command="{Binding ProceedToCheckout}"/>
            </Grid>
        </utu:CardContentControl>
    </Grid>
</Page>
