<UserControl x:Class="MovieStreamApp.Presentation.Shell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utu="using:Uno.Toolkit.UI"
             xmlns:controls="using:MovieStreamApp.Controls"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

  <!--
    Extended splash screen: continues the native (Resizetizer) splash while the app finishes
    loading, overlaying the brand mark + a loading ring on the same #151515 field. iOS shows the
    native splash white otherwise, so the mark is drawn here in LoadingContent.
  -->
  <utu:ExtendedSplashScreen x:Name="Splash"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch">
    <utu:ExtendedSplashScreen.LoadingContent>
      <Grid Background="#151515">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:AppLogo Grid.Row="1"
                          Width="200"
                          Height="200"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
        <ProgressRing Grid.Row="2"
                      IsActive="True"
                      Width="56"
                      Height="56"
                      Margin="0,48,0,0"
                      VerticalAlignment="Top"
                      HorizontalAlignment="Center"
                      Foreground="#FF3D55" />
      </Grid>
    </utu:ExtendedSplashScreen.LoadingContent>
    <!--
      No Content / Region.Attached here: Uno.Extensions Navigation injects the navigated content
      (Main -> Browse) into the splash screen and reveals it once loading is done. Regions live on
      MainPage, not the Shell.
    -->
  </utu:ExtendedSplashScreen>
</UserControl>
