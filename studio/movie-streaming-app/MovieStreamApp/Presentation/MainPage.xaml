<Page x:Class="MovieStreamApp.Presentation.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}">

  <!--
    Navigation shell. Owns the chrome once for the whole app: an iOS-style floating capsule TabBar
    (FloatingTabBarStyle) centred over the content on every width. The content region and the TabBar
    share a single Grid cell so the bar OVERLAYS the content (last in z-order) and content scrolls
    behind the translucent glass (HIG peek-through); each page reserves a bottom inset so its last
    item clears the bar. Icons are PathIcon vector geometry (via the shared Icon converter) so they
    render in the design host too — the outline glyph is the Icon, the filled glyph the Tag (shown
    when the tab is selected). Region names match the nested route names in App.xaml.cs.
  -->
  <Grid uen:Region.Attached="True">
    <Grid>
      <!-- Shared content area - navigation injects the active tab page here -->
      <Grid uen:Region.Attached="True"
            uen:Region.Navigator="Visibility" />

      <!-- Scroll-edge scrim (Apple Liquid Glass legibility): fades content toward the page background
           just behind/below the floating bar so the clear glass stays legible over bright posters,
           without frosting the bar itself. Sits between the content and the bar; the bar's backdrop
           blurs this already-dimmed edge. -->
      <Border Height="168"
              VerticalAlignment="Bottom"
              IsHitTestVisible="False"
              Background="{ThemeResource FloatingTabBarScrimBrush}" />

      <!-- Bottom floating TabBar: overlays content, centred capsule -->
      <utu:TabBar x:Name="BottomTabs"
                  uen:Region.Attached="True"
                  Style="{StaticResource FloatingTabBarStyle}">
        <utu:TabBarItem uen:Region.Name="Browse" Content="Browse">
          <utu:TabBarItem.Tag>
            <PathIcon Data="{Binding Source=browse, Converter={StaticResource Icon}, ConverterParameter=filled}" />
          </utu:TabBarItem.Tag>
          <utu:TabBarItem.Icon>
            <PathIcon Data="{Binding Source=browse, Converter={StaticResource Icon}}" />
          </utu:TabBarItem.Icon>
        </utu:TabBarItem>
        <utu:TabBarItem uen:Region.Name="Search" Content="Search">
          <utu:TabBarItem.Tag>
            <PathIcon Data="{Binding Source=search, Converter={StaticResource Icon}, ConverterParameter=filled}" />
          </utu:TabBarItem.Tag>
          <utu:TabBarItem.Icon>
            <PathIcon Data="{Binding Source=search, Converter={StaticResource Icon}}" />
          </utu:TabBarItem.Icon>
        </utu:TabBarItem>
        <utu:TabBarItem uen:Region.Name="SocialFeed" Content="Friends">
          <utu:TabBarItem.Tag>
            <PathIcon Data="{Binding Source=friends, Converter={StaticResource Icon}, ConverterParameter=filled}" />
          </utu:TabBarItem.Tag>
          <utu:TabBarItem.Icon>
            <PathIcon Data="{Binding Source=friends, Converter={StaticResource Icon}}" />
          </utu:TabBarItem.Icon>
        </utu:TabBarItem>
        <utu:TabBarItem uen:Region.Name="Profile" Content="Profile">
          <utu:TabBarItem.Tag>
            <PathIcon Data="{Binding Source=profile, Converter={StaticResource Icon}, ConverterParameter=filled}" />
          </utu:TabBarItem.Tag>
          <utu:TabBarItem.Icon>
            <PathIcon Data="{Binding Source=profile, Converter={StaticResource Icon}}" />
          </utu:TabBarItem.Icon>
        </utu:TabBarItem>
      </utu:TabBar>
    </Grid>
  </Grid>
</Page>
