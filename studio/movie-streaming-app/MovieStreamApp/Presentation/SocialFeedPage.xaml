<Page x:Class="MovieStreamApp.Presentation.SocialFeedPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      Background="{ThemeResource BackgroundBrush}">

  <!--
    The Friends tab. Overlaid by the floating TabBar, so the scroll content reserves ~110 bottom
    padding to clear the bar. Content caps at MaxWidth=1100 on desktop so the header, rails and
    activity feed share one left edge and reflow wider. Every icon is a vector Path via the Icon
    converter; every image tile is a Border+ImageBrush so it clips to its corner radius. Movie-bearing
    cards open the detail (full-screen page on phone/tablet, centred modal on desktop); activity cards
    resolve their movie from the shared catalogue by title (MovieByTitle).
  -->
  <Grid utu:SafeArea.Insets="Top">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch" Padding="{utu:Responsive Narrow='20,16,20,110', Wide='128,16,24,28'}" Spacing="24">

        <!-- Header: title + online count with a small live dot -->
        <StackPanel Spacing="2">
          <TextBlock Text="Friends" Style="{StaticResource HeadlineSmall}" Foreground="{ThemeResource OnBackgroundBrush}" FontWeight="Bold" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Border Width="9" Height="9" CornerRadius="5" Background="{ThemeResource TertiaryBrush}" VerticalAlignment="Center" />
            <TextBlock Style="{StaticResource BodyMedium}" Foreground="{ThemeResource OnSurfaceVariantBrush}" VerticalAlignment="Center">
              <Run Text="{Binding OnlineFriendsCount}" FontWeight="SemiBold" Foreground="{ThemeResource OnBackgroundBrush}" />
              <Run Text="friends online" />
            </TextBlock>
          </StackPanel>
        </StackPanel>

        <!-- People You May Know -->
        <StackPanel Spacing="10">
          <TextBlock Text="People You May Know" Style="{StaticResource TitleMedium}" Foreground="{ThemeResource OnBackgroundBrush}" />
          <ItemsRepeater ItemsSource="{Binding SuggestedFriends}">
            <ItemsRepeater.Layout>
              <UniformGridLayout MinItemWidth="120" MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate>
                <utu:CardContentControl Style="{StaticResource FilledCardContentControlStyle}"
                                        HorizontalAlignment="Stretch"
                                        Content="{Binding}">
                  <utu:CardContentControl.ContentTemplate>
                    <DataTemplate>
                      <StackPanel Padding="12,14" Spacing="8" HorizontalAlignment="Center">
                        <Border Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center">
                          <Border.Background>
                            <ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill" />
                          </Border.Background>
                        </Border>
                        <StackPanel Spacing="2" HorizontalAlignment="Center">
                          <TextBlock Text="{Binding Name}" Style="{StaticResource LabelLarge}" Foreground="{ThemeResource OnSurfaceBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" />
                          <TextBlock Text="{Binding Reason}" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OutlineBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" />
                        </StackPanel>
                        <Button Style="{StaticResource IconGhostButtonStyle}" Width="36" Height="36" HorizontalAlignment="Center" AutomationProperties.Name="Add friend">
                          <Viewbox Width="18" Height="18">
                            <Path Data="{Binding Source=add, Converter={StaticResource Icon}}" Fill="{ThemeResource PrimaryBrush}" Stretch="Uniform" />
                          </Viewbox>
                        </Button>
                      </StackPanel>
                    </DataTemplate>
                  </utu:CardContentControl.ContentTemplate>
                </utu:CardContentControl>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </StackPanel>

        <!-- Recent activity feed -->
        <StackPanel Spacing="12">
          <TextBlock Text="Recent Activity" Style="{StaticResource TitleMedium}" Foreground="{ThemeResource OnBackgroundBrush}" />
          <ItemsRepeater ItemsSource="{Binding Activities}">
            <ItemsRepeater.Layout>
              <StackLayout Spacing="12" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate>
                <utu:CardContentControl Style="{StaticResource FilledCardContentControlStyle}"
                                        HorizontalAlignment="Stretch"
                                        IsClickable="True"
                                        Content="{Binding}"
                                        uen:Navigation.Request="{utu:Responsive Layout={StaticResource DesktopModalBreakpoint}, Narrow=MovieDetail, Wide=MovieDetail, Widest='!MovieDetailModal'}"
                                        uen:Navigation.Data="{Binding MovieTitle, Converter={StaticResource MovieByTitle}}">
                  <utu:CardContentControl.ContentTemplate>
                    <DataTemplate>
                      <StackPanel Spacing="0">

                        <!-- Avatar (with online dot) + friend/action line + time -->
                        <Grid Padding="14,12,14,10" ColumnSpacing="12">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Grid Grid.Column="0" Width="44" Height="44">
                            <Border Width="44" Height="44" CornerRadius="22">
                              <Border.Background>
                                <ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill" />
                              </Border.Background>
                            </Border>
                            <Border Width="13" Height="13" CornerRadius="7"
                                    Background="{ThemeResource TertiaryBrush}"
                                    BorderThickness="2" BorderBrush="{ThemeResource SurfaceBrush}"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibility}}" />
                          </Grid>
                          <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource BodyMedium}" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="Wrap">
                            <Run Text="{Binding FriendName}" FontWeight="SemiBold" Foreground="{ThemeResource OnSurfaceBrush}" />
                            <Run Text="{Binding Action}" />
                            <Run Text="{Binding MovieTitle}" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryBrush}" />
                          </TextBlock>
                          <TextBlock Grid.Column="2" Text="{Binding TimeAgo}" Style="{StaticResource LabelSmall}" Foreground="{ThemeResource OutlineBrush}" VerticalAlignment="Top" />
                        </Grid>

                        <!-- Poster thumb with genre chip -->
                        <Grid Margin="14,0" Height="130">
                          <Border CornerRadius="12">
                            <Border.Background>
                              <ImageBrush ImageSource="{Binding MovieImageUrl}" Stretch="UniformToFill" />
                            </Border.Background>
                          </Border>
                          <Border CornerRadius="12">
                            <Border.Background>
                              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0.4" />
                                <GradientStop Color="#B3000000" Offset="1.0" />
                              </LinearGradientBrush>
                            </Border.Background>
                          </Border>
                          <Border Background="#40000000" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,10">
                            <TextBlock Text="{Binding MovieGenre}" Style="{StaticResource LabelSmall}" Foreground="White" />
                          </Border>
                        </Grid>

                        <!-- Optional comment -->
                        <TextBlock Margin="14,10,14,0" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" FontStyle="Italic" TextWrapping="Wrap" Visibility="{Binding Comment}">
                          <Run Text="&#x201C;" Foreground="{ThemeResource PrimaryBrush}" />
                          <Run Text="{Binding Comment}" />
                          <Run Text="&#x201D;" Foreground="{ThemeResource PrimaryBrush}" />
                        </TextBlock>

                        <!-- Footer: heart + like count + time -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Padding="14,12,14,14" VerticalAlignment="Center">
                          <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                            <Path Data="{Binding Source=heart, Converter={StaticResource Icon}}" Fill="{ThemeResource OutlineBrush}" Stretch="Uniform" />
                          </Viewbox>
                          <TextBlock Text="{Binding LikeCount}" Style="{StaticResource LabelMedium}" Foreground="{ThemeResource OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding TimeAgo}" Style="{StaticResource LabelSmall}" Foreground="{ThemeResource OutlineBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>

                      </StackPanel>
                    </DataTemplate>
                  </utu:CardContentControl.ContentTemplate>
                </utu:CardContentControl>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </StackPanel>

        <!-- Trending Among Friends -->
        <StackPanel Spacing="10">
          <TextBlock Text="Trending Among Friends" Style="{StaticResource TitleMedium}" Foreground="{ThemeResource OnBackgroundBrush}" />
          <ItemsRepeater ItemsSource="{Binding TrendingAmongFriends}">
            <ItemsRepeater.Layout>
              <UniformGridLayout MinItemWidth="150" MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate>
                <utu:CardContentControl Style="{StaticResource FilledCardContentControlStyle}"
                                        HorizontalAlignment="Stretch"
                                        IsClickable="True"
                                        Content="{Binding}"
                                        uen:Navigation.Request="{utu:Responsive Layout={StaticResource DesktopModalBreakpoint}, Narrow=MovieDetail, Wide=MovieDetail, Widest='!MovieDetailModal'}"
                                        uen:Navigation.Data="{Binding}">
                  <utu:CardContentControl.ContentTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <Border Height="200" CornerRadius="12,12,0,0">
                          <Border.Background>
                            <ImageBrush ImageSource="{Binding ImageUrl}" Stretch="UniformToFill" />
                          </Border.Background>
                        </Border>
                        <StackPanel Padding="10,8" Spacing="3">
                          <TextBlock Text="{Binding Title}" Style="{StaticResource LabelLarge}" Foreground="{ThemeResource OnSurfaceBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <Viewbox Width="12" Height="12" VerticalAlignment="Center">
                              <Path Data="{Binding Source=star, Converter={StaticResource Icon}, ConverterParameter=filled}" Fill="{ThemeResource TertiaryBrush}" Stretch="Uniform" />
                            </Viewbox>
                            <TextBlock Text="{Binding Rating}" Style="{StaticResource BodySmall}" Foreground="{ThemeResource TertiaryBrush}" VerticalAlignment="Center" />
                          </StackPanel>
                        </StackPanel>
                      </StackPanel>
                    </DataTemplate>
                  </utu:CardContentControl.ContentTemplate>
                </utu:CardContentControl>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
