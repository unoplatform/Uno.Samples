<ContentDialog x:Class="MovieStreamApp.Presentation.MovieDetailDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:uen="using:Uno.Extensions.Navigation.UI"
               xmlns:local="using:MovieStreamApp.Presentation"
               Background="Transparent"
               AutomationProperties.Name="{Binding Movie.Title}">

  <!--
    Desktop detail: the same MovieDetailModel presented as a centred modal over the dimmed shell
    (lesson 64). The ContentDialog chrome is stripped to a transparent host (its smoke layer dims the
    shell for free) and a rounded card is centred inside. Close ("-") / scrim click returns to the tab.
  -->
  <ContentDialog.Resources>
    <Thickness x:Key="ContentDialogPadding">0</Thickness>
    <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent" />
    <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>
    <x:Double x:Key="ContentDialogMaxWidth">100000</x:Double>
    <x:Double x:Key="ContentDialogMaxHeight">100000</x:Double>
    <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
    <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
  </ContentDialog.Resources>

  <Grid Width="780" MaxHeight="760" VerticalAlignment="Center" HorizontalAlignment="Center">
    <Border Background="{ThemeResource BackgroundBrush}"
            CornerRadius="24"
            BorderBrush="{ThemeResource OutlineVariantBrush}"
            BorderThickness="1">
      <Border.Clip>
        <RectangleGeometry Rect="0,0,780,760" />
      </Border.Clip>
      <local:MovieDetailContent />
    </Border>

    <Button Style="{StaticResource IconGhostButtonStyle}"
            Background="#66000000"
            Foreground="White"
            Width="40" Height="40"
            Margin="14"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            uen:Navigation.Request="-"
            AutomationProperties.Name="Close">
      <Viewbox Width="20" Height="20">
        <Path Data="{Binding Source=close, Converter={StaticResource Icon}}" Fill="White" Stretch="Uniform" />
      </Viewbox>
    </Button>
  </Grid>
</ContentDialog>
