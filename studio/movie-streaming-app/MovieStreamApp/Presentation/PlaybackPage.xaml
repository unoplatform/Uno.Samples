<Page x:Class="MovieStreamApp.Presentation.PlaybackPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}">

  <!--
    Full-screen playback surface (a shell sibling, so the floating TabBar doesn't overlay it — no
    bottom inset needed). A 16:9 "player" (Border+ImageBrush so it clips to its corner radius) with
    a dark overlay, a centred play/pause glyph and a notch-clearing Back button, then a transport
    bar (scrub Slider between the two time labels + a row of transport icon buttons), then the
    now-playing meta, Cast, and a responsive "More Like This" poster rail. All icons are vector
    Paths via the Icon converter; every movie card opens its detail (page on phone/tablet, modal on
    desktop).
  -->
  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel HorizontalAlignment="Stretch" MaxWidth="1100" Spacing="0">

        <!-- Player: 16:9 backdrop, dark overlay, centred play/pause, notch-clearing Back -->
        <Grid>
          <!-- 16:9 sizer: a transparent Viewbox drives the player's height from its width -->
          <Viewbox StretchDirection="Both">
            <Rectangle Width="1600" Height="900" Fill="Transparent" />
          </Viewbox>

          <!-- Real video surface: the Uno MediaPlayerElement streams VideoUrl, showing VideoThumbUrl
               as its poster until the first frame decodes. Its built-in transport is disabled — the
               custom Liquid-Glass controls below drive MediaPlayerElement.MediaPlayer directly
               (PlaybackPage.xaml.cs). The host Border clips the video to the page's bottom corners. -->
          <Border CornerRadius="0,0,24,24">
            <MediaPlayerElement x:Name="Player"
                                AreTransportControlsEnabled="False"
                                PosterSource="{Binding VideoThumbUrl}"
                                Stretch="UniformToFill" />
          </Border>

          <!-- Darken so controls stay legible over any frame -->
          <Border CornerRadius="0,0,24,24">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#66000000" Offset="0.0" />
                <GradientStop Color="#33000000" Offset="0.45" />
                <GradientStop Color="#99000000" Offset="1.0" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>

          <!-- Centred large play/pause -->
          <Button Style="{StaticResource IconGhostButtonStyle}"
                  Background="#66000000"
                  Foreground="White"
                  Width="76" Height="76"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Click="TogglePlayPause"
                  AutomationProperties.Name="Play or pause">
            <Grid>
              <Viewbox x:Name="CenterPlayIcon" Width="34" Height="34" Visibility="Collapsed">
                <Path Data="{Binding Source=play, Converter={StaticResource Icon}}" Fill="White" Stretch="Uniform" />
              </Viewbox>
              <Viewbox x:Name="CenterPauseIcon" Width="34" Height="34">
                <Path Data="{Binding Source=pause, Converter={StaticResource Icon}}" Fill="White" Stretch="Uniform" />
              </Viewbox>
            </Grid>
          </Button>

          <!-- Back button, cleared of the notch -->
          <Grid utu:SafeArea.Insets="Top" VerticalAlignment="Top" HorizontalAlignment="Left">
            <Button Style="{StaticResource IconGhostButtonStyle}"
                    Background="#66000000"
                    Foreground="White"
                    Width="44" Height="44"
                    Margin="12"
                    uen:Navigation.Request="-"
                    AutomationProperties.Name="Back">
              <Viewbox Width="22" Height="22">
                <Path Data="{Binding Source=back, Converter={StaticResource Icon}}" Fill="White" Stretch="Uniform" />
              </Viewbox>
            </Button>
          </Grid>
        </Grid>

        <!-- Transport bar: scrubber between the two time labels + transport icon buttons -->
        <StackPanel Padding="20,16,20,8" Spacing="10">
          <Grid ColumnSpacing="12" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CurrentTime" Grid.Column="0" Text="0:00" Style="{StaticResource LabelSmall}" Foreground="{ThemeResource OnBackgroundBrush}" VerticalAlignment="Center" />
            <Slider x:Name="ScrubSlider" Grid.Column="1"
                    Minimum="0" Maximum="1"
                    StepFrequency="0.001"
                    VerticalAlignment="Center"
                    ValueChanged="ScrubSlider_ValueChanged"
                    PointerPressed="ScrubSlider_PointerPressed"
                    PointerCaptureLost="ScrubSlider_PointerReleased"
                    AutomationProperties.Name="Playback position" />
            <TextBlock x:Name="TotalTime" Grid.Column="2" Text="0:00" Style="{StaticResource LabelSmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" VerticalAlignment="Center" />
          </Grid>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14">
            <Button Style="{StaticResource IconGhostButtonStyle}" Width="48" Height="48" Click="SkipBack" AutomationProperties.Name="Skip back 10 seconds">
              <Viewbox Width="24" Height="24">
                <Path Data="{Binding Source=skip_back, Converter={StaticResource Icon}}" Fill="{ThemeResource OnBackgroundBrush}" Stretch="Uniform" />
              </Viewbox>
            </Button>
            <Button Style="{StaticResource IconGhostButtonStyle}"
                    Background="{ThemeResource PrimaryBrush}"
                    Foreground="{ThemeResource OnPrimaryBrush}"
                    Width="56" Height="56"
                    Click="TogglePlayPause"
                    AutomationProperties.Name="Play or pause">
              <Grid>
                <Viewbox x:Name="TransportPlayIcon" Width="26" Height="26" Visibility="Collapsed">
                  <Path Data="{Binding Source=play, Converter={StaticResource Icon}}" Fill="{ThemeResource OnPrimaryBrush}" Stretch="Uniform" />
                </Viewbox>
                <Viewbox x:Name="TransportPauseIcon" Width="26" Height="26">
                  <Path Data="{Binding Source=pause, Converter={StaticResource Icon}}" Fill="{ThemeResource OnPrimaryBrush}" Stretch="Uniform" />
                </Viewbox>
              </Grid>
            </Button>
            <Button Style="{StaticResource IconGhostButtonStyle}" Width="48" Height="48" Click="SkipForward" AutomationProperties.Name="Skip forward 30 seconds">
              <Viewbox Width="24" Height="24">
                <Path Data="{Binding Source=skip_fwd, Converter={StaticResource Icon}}" Fill="{ThemeResource OnBackgroundBrush}" Stretch="Uniform" />
              </Viewbox>
            </Button>
            <Button Style="{StaticResource IconGhostButtonStyle}" Width="48" Height="48" AutomationProperties.Name="Subtitles">
              <Viewbox Width="24" Height="24">
                <Path Data="{Binding Source=subtitles, Converter={StaticResource Icon}}" Fill="{ThemeResource OnSurfaceVariantBrush}" Stretch="Uniform" />
              </Viewbox>
            </Button>
            <Button Style="{StaticResource IconGhostButtonStyle}" Width="48" Height="48" AutomationProperties.Name="Full screen">
              <Viewbox Width="24" Height="24">
                <Path Data="{Binding Source=fullscreen, Converter={StaticResource Icon}}" Fill="{ThemeResource OnSurfaceVariantBrush}" Stretch="Uniform" />
              </Viewbox>
            </Button>
          </StackPanel>
        </StackPanel>

        <!-- Now-playing meta + Cast + More Like This -->
        <StackPanel Padding="20,8,20,28" Spacing="20">

          <!-- Title, genre / year / rating -->
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding NowPlaying.Title}" Style="{StaticResource TitleLarge}" Foreground="{ThemeResource OnBackgroundBrush}" FontWeight="Bold" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <TextBlock Text="{Binding NowPlaying.Genre}" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" VerticalAlignment="Center" />
              <TextBlock Text="•" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OutlineBrush}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding NowPlaying.Year}" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" VerticalAlignment="Center" />
              <TextBlock Text="•" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OutlineBrush}" VerticalAlignment="Center" />
              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Viewbox Width="15" Height="15">
                  <Path Data="{Binding Source=star, Converter={StaticResource Icon}, ConverterParameter=filled}" Fill="{ThemeResource TertiaryBrush}" Stretch="Uniform" />
                </Viewbox>
                <TextBlock Text="{Binding NowPlaying.Rating}" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnBackgroundBrush}" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <!-- Director / Released / Audience score -->
          <StackPanel Orientation="Horizontal" Spacing="28">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding Director}" Style="{StaticResource TitleSmall}" Foreground="{ThemeResource OnBackgroundBrush}" />
              <TextBlock Text="Director" Style="{StaticResource LabelSmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
            </StackPanel>
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding ReleaseDate}" Style="{StaticResource TitleSmall}" Foreground="{ThemeResource OnBackgroundBrush}" />
              <TextBlock Text="Released" Style="{StaticResource LabelSmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
            </StackPanel>
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding AudienceScore}" Style="{StaticResource TitleSmall}" Foreground="{ThemeResource TertiaryBrush}" />
              <TextBlock Text="Audience" Style="{StaticResource LabelSmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
            </StackPanel>
          </StackPanel>

          <!-- Synopsis -->
          <StackPanel Spacing="6">
            <TextBlock Text="Synopsis" Style="{StaticResource TitleMedium}" Foreground="{ThemeResource OnBackgroundBrush}" />
            <TextBlock Text="{Binding NowPlaying.Description}" Style="{StaticResource BodyMedium}" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />
          </StackPanel>

          <!-- Cast: name + role chips (no avatar) -->
          <StackPanel Spacing="10">
            <TextBlock Text="Cast" Style="{StaticResource TitleMedium}" Foreground="{ThemeResource OnBackgroundBrush}" />
            <ItemsRepeater ItemsSource="{Binding Cast}">
              <ItemsRepeater.Layout>
                <UniformGridLayout MinItemWidth="150" MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate>
                  <Border Background="{ThemeResource SurfaceVariantBrush}" CornerRadius="12" Padding="14,12">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Name}" Style="{StaticResource LabelLarge}" Foreground="{ThemeResource OnSurfaceBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                      <TextBlock Text="{Binding Role}" Style="{StaticResource LabelSmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
          </StackPanel>

          <!-- More Like This: poster cards, responsive detail navigation -->
          <StackPanel Spacing="10">
            <TextBlock Text="More Like This" Style="{StaticResource TitleMedium}" Foreground="{ThemeResource OnBackgroundBrush}" />
            <ItemsRepeater ItemsSource="{Binding RelatedMovies}" ItemTemplate="{StaticResource MoviePosterCardTemplate}">
              <ItemsRepeater.Layout>
                <UniformGridLayout MinItemWidth="140" MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill" />
              </ItemsRepeater.Layout>
            </ItemsRepeater>
          </StackPanel>

        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
