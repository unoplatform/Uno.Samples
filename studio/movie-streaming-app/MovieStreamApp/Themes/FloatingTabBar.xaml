<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utu="using:Uno.Toolkit.UI"
                    xmlns:media="using:MovieStreamApp.Media">

  <!--
    ═══════════════════════════════════════════════════════════════════════════════════════
      FloatingTabBar.xaml — an iOS-style "floating" bottom TabBar theme for the Uno Simple theme.
    ═══════════════════════════════════════════════════════════════════════════════════════

    A standalone, drop-in ResourceDictionary. Merge it after the Simple theme and apply the
    styles to any Uno Toolkit TabBar:

        <utu:TabBar Style="{StaticResource FloatingTabBarStyle}"> ... </utu:TabBar>

    THE LOOK — an iOS 26 "Liquid Glass"-style floating bar, following Apple's Human Interface
    Guidelines: a detached, translucent capsule; each tab an icon above a short label; the selected
    tab tinted with the app accent inside a brighter, raised glass capsule that glides between tabs;
    content peeks through the translucent bar.

      • Detached capsule    - the bar does not span the screen: HorizontalAlignment=Center sizes
                              it to its tabs, a large CornerRadius rounds it into a pill, and a
                              bottom Margin + SafeArea inset lift it off the home indicator.
      • Glass surface       - a high-opacity (not fully opaque) surface colour reads as frosted
                              material without a real backdrop blur (backdrop blur is Skia-only and
                              not portable). A hairline border draws the edge as light, not a stroke.
      • Layered soft shadow - two low-opacity (5-8% light) rounded layers, biased downward, stand in
                              for a cast shadow. We deliberately do NOT use the Toolkit
                              ShadowContainer here: it lives in the separate Uno.Toolkit.Skia.WinUI
                              package and, because this is a *merged* dictionary, a version/reference
                              mismatch aborts the whole dictionary at load. Layered translucent
                              borders are the portable alternative.
      • Selection capsule   - the moving highlight is the TabBar's own selection indicator, placed
                              "Below" (behind the tab) so it reads as a raised Liquid-Glass lozenge
                              hugging the active tab. Fixed size + centred (an indicator sized by
                              margins alone stretches with the cell width and balloons on wider
                              layouts), it glides between tabs over 200 ms (TransitionMode=Slide).
      • Accent + filled     - HIG: the selected tab tints with the app accent (Primary) and swaps to
                              the FILLED icon variant (supplied per item via TabBarItem.Tag); applied
                              per-state to both icon and label (Foreground is not inherited).

    THEME-AWARE: light/dark values live in the ThemeDictionaries below. The bar surface / puck /
    shadow are declared as explicit ARGB colours (they need alpha the semantic role brushes don't
    carry); the icon foregrounds alias the Simple theme's semantic OnSurface brushes, so the tabs
    inherit whatever palette the host app maps onto those roles.

    Built on the Simple theme's own base styles, so it keeps the Simple selection-indicator
    presenter (the 200 ms slide storyboard) and the Simple TabBarItem defaults.
  -->

  <ResourceDictionary.ThemeDictionaries>

    <!-- ─── Light ─── -->
    <ResourceDictionary x:Key="Light">
      <!-- Selected capsule is white with a soft lift, not a hard chip. -->
      <Color x:Key="FloatingTabBarPuckColor">#FFFFFFFF</Color>
      <Color x:Key="FloatingTabBarBorderColor">#14000000</Color>
      <Color x:Key="FloatingTabBarPuckBorderColor">#0F000000</Color>
      <Color x:Key="FloatingTabBarSheenColor">#40FFFFFF</Color>
      <!-- Scroll-edge scrim: fades page content toward the background just behind/below the bar so a
           clear-glass bar stays legible (HIG scroll-edge effect), without frosting the bar itself.
           Colour = the page BackgroundColor (light) with increasing alpha toward the bottom. -->
      <LinearGradientBrush x:Key="FloatingTabBarScrimBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Offset="0" Color="#00FFF8F7" />
        <GradientStop Offset="0.5" Color="#1AFFF8F7" />
        <GradientStop Offset="1" Color="#99FFF8F7" />
      </LinearGradientBrush>

      <!-- Thin colour veil laid OVER the backdrop blur (media:BackdropBlur on BackgroundBorder does the
           distortion). Low alpha keeps the bar transparent so the blurred content reads through. -->
      <SolidColorBrush x:Key="FloatingTabBarBackgroundBrush" Color="#1FF4F5F7" />
      <SolidColorBrush x:Key="FloatingTabBarPuckBrush" Color="{StaticResource FloatingTabBarPuckColor}" />
      <SolidColorBrush x:Key="FloatingTabBarBorderBrush" Color="{StaticResource FloatingTabBarBorderColor}" />
      <SolidColorBrush x:Key="FloatingTabBarPuckBorderBrush" Color="{StaticResource FloatingTabBarPuckBorderColor}" />

      <!-- Soft shadow: two rounded layers (wide+faint, tight+darker); overlap fakes a falloff. -->
      <SolidColorBrush x:Key="FloatingTabBarShadowAmbientBrush" Color="#03000000" />
      <SolidColorBrush x:Key="FloatingTabBarShadowKeyBrush" Color="#05000000" />

      <!-- Icon colours inherit the host palette via the Simple semantic role brushes. -->
      <StaticResource x:Key="FloatingTabBarItemForegroundBrush" ResourceKey="OnSurfaceMediumBrush" />
      <!-- HIG: the selected tab tints with the app accent. -->
      <StaticResource x:Key="FloatingTabBarItemForegroundSelectedBrush" ResourceKey="PrimaryBrush" />

      <!-- ─── Liquid Glass side nav (wide / non-mobile layouts) ─── -->
      <!-- The pane is a floating rounded glass panel over the full-bleed content: a backdrop blur
           (media:BackdropBlur on the panel) distorts the content behind it, a thin tint keeps it
           transparent, and a hairline draws the rim — the vertical twin of the floating TabBar. -->
      <SolidColorBrush x:Key="SideNavPaneTintBrush" Color="#1FF4F5F7" />
      <SolidColorBrush x:Key="SideNavPaneBorderBrush" Color="#14000000" />
      <Color x:Key="SideNavSheenColor">#40FFFFFF</Color>
      <!-- Selected item: a raised glass lozenge (white lift) + accent glyph/label. -->
      <SolidColorBrush x:Key="SideNavItemSelectedBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="SideNavItemSelectedBorderBrush" Color="#0F000000" />
      <!-- Left scroll-edge scrim: fades content toward the page background behind the rail. -->
      <LinearGradientBrush x:Key="SideNavScrimBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Offset="0" Color="#99FFF8F7" />
        <GradientStop Offset="0.5" Color="#1AFFF8F7" />
        <GradientStop Offset="1" Color="#00FFF8F7" />
      </LinearGradientBrush>
    </ResourceDictionary>

    <!-- ─── Dark (Default) ─── -->
    <ResourceDictionary x:Key="Default">
      <!-- Selected capsule is a lighter raised glass, a step above the near-black page. -->
      <Color x:Key="FloatingTabBarPuckColor">#FF474463</Color>
      <Color x:Key="FloatingTabBarBorderColor">#1FFFFFFF</Color>
      <Color x:Key="FloatingTabBarPuckBorderColor">#14FFFFFF</Color>
      <Color x:Key="FloatingTabBarSheenColor">#3DFFFFFF</Color>
      <!-- Scroll-edge scrim = the page BackgroundColor (dark) fading in toward the bottom. -->
      <LinearGradientBrush x:Key="FloatingTabBarScrimBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Offset="0" Color="#002A2836" />
        <GradientStop Offset="0.5" Color="#1A2A2836" />
        <GradientStop Offset="1" Color="#992A2836" />
      </LinearGradientBrush>

      <!-- Thin colour veil over the backdrop blur (see light theme). -->
      <SolidColorBrush x:Key="FloatingTabBarBackgroundBrush" Color="#2E44415C" />
      <SolidColorBrush x:Key="FloatingTabBarPuckBrush" Color="{StaticResource FloatingTabBarPuckColor}" />
      <SolidColorBrush x:Key="FloatingTabBarBorderBrush" Color="{StaticResource FloatingTabBarBorderColor}" />
      <SolidColorBrush x:Key="FloatingTabBarPuckBorderBrush" Color="{StaticResource FloatingTabBarPuckBorderColor}" />

      <SolidColorBrush x:Key="FloatingTabBarShadowAmbientBrush" Color="#0F000000" />
      <SolidColorBrush x:Key="FloatingTabBarShadowKeyBrush" Color="#18000000" />

      <StaticResource x:Key="FloatingTabBarItemForegroundBrush" ResourceKey="OnSurfaceMediumBrush" />
      <!-- HIG: the selected tab tints with the app accent. -->
      <StaticResource x:Key="FloatingTabBarItemForegroundSelectedBrush" ResourceKey="PrimaryBrush" />

      <!-- ─── Liquid Glass side nav (wide / non-mobile layouts) ─── -->
      <SolidColorBrush x:Key="SideNavPaneTintBrush" Color="#2E44415C" />
      <SolidColorBrush x:Key="SideNavPaneBorderBrush" Color="#1FFFFFFF" />
      <Color x:Key="SideNavSheenColor">#3DFFFFFF</Color>
      <SolidColorBrush x:Key="SideNavItemSelectedBrush" Color="#FF474463" />
      <SolidColorBrush x:Key="SideNavItemSelectedBorderBrush" Color="#14FFFFFF" />
      <LinearGradientBrush x:Key="SideNavScrimBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Offset="0" Color="#992A2836" />
        <GradientStop Offset="0.5" Color="#1A2A2836" />
        <GradientStop Offset="1" Color="#002A2836" />
      </LinearGradientBrush>
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <!-- ─── Metrics (shared across themes) ─── -->
  <x:Double x:Key="FloatingTabBarHeight">58</x:Double>
  <x:Double x:Key="FloatingTabBarItemWidth">82</x:Double>
  <x:Double x:Key="FloatingTabBarIconSize">24</x:Double>
  <x:Double x:Key="FloatingTabBarLabelFontSize">10</x:Double>
  <x:Double x:Key="FloatingTabBarPressScale">0.98</x:Double>
  <!-- Selection lozenge: the Liquid-Glass capsule that hugs the selected tab. Fixed size + centred
       (never sized by margins, which would balloon with the cell width). It sits INSIDE the item
       cell with a generous inset (≈8px horizontal / 5px vertical) so the end tabs' lozenge clears
       the capsule's rounded ends. The bottom bar can't borrow the side rail's trick of end-padding
       the panel (a horizontal Padding here would desync the sliding indicator, which sizes its cell
       to barWidth/itemCount): the breathing room must come from the lozenge being smaller than the
       cell, not from bar padding. So this inset is deliberately larger than the rail's tight 4/2. -->
  <x:Double x:Key="FloatingTabBarSelectionWidth">66</x:Double>
  <x:Double x:Key="FloatingTabBarSelectionHeight">48</x:Double>
  <!-- Bar radius = height / 2 → a full capsule; lozenge radius matches the side rail's (19). -->
  <CornerRadius x:Key="FloatingTabBarCornerRadius">29</CornerRadius>
  <CornerRadius x:Key="FloatingTabBarSelectionCornerRadius">19</CornerRadius>

  <!--
    ═══ TabBarItem: icon above label, centred, colour follows selection ═══
    HIG: include a short tab label beneath the icon. Foreground is not an inherited property in
    WinUI/Uno, so the selected accent tint is applied per-state to BOTH the icon and the label. A
    firm 0.98 press scale gives a tactile feel on pointer platforms.
  -->
  <Style x:Key="FloatingTabBarItemStyle"
         BasedOn="{StaticResource SimpleBottomTabBarItemStyle}"
         TargetType="utu:TabBarItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource FloatingTabBarItemForegroundBrush}" />
    <Setter Property="Width" Value="{StaticResource FloatingTabBarItemWidth}" />
    <Setter Property="MinHeight" Value="{StaticResource FloatingTabBarHeight}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="utu:TabBarItem">
          <Grid x:Name="LayoutRoot"
                Background="{TemplateBinding Background}"
                Control.IsTemplateFocusTarget="True"
                RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform x:Name="PressScaleTransform" />
            </Grid.RenderTransform>

            <Grid x:Name="ContentGrid"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  RowSpacing="2">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <Viewbox x:Name="IconBox"
                       Grid.Row="0"
                       Width="{StaticResource FloatingTabBarIconSize}"
                       Height="{StaticResource FloatingTabBarIconSize}"
                       HorizontalAlignment="Center">
                <!-- Outline icon (inactive) + filled icon (selected) overlaid, toggled by the
                     Selected states. The filled variant is supplied per item via Tag — HIG prefers
                     filled symbols, and iOS shows the selected tab's glyph filled. -->
                <Grid>
                  <ContentPresenter x:Name="Icon"
                                    Content="{TemplateBinding Icon}"
                                    Foreground="{TemplateBinding Foreground}" />
                  <ContentPresenter x:Name="IconSelected"
                                    Content="{TemplateBinding Tag}"
                                    Foreground="{TemplateBinding Foreground}"
                                    Visibility="Collapsed" />
                </Grid>
              </Viewbox>

              <!-- Tab label (HIG): a short word beneath the icon; tints with selection. -->
              <ContentPresenter x:Name="ContentPresenter"
                                Grid.Row="1"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{StaticResource FloatingTabBarLabelFontSize}"
                                HorizontalAlignment="Center"
                                TextWrapping="NoWrap"
                                AutomationProperties.AccessibilityView="Raw" />
            </Grid>

            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver" />
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="PressScaleTransform.ScaleX" Value="{StaticResource FloatingTabBarPressScale}" />
                    <Setter Target="PressScaleTransform.ScaleY" Value="{StaticResource FloatingTabBarPressScale}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Selected">
                  <VisualState.Setters>
                    <Setter Target="Icon.Visibility" Value="Collapsed" />
                    <Setter Target="IconSelected.Visibility" Value="Visible" />
                    <Setter Target="IconSelected.Foreground" Value="{ThemeResource FloatingTabBarItemForegroundSelectedBrush}" />
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource FloatingTabBarItemForegroundSelectedBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PointerOverSelected">
                  <VisualState.Setters>
                    <Setter Target="Icon.Visibility" Value="Collapsed" />
                    <Setter Target="IconSelected.Visibility" Value="Visible" />
                    <Setter Target="IconSelected.Foreground" Value="{ThemeResource FloatingTabBarItemForegroundSelectedBrush}" />
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource FloatingTabBarItemForegroundSelectedBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PressedSelected">
                  <VisualState.Setters>
                    <Setter Target="Icon.Visibility" Value="Collapsed" />
                    <Setter Target="IconSelected.Visibility" Value="Visible" />
                    <Setter Target="IconSelected.Foreground" Value="{ThemeResource FloatingTabBarItemForegroundSelectedBrush}" />
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource FloatingTabBarItemForegroundSelectedBrush}" />
                    <Setter Target="PressScaleTransform.ScaleX" Value="{StaticResource FloatingTabBarPressScale}" />
                    <Setter Target="PressScaleTransform.ScaleY" Value="{StaticResource FloatingTabBarPressScale}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="DisabledStates">
                <VisualState x:Name="Enabled" />
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="LayoutRoot.Opacity" Value="0.38" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <!-- Layout is fixed (icon above label); these position states are inert but declared. -->
              <VisualStateGroup x:Name="TabBarIconPositionStates">
                <VisualState x:Name="IconOnTop" />
                <VisualState x:Name="IconOnly" />
                <VisualState x:Name="ContentOnly" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    ═══ TabBar: the floating capsule ═══
    Based on the Simple theme's base TabBar style (keeps the 200 ms slide selection-indicator
    presenter). The template mirrors the Simple/base structure — a background Border, the two
    selection-indicator presenters (Below is used here), and the ItemsPresenter — and adds the two
    soft shadow layers behind the capsule. The root Grid must stay named "TabBarGrid" and keep the
    OrientationStates / IndicatorPlacementStates groups: the control drives them by name.

    Padding is 0 on purpose: the selection indicator sizes each cell to ActualWidth / itemCount, so
    the items must fill the bar edge-to-edge for the centred selection capsule to track each tab
    exactly. The bar's breathing room comes from the item width and the rounded ends, not padding.
  -->
  <Style x:Key="FloatingTabBarStyle"
         BasedOn="{StaticResource BaseSimpleTabBarStyle}"
         TargetType="utu:TabBar">
    <Setter Property="Background" Value="{ThemeResource FloatingTabBarBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource FloatingTabBarBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource FloatingTabBarCornerRadius}" />
    <Setter Property="MinHeight" Value="{StaticResource FloatingTabBarHeight}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <!-- Detach from the home indicator; the Simple bottom bar bakes in no bottom inset. -->
    <Setter Property="Margin" Value="0,0,0,12" />
    <Setter Property="utu:SafeArea.Insets" Value="Bottom" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource FloatingTabBarItemStyle}" />
    <!--
      The default TabBarListPanel always claims the full available width and splits it into equal
      cells, which would spread the icons across the screen. A horizontal StackPanel instead sizes
      to its content, so HorizontalAlignment=Center hugs the icons into a snug capsule. The selection
      indicator sizes each cell to ActualWidth / itemCount, which still equals the item width (82)
      because the items are equal-width and flush — so the centred capsule keeps tracking each tab.
      (Designed for a small, iOS-style tab set — up to ~5 tabs.)
    -->
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="SelectionIndicatorPlacement" Value="Below" />
    <Setter Property="SelectionIndicatorTransitionMode" Value="Slide" />
    <Setter Property="SelectionIndicatorContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <!-- Fixed-size, centred glass lozenge hugging the selected tab — flat fill + hairline,
               no shadow layer, matching the side rail's SelectedBackground exactly. -->
          <Grid Width="{StaticResource FloatingTabBarSelectionWidth}"
                Height="{StaticResource FloatingTabBarSelectionHeight}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border Background="{ThemeResource FloatingTabBarPuckBrush}"
                    BorderBrush="{ThemeResource FloatingTabBarPuckBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource FloatingTabBarSelectionCornerRadius}" />
          </Grid>
        </DataTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="utu:TabBar">
          <Grid x:Name="TabBarGrid">
            <!-- Soft cast shadow: rounded, low-opacity, biased downward — the side rail's tight
                 spread rotated for a bottom bar, so both bars carry the same whisper of lift.
                 Negative margins let it bleed past the capsule (the items must stay flush to the
                 bar edges, so the shadow room cannot come from padding). -->
            <Border x:Name="AmbientShadow"
                    Margin="-1,5,-1,-4"
                    Background="{ThemeResource FloatingTabBarShadowAmbientBrush}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <Border x:Name="KeyShadow"
                    Margin="0,3,0,-2"
                    Background="{ThemeResource FloatingTabBarShadowKeyBrush}"
                    CornerRadius="{TemplateBinding CornerRadius}" />

            <!-- Backdrop blur (childless host): a strong, controllable Gaussian blur of the content
                 behind the bar — the Liquid-Glass distortion. Stronger than AcrylicBrush's fixed
                 ~30px blur, and paired with a thin tint so the bar stays transparent. CornerRadius
                 here must match the bar's so the blur sprite's rounded clip lines up. -->
            <Border x:Name="BackgroundBorder"
                    Background="Transparent"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    media:BackdropBlur.Amount="48"
                    media:BackdropBlur.CornerRadius="29" />

            <!-- Thin colour veil + hairline edge, laid over the blur. -->
            <Border x:Name="TintBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" />

            <!-- Specular sheen: a soft top-edge highlight, as Liquid Glass catches light on its rim
                 (HIG: the material carries reflections/highlights). Behind the items so it doesn't
                 wash the labels; hit-test-invisible. -->
            <Border x:Name="Sheen"
                    IsHitTestVisible="False"
                    CornerRadius="{TemplateBinding CornerRadius}">
              <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                  <GradientStop Offset="0" Color="{ThemeResource FloatingTabBarSheenColor}" />
                  <GradientStop Offset="0.45" Color="#00FFFFFF" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>

            <!-- Behind the icons (SelectionIndicatorPlacement=Below). -->
            <utu:TabBarSelectionIndicatorPresenter x:Name="BelowSelectionIndicatorPresenter"
                                                   AutomationProperties.AutomationId="BelowSelectionIndicatorPresenter"
                                                   Content="{TemplateBinding SelectionIndicatorContent}"
                                                   ContentTemplate="{TemplateBinding SelectionIndicatorContentTemplate}"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   IndicatorTransitionMode="{TemplateBinding SelectionIndicatorTransitionMode}"
                                                   Opacity="0"
                                                   Owner="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                   Style="{TemplateBinding SelectionIndicatorPresenterStyle}"
                                                   Visibility="Collapsed" />

            <ItemsPresenter x:Name="TabBarItemsPresenter" Margin="{TemplateBinding Padding}" />

            <!-- In front of the icons (unused while placement is Below, kept for completeness). -->
            <utu:TabBarSelectionIndicatorPresenter x:Name="AboveSelectionIndicatorPresenter"
                                                   AutomationProperties.AutomationId="AboveSelectionIndicatorPresenter"
                                                   Content="{TemplateBinding SelectionIndicatorContent}"
                                                   ContentTemplate="{TemplateBinding SelectionIndicatorContentTemplate}"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   IndicatorTransitionMode="{TemplateBinding SelectionIndicatorTransitionMode}"
                                                   Opacity="0"
                                                   Owner="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                   Style="{TemplateBinding SelectionIndicatorPresenterStyle}" />

            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="OrientationStates">
                <VisualState x:Name="Horizontal">
                  <VisualState.Setters>
                    <Setter Target="BelowSelectionIndicatorPresenter.VerticalContentAlignment" Value="Stretch" />
                    <Setter Target="BelowSelectionIndicatorPresenter.HorizontalContentAlignment" Value="Left" />
                    <Setter Target="AboveSelectionIndicatorPresenter.VerticalContentAlignment" Value="Stretch" />
                    <Setter Target="AboveSelectionIndicatorPresenter.HorizontalContentAlignment" Value="Left" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Vertical">
                  <VisualState.Setters>
                    <Setter Target="BelowSelectionIndicatorPresenter.VerticalContentAlignment" Value="Top" />
                    <Setter Target="BelowSelectionIndicatorPresenter.HorizontalContentAlignment" Value="Stretch" />
                    <Setter Target="AboveSelectionIndicatorPresenter.VerticalContentAlignment" Value="Top" />
                    <Setter Target="AboveSelectionIndicatorPresenter.HorizontalContentAlignment" Value="Stretch" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="IndicatorPlacementStates">
                <VisualState x:Name="Above" />
                <VisualState x:Name="Below">
                  <VisualState.Setters>
                    <Setter Target="BelowSelectionIndicatorPresenter.Visibility" Value="Visible" />
                    <Setter Target="AboveSelectionIndicatorPresenter.Visibility" Value="Collapsed" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    ═══════════════════════════════════════════════════════════════════════════════════════
      FloatingSideBar — the vertical twin of the floating TabBar, for wide / non-mobile layouts.
    ═══════════════════════════════════════════════════════════════════════════════════════

    A detached, floating glass rail pinned to the left edge and centred vertically, over the
    same full-bleed content. It shares the floating bar's material — a controllable backdrop
    blur (media:BackdropBlur) that distorts the content behind it, a thin tint that keeps it
    transparent, a hairline rim, a top specular sheen, and a soft cast shadow — so the two
    chrome forms read as one Liquid-Glass system across form factors.

    Selection uses the TabBar's own SLIDING indicator (a single glass lozenge that glides between
    tabs), exactly like the horizontal bar — the trick is setting Orientation=Vertical on the bar so
    the control lays out vertically AND drives the indicator's vertical storyboard (TranslateY). The
    lozenge is fixed-size + centred, so it tracks each equal-size item; the item only tints its
    icon/label when selected.
  -->
  <x:Double x:Key="FloatingSideBarItemWidth">88</x:Double>
  <x:Double x:Key="FloatingSideBarItemHeight">62</x:Double>
  <!-- Sliding lozenge: fixed size, centred in the item cell (mirrors the old per-item 4/2 insets). -->
  <x:Double x:Key="FloatingSideBarSelectionWidth">80</x:Double>
  <x:Double x:Key="FloatingSideBarSelectionHeight">58</x:Double>
  <CornerRadius x:Key="FloatingSideBarCornerRadius">32</CornerRadius>
  <CornerRadius x:Key="FloatingSideBarItemCornerRadius">19</CornerRadius>

  <Style x:Key="FloatingSideBarItemStyle"
         BasedOn="{StaticResource SimpleBottomTabBarItemStyle}"
         TargetType="utu:TabBarItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource FloatingTabBarItemForegroundBrush}" />
    <Setter Property="Width" Value="{StaticResource FloatingSideBarItemWidth}" />
    <Setter Property="Height" Value="{StaticResource FloatingSideBarItemHeight}" />
    <Setter Property="Margin" Value="0,3" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="utu:TabBarItem">
          <Grid x:Name="LayoutRoot"
                Background="{TemplateBinding Background}"
                Control.IsTemplateFocusTarget="True"
                RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform x:Name="PressScaleTransform" />
            </Grid.RenderTransform>

            <!-- Selection is drawn by the bar's sliding indicator (see FloatingSideBarStyle), which
                 glides a single glass lozenge between tabs — so the item only tints its icon/label
                 when selected; it no longer paints its own background. -->

            <Grid x:Name="ContentGrid"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  RowSpacing="2">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <Viewbox x:Name="IconBox"
                       Grid.Row="0"
                       Width="{StaticResource FloatingTabBarIconSize}"
                       Height="{StaticResource FloatingTabBarIconSize}"
                       HorizontalAlignment="Center">
                <Grid>
                  <ContentPresenter x:Name="Icon"
                                    Content="{TemplateBinding Icon}"
                                    Foreground="{TemplateBinding Foreground}" />
                  <ContentPresenter x:Name="IconSelected"
                                    Content="{TemplateBinding Tag}"
                                    Foreground="{TemplateBinding Foreground}"
                                    Visibility="Collapsed" />
                </Grid>
              </Viewbox>

              <ContentPresenter x:Name="ContentPresenter"
                                Grid.Row="1"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{StaticResource FloatingTabBarLabelFontSize}"
                                HorizontalAlignment="Center"
                                TextWrapping="NoWrap"
                                AutomationProperties.AccessibilityView="Raw" />
            </Grid>

            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver" />
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="PressScaleTransform.ScaleX" Value="{StaticResource FloatingTabBarPressScale}" />
                    <Setter Target="PressScaleTransform.ScaleY" Value="{StaticResource FloatingTabBarPressScale}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Selected">
                  <VisualState.Setters>
                    <Setter Target="Icon.Visibility" Value="Collapsed" />
                    <Setter Target="IconSelected.Visibility" Value="Visible" />
                    <Setter Target="IconSelected.Foreground" Value="{ThemeResource FloatingTabBarItemForegroundSelectedBrush}" />
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource FloatingTabBarItemForegroundSelectedBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PointerOverSelected">
                  <VisualState.Setters>
                    <Setter Target="Icon.Visibility" Value="Collapsed" />
                    <Setter Target="IconSelected.Visibility" Value="Visible" />
                    <Setter Target="IconSelected.Foreground" Value="{ThemeResource FloatingTabBarItemForegroundSelectedBrush}" />
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource FloatingTabBarItemForegroundSelectedBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PressedSelected">
                  <VisualState.Setters>
                    <Setter Target="Icon.Visibility" Value="Collapsed" />
                    <Setter Target="IconSelected.Visibility" Value="Visible" />
                    <Setter Target="IconSelected.Foreground" Value="{ThemeResource FloatingTabBarItemForegroundSelectedBrush}" />
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource FloatingTabBarItemForegroundSelectedBrush}" />
                    <Setter Target="PressScaleTransform.ScaleX" Value="{StaticResource FloatingTabBarPressScale}" />
                    <Setter Target="PressScaleTransform.ScaleY" Value="{StaticResource FloatingTabBarPressScale}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="DisabledStates">
                <VisualState x:Name="Enabled" />
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="LayoutRoot.Opacity" Value="0.38" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="TabBarIconPositionStates">
                <VisualState x:Name="IconOnTop" />
                <VisualState x:Name="IconOnly" />
                <VisualState x:Name="ContentOnly" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FloatingSideBarStyle"
         BasedOn="{StaticResource BaseSimpleTabBarStyle}"
         TargetType="utu:TabBar">
    <Setter Property="Background" Value="{ThemeResource SideNavPaneTintBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource SideNavPaneBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource FloatingSideBarCornerRadius}" />
    <Setter Property="Padding" Value="6,14" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="18,0,0,0" />
    <Setter Property="utu:SafeArea.Insets" Value="Left" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource FloatingSideBarItemStyle}" />
    <!-- Vertical orientation: lays the items out top-to-bottom AND drives the selection indicator's
         vertical (TranslateY) storyboard so the lozenge slides down/up between tabs. -->
    <Setter Property="Orientation" Value="Vertical" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Vertical" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <!-- Same sliding-indicator setup as the bottom bar: a fixed-size glass lozenge placed Below the
         tab, gliding over 200 ms (Slide, not the default Snap). -->
    <Setter Property="SelectionIndicatorPlacement" Value="Below" />
    <Setter Property="SelectionIndicatorTransitionMode" Value="Slide" />
    <Setter Property="SelectionIndicatorContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <Grid Width="{StaticResource FloatingSideBarSelectionWidth}"
                Height="{StaticResource FloatingSideBarSelectionHeight}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border Background="{ThemeResource SideNavItemSelectedBrush}"
                    BorderBrush="{ThemeResource SideNavItemSelectedBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource FloatingSideBarItemCornerRadius}" />
          </Grid>
        </DataTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="utu:TabBar">
          <Grid x:Name="TabBarGrid">
            <!-- Soft cast shadow, biased right + down (light comes from the upper-left). -->
            <Border x:Name="AmbientShadow"
                    Margin="-1,-1,-4,5"
                    Background="{ThemeResource FloatingTabBarShadowAmbientBrush}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <Border x:Name="KeyShadow"
                    Margin="0,0,-2,3"
                    Background="{ThemeResource FloatingTabBarShadowKeyBrush}"
                    CornerRadius="{TemplateBinding CornerRadius}" />

            <!-- Backdrop blur (childless host): the Liquid-Glass distortion of the content behind
                 the rail. CornerRadius must match the rail's so the blur sprite's clip lines up. -->
            <Border x:Name="BackgroundBorder"
                    Background="Transparent"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    media:BackdropBlur.Amount="48"
                    media:BackdropBlur.CornerRadius="32" />

            <!-- Thin colour veil + hairline edge, over the blur. -->
            <Border x:Name="TintBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" />

            <!-- Specular sheen along the top rim. -->
            <Border x:Name="Sheen"
                    IsHitTestVisible="False"
                    CornerRadius="{TemplateBinding CornerRadius}">
              <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                  <GradientStop Offset="0" Color="{ThemeResource SideNavSheenColor}" />
                  <GradientStop Offset="0.22" Color="#00FFFFFF" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>

            <!-- The sliding glass lozenge, Below the tabs (behind the icons/labels). The control
                 translates it to the selected item and animates the move; the Vertical orientation
                 state below aligns it for the top-to-bottom rail. -->
            <utu:TabBarSelectionIndicatorPresenter x:Name="BelowSelectionIndicatorPresenter"
                                                   AutomationProperties.AutomationId="BelowSelectionIndicatorPresenter"
                                                   Content="{TemplateBinding SelectionIndicatorContent}"
                                                   ContentTemplate="{TemplateBinding SelectionIndicatorContentTemplate}"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   IndicatorTransitionMode="{TemplateBinding SelectionIndicatorTransitionMode}"
                                                   Opacity="0"
                                                   Owner="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                   Style="{TemplateBinding SelectionIndicatorPresenterStyle}"
                                                   Visibility="Collapsed" />

            <ItemsPresenter x:Name="TabBarItemsPresenter" Margin="{TemplateBinding Padding}" />

            <!-- In front of the icons (unused while placement is Below, kept for completeness). -->
            <utu:TabBarSelectionIndicatorPresenter x:Name="AboveSelectionIndicatorPresenter"
                                                   AutomationProperties.AutomationId="AboveSelectionIndicatorPresenter"
                                                   Content="{TemplateBinding SelectionIndicatorContent}"
                                                   ContentTemplate="{TemplateBinding SelectionIndicatorContentTemplate}"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   IndicatorTransitionMode="{TemplateBinding SelectionIndicatorTransitionMode}"
                                                   Opacity="0"
                                                   Owner="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                   Style="{TemplateBinding SelectionIndicatorPresenterStyle}" />

            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="OrientationStates">
                <VisualState x:Name="Horizontal">
                  <VisualState.Setters>
                    <Setter Target="BelowSelectionIndicatorPresenter.VerticalContentAlignment" Value="Stretch" />
                    <Setter Target="BelowSelectionIndicatorPresenter.HorizontalContentAlignment" Value="Left" />
                    <Setter Target="AboveSelectionIndicatorPresenter.VerticalContentAlignment" Value="Stretch" />
                    <Setter Target="AboveSelectionIndicatorPresenter.HorizontalContentAlignment" Value="Left" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Vertical">
                  <VisualState.Setters>
                    <Setter Target="BelowSelectionIndicatorPresenter.VerticalContentAlignment" Value="Top" />
                    <Setter Target="BelowSelectionIndicatorPresenter.HorizontalContentAlignment" Value="Stretch" />
                    <Setter Target="AboveSelectionIndicatorPresenter.VerticalContentAlignment" Value="Top" />
                    <Setter Target="AboveSelectionIndicatorPresenter.HorizontalContentAlignment" Value="Stretch" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="IndicatorPlacementStates">
                <VisualState x:Name="Above" />
                <VisualState x:Name="Below">
                  <VisualState.Setters>
                    <Setter Target="BelowSelectionIndicatorPresenter.Visibility" Value="Visible" />
                    <Setter Target="AboveSelectionIndicatorPresenter.Visibility" Value="Collapsed" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
