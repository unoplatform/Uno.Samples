<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<ResourceDictionary.ThemeDictionaries>
		<ResourceDictionary x:Key="Light">
			<Color x:Key="PrimaryColor">#6158DF</Color>
			<Color x:Key="OnPrimaryColor">#FFFFFF</Color>
			<Color x:Key="PrimaryContainerColor">#E5E2FC</Color>
			<Color x:Key="OnPrimaryContainerColor">#191357</Color>
			<Color x:Key="SecondaryColor">#B53D68</Color>
			<Color x:Key="OnSecondaryColor">#FFFFFF</Color>
			<Color x:Key="SecondaryContainerColor">#FFD8E6</Color>
			<Color x:Key="OnSecondaryContainerColor">#3D0020</Color>
			<Color x:Key="TertiaryColor">#7A5080</Color>
			<Color x:Key="OnTertiaryColor">#FFFFFF</Color>
			<Color x:Key="TertiaryContainerColor">#F4D8FF</Color>
			<Color x:Key="OnTertiaryContainerColor">#2F0D36</Color>
			<Color x:Key="ErrorColor">#BA1A1A</Color>
			<Color x:Key="OnErrorColor">#FFFFFF</Color>
			<!-- Neutrals are kept truly neutral (a hair cool to sit under the indigo brand). The MD3
			     generator had tinted them pink/mauve, which made card borders and dividers read as
			     stray rose lines in light mode; these clean greys fix that. -->
			<Color x:Key="SurfaceColor">#FFFFFF</Color>
			<Color x:Key="OnSurfaceColor">#1B1B1F</Color>
			<Color x:Key="SurfaceVariantColor">#ECECF1</Color>
			<Color x:Key="OnSurfaceVariantColor">#45454E</Color>
			<Color x:Key="BackgroundColor">#F6F6F9</Color>
			<Color x:Key="OnBackgroundColor">#1B1B1F</Color>
			<Color x:Key="OutlineColor">#8B8B95</Color>
			<Color x:Key="OutlineVariantColor">#E4E4EA</Color>
		</ResourceDictionary>
		<ResourceDictionary x:Key="Default">
			<Color x:Key="PrimaryColor">#776FE4</Color>
			<Color x:Key="OnPrimaryColor">#FFFFFF</Color>
			<Color x:Key="PrimaryContainerColor">#2B2470</Color>
			<Color x:Key="OnPrimaryContainerColor">#E3DFFF</Color>
			<Color x:Key="SecondaryColor">#E5638E</Color>
			<Color x:Key="OnSecondaryColor">#3B0022</Color>
			<Color x:Key="SecondaryContainerColor">#6E1240</Color>
			<Color x:Key="OnSecondaryContainerColor">#FFD8E6</Color>
			<Color x:Key="TertiaryColor">#CF9DDA</Color>
			<Color x:Key="OnTertiaryColor">#3D1146</Color>
			<Color x:Key="TertiaryContainerColor">#572D5E</Color>
			<Color x:Key="OnTertiaryContainerColor">#F4D8FF</Color>
			<Color x:Key="ErrorColor">#FFB4AB</Color>
			<Color x:Key="OnErrorColor">#690005</Color>
			<Color x:Key="SurfaceColor">#343142</Color>
			<Color x:Key="OnSurfaceColor">#EDEBF4</Color>
			<Color x:Key="SurfaceVariantColor">#403D53</Color>
			<Color x:Key="OnSurfaceVariantColor">#C6C2D6</Color>
			<Color x:Key="BackgroundColor">#2A2836</Color>
			<Color x:Key="OnBackgroundColor">#EDEBF4</Color>
			<Color x:Key="OutlineColor">#928EA2</Color>
			<Color x:Key="OutlineVariantColor">#4A475D</Color>
		</ResourceDictionary>
	</ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
