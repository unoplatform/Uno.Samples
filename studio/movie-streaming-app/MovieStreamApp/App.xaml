<Application x:Class="MovieStreamApp.App"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:utus="using:Uno.Toolkit.UI.Simple">

  <!--
    App.xaml is a thin manifest: it only merges the dedicated dictionaries. The app runs on the Uno
    Simple theme (SimpleToolkitTheme), whose ColorOverrideSource maps the CineStream brand palette
    onto the semantic role colors in ThemeColors.xaml, so the built-in controls pick up the identity.
    The floating TabBar theme and the app styling vocabulary (Styles.xaml, merged LAST so its token
    overrides win) follow. Body text is the framework Roboto — portable on every platform, where the
    Simple default renders Regular weight as monospace.
  -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Load WinUI resources -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <!-- Uno Simple theme: brand palette mapped to semantic roles + Roboto text -->
        <utus:SimpleToolkitTheme ColorOverrideSource="ms-appx:///ThemeColors.xaml">
          <utus:SimpleToolkitTheme.FontOverrideDictionary>
            <ResourceDictionary>
              <FontFamily x:Key="SimpleFontFamily">ms-appx:///Uno.Fonts.Roboto/Fonts/Roboto-Regular.ttf#Roboto</FontFamily>
              <FontWeight x:Key="DisplayLargeFontWeight">800</FontWeight>
              <FontWeight x:Key="TitleLargeFontWeight">700</FontWeight>
              <FontWeight x:Key="TitleMediumFontWeight">600</FontWeight>
              <FontWeight x:Key="TitleSmallFontWeight">600</FontWeight>
              <FontWeight x:Key="LabelLargeFontWeight">600</FontWeight>
              <x:Double x:Key="LabelMediumFontSize">11</x:Double>
              <x:Double x:Key="BodyMediumFontSize">14</x:Double>
              <x:Double x:Key="BodySmallFontSize">12</x:Double>
            </ResourceDictionary>
          </utus:SimpleToolkitTheme.FontOverrideDictionary>
        </utus:SimpleToolkitTheme>
        <!-- iOS-style floating capsule TabBar theme (built on the Simple base styles; merged after it) -->
        <ResourceDictionary Source="ms-appx:///Themes/FloatingTabBar.xaml" />
        <!-- App styling vocabulary: converters, design tokens, responsive breakpoints, shared styles -->
        <ResourceDictionary Source="ms-appx:///Styles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>
