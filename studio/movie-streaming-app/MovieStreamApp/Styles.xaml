<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utu="using:Uno.Toolkit.UI"
                    xmlns:uen="using:Uno.Extensions.Navigation.UI"
                    xmlns:conv="using:MovieStreamApp.Converters">

  <!--
    App styling vocabulary: the shared converters, design tokens, the desktop-modal breakpoint, and
    the reusable icon-button style. Merged LAST in App.xaml so the well-known corner-radius token
    overrides win over the framework defaults. Pages only consume these keys.
  -->

  <!--
    Outlined-button hover: the Simple theme aliases OutlinedButtonBackgroundPointerOver to the filled
    tonal button's hover (a SOLID PrimaryContainer — a saturated indigo in dark, lavender in light),
    which reads as a jarring block fill on an outlined control. Replace it with a subtle neutral
    overlay so a hovered outlined button (e.g. Sign Out) lifts gently instead. Per theme.

    Filled (Primary) button hover/press: the Simple theme points BOTH FilledButtonBackgroundPointerOver
    and ...Pressed at PrimaryVariantDarkBrush, whose stock value is a grayscale #1E1E1E (light) /
    #D9D9D9 (dark). So hovering the accent Play / Get-Started buttons swings the fill to near-black in
    light mode (and toward near-white in dark, which would swallow the white label). Replace both states
    with a brand-consistent DARKEN of Primary — a two-tier tactile step (hover ~10%, pressed ~16%) that
    keeps the indigo identity and holds the white OnPrimary label above AA contrast (≥4.5:1). Per theme.
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="OutlinedButtonBackgroundPointerOver" Color="#14000000" />
      <SolidColorBrush x:Key="FilledButtonBackgroundPointerOver" Color="#574FC9" />
      <SolidColorBrush x:Key="FilledButtonBackgroundPressed" Color="#514ABB" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="OutlinedButtonBackgroundPointerOver" Color="#1FFFFFFF" />
      <SolidColorBrush x:Key="FilledButtonBackgroundPointerOver" Color="#6B64CD" />
      <SolidColorBrush x:Key="FilledButtonBackgroundPressed" Color="#645DC0" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Circular translucent scrim behind a horizontal-rail scroll arrow (desktop only). Hosts a
       ghost icon button so it reads over bright posters in both themes. -->
  <Style x:Key="RailArrowScrimStyle" TargetType="Border">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Background" Value="#99000000" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="2,0" />
  </Style>

  <!-- Converters -->
  <conv:IconConverter x:Key="Icon" />
  <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  <conv:StringToVisibilityConverter x:Key="StringToVisibility" />

  <!-- A detail reached from a card is a full-screen page on phone/tablet and a centred modal on
       desktop (lesson 64). Widest is set ABOVE every tablet (a 12.9" iPad landscape is 1366) so
       only true desktop widths get the modal. Referenced via the extension's Layout= property, not
       as an app-level DefaultResponsiveLayout (which would collide with the Simple theme's). -->
  <utu:ResponsiveLayout x:Key="DesktopModalBreakpoint"
                        Narrow="0"
                        Wide="600"
                        Widest="1400" />

  <!-- Corner-radius scale (well-known Simple/WinUI token overrides) -->
  <CornerRadius x:Key="ControlCornerRadius">14</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">24</CornerRadius>

  <!-- Tactile press scale (design-polish house value) -->
  <x:Double x:Key="PressScale">0.98</x:Double>

  <!--
    Chrome-less circular icon button. A single transparent rounded root with a state-layer overlay
    (PointerOver / Pressed) and a firm 0.98 press scale — crisp and stateful, without the default
    themed Button's gray rectangle. MinWidth/MinHeight=0 so an explicit Width/Height isn't clamped
    up to the theme minimum (lesson 41). Put a Path/PathIcon (or Viewbox) in Content.
  -->
  <Style x:Key="IconGhostButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <!-- The hover/press state layer is tinted with Foreground (the button's on-color), so it
         darkens a chrome-less button on the surface (default OnSurface, dark) yet LIGHTENS a
         button that paints its own colored/dark background — set that button's Foreground to its
         on-color (e.g. White / OnPrimary) and the highlight follows. A hardcoded OnSurface layer
         instead reads as a muddy dark wash over a bright Play button in light mode. -->
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root"
                Background="{TemplateBinding Background}"
                CornerRadius="999"
                RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            <Border x:Name="StateLayer"
                    CornerRadius="999"
                    Background="{TemplateBinding Foreground}"
                    Opacity="0" />
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="StateLayer.Opacity" Value="0.08" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="StateLayer.Opacity" Value="0.12" />
                    <Setter Target="PressScale.ScaleX" Value="{StaticResource PressScale}" />
                    <Setter Target="PressScale.ScaleY" Value="{StaticResource PressScale}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.38" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Crisp flat/tonal text button. A single FILLED rounded Border (no BorderThickness — nothing to
    stroke/alias along the corner, per lesson 42's anti-aliasing note) + a Foreground-tinted
    state-layer overlay + the 0.98 press. Use for chips and secondary actions that would otherwise
    lean on the Simple themed button's 1px OutlineBrush stroke, which reads as a rough hairline on
    small, tight corners at high DPI. Set Background to a fill that reads against the page (SurfaceBrush
    stands off the deepened page background); the state layer follows Foreground like IconGhostButtonStyle.
  -->
  <Style x:Key="FlatButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            <Border x:Name="Fill"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <Border x:Name="StateLayer"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Background="{TemplateBinding Foreground}"
                    Opacity="0" />
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="StateLayer.Opacity" Value="0.08" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="StateLayer.Opacity" Value="0.12" />
                    <Setter Target="PressScale.ScaleX" Value="{StaticResource PressScale}" />
                    <Setter Target="PressScale.ScaleY" Value="{StaticResource PressScale}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.38" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Shared vertical poster card: image-on-top + title + star/rating, over a clickable FilledCard.
       Used by the two rails whose tiles are identical — SocialFeed "Trending Among Friends" and
       Playback "More Like This". DataContext is a Movie; tapping opens the responsive detail (a
       full-screen page on phone/tablet, a centred modal on desktop). Each page keeps its own
       ItemsRepeater layout (tile width); only the tile itself is shared here. -->
  <DataTemplate x:Key="MoviePosterCardTemplate">
    <utu:CardContentControl Style="{StaticResource FilledCardContentControlStyle}"
                            HorizontalAlignment="Stretch"
                            IsClickable="True"
                            Content="{Binding}"
                            uen:Navigation.Request="{utu:Responsive Layout={StaticResource DesktopModalBreakpoint}, Narrow=MovieDetail, Wide=MovieDetail, Widest='!MovieDetailModal'}"
                            uen:Navigation.Data="{Binding}">
      <utu:CardContentControl.ContentTemplate>
        <DataTemplate>
          <StackPanel>
            <Border Height="190" CornerRadius="12,12,0,0">
              <Border.Background>
                <ImageBrush ImageSource="{Binding ImageUrl}" Stretch="UniformToFill" />
              </Border.Background>
            </Border>
            <StackPanel Padding="10,8" Spacing="3">
              <TextBlock Text="{Binding Title}" Style="{StaticResource LabelLarge}" Foreground="{ThemeResource OnSurfaceBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Viewbox Width="12" Height="12">
                  <Path Data="{Binding Source=star, Converter={StaticResource Icon}, ConverterParameter=filled}" Fill="{ThemeResource TertiaryBrush}" Stretch="Uniform" />
                </Viewbox>
                <TextBlock Text="{Binding Rating}" Style="{StaticResource BodySmall}" Foreground="{ThemeResource TertiaryBrush}" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </DataTemplate>
      </utu:CardContentControl.ContentTemplate>
    </utu:CardContentControl>
  </DataTemplate>

</ResourceDictionary>
