<hd:PreviewGroup x:Class="UnoCRM.Previews.PipelineCardPreviews"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:controls="using:UnoCRM.Controls"
                 xmlns:hd="using:Uno.UI.HotDesign"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d">

    <!-- The PipelineCard deal tile in its four states. Each child is a named preview of the same
         control; data is set directly on the control's dependency properties in XAML. -->
    <hd:Preview PreviewName="Healthy"
                Visibility="Collapsed"
                Width="260"
                Height="150">
        <controls:PipelineCard Company="Atlas Financial"
                               Amount="$95,600"
                               Owner="Nina Brooks"
                               Meta="11d"
                               IsWon="False"
                               Accent="{ThemeResource DashboardGreenBrush}"
                               VerticalAlignment="Center" />
    </hd:Preview>

    <hd:Preview PreviewName="Watch"
                Visibility="Collapsed"
                Width="260"
                Height="150">
        <controls:PipelineCard Company="TechVision Inc"
                               Amount="$28,500"
                               Owner="Mike Johnson"
                               Meta="5d"
                               IsWon="False"
                               Accent="{ThemeResource DashboardAmberBrush}"
                               VerticalAlignment="Center" />
    </hd:Preview>

    <hd:Preview PreviewName="At Risk"
                Visibility="Collapsed"
                Width="260"
                Height="150">
        <controls:PipelineCard Company="Vertex Labs"
                               Amount="$210,000"
                               Owner="Kevin Zhang"
                               Meta="22d"
                               IsWon="False"
                               Accent="{ThemeResource DashboardRedBrush}"
                               VerticalAlignment="Center" />
    </hd:Preview>

    <hd:Preview PreviewName="Won"
                Visibility="Collapsed"
                Width="260"
                Height="150">
        <controls:PipelineCard Company="Summit Retail"
                               Amount="$156,000"
                               Owner="Paul Martinez"
                               Meta="Won"
                               IsWon="True"
                               Accent="{ThemeResource DashboardGreenBrush}"
                               VerticalAlignment="Center" />
    </hd:Preview>
</hd:PreviewGroup>
