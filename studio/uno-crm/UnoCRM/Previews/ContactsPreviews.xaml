<hd:PreviewGroup x:Class="UnoCRM.Previews.ContactsPreviews"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="using:UnoCRM.Presentation"
                 xmlns:mock="using:UnoCRM.Presentation.MockData"
                 xmlns:hd="using:Uno.UI.HotDesign"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d">

    <!-- ContactsPage in its two data states. Each child sets the page's design-time DataContext in
         XAML, overriding the page ctor's default seed. The narrow 420x840 frame goes on the page
         (never the <hd:Preview>) so the utu:Responsive layout resolves to the mobile view. Note: the
         Mapsui map is populated in code-behind, not data-bound, so it renders as an empty basemap in
         a preview — the filters, header stats and the FeedView-driven contact list are the data-bound
         surface these previews exercise. -->
    <hd:Preview PreviewName="All Contacts" Visibility="Collapsed">
        <local:ContactsPage 
                            DataContext="{x:Bind mock:ContactsPageMockData.Data}" />
    </hd:Preview>

    <hd:Preview PreviewName="No Results" Visibility="Collapsed">
        <local:ContactsPage Width="420"
                            Height="840"
                            DataContext="{x:Bind mock:ContactsPageMockData.NoResults}" />
    </hd:Preview>
</hd:PreviewGroup>