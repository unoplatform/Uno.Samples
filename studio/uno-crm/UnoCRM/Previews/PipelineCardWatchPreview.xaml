<hd:Preview x:Class="UnoCRM.Previews.PipelineCardWatchPreview"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:controls="using:UnoCRM.Controls"
            xmlns:hd="using:Uno.UI.HotDesign"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            mc:Ignorable="d"
            Width="260"
            Height="150">

    <!-- Open + watch -> amber status dot. -->
    <controls:PipelineCard Company="TechVision Inc"
                           Amount="$28,500"
                           Owner="Mike Johnson"
                           Meta="5d"
                           IsWon="False"
                           Accent="{ThemeResource DashboardAmberBrush}"
                           VerticalAlignment="Center" />
</hd:Preview>
