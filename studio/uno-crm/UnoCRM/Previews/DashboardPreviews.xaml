<hd:PreviewGroup x:Class="UnoCRM.Previews.DashboardPreviews"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="using:UnoCRM.Presentation"
                 xmlns:mock="using:UnoCRM.Presentation.MockData"
                 xmlns:hd="using:Uno.UI.HotDesign"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d">

    <!-- The dashboard for a busy tenant and for a quiet account. The two differ on every axis the page
         draws: volumes, all three delta directions (rising, flat, falling), how far the funnel bars
         reach, and whether the activity FeedView has anything to show.
         Each child supplies the page's design-time DataContext in XAML — the only safe place for the
         generated-ViewModel mock, which must never be seeded from a page constructor. No size on the
         <hd:Preview>: a page fills the canvas, and switching the device frame is what flips the
         desktop and mobile arrangements. -->
    <hd:Preview PreviewName="Busy Tenant" Visibility="Collapsed">
        <local:DashboardPage DataContext="{x:Bind mock:DashboardPageMockData.Data}" />
    </hd:Preview>

    <hd:Preview PreviewName="Quiet Account" Visibility="Collapsed">
        <local:DashboardPage DataContext="{x:Bind mock:DashboardPageMockData.QuietAccount}" />
    </hd:Preview>

</hd:PreviewGroup>
