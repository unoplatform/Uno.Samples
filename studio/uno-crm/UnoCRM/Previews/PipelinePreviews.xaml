<hd:PreviewGroup x:Class="UnoCRM.Previews.PipelinePreviews"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="using:UnoCRM.Presentation"
                 xmlns:mock="using:UnoCRM.Presentation.MockData"
                 xmlns:hd="using:Uno.UI.HotDesign"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d">

    <!-- The sales board with all five stages populated, and with an empty board — the mobile list's
         NoneTemplate, which the running app cannot reach against the in-memory service.
         Each child supplies the page's design-time DataContext in XAML — the only safe place for the
         generated-ViewModel mock, which must never be seeded from a page constructor. No size on the
         <hd:Preview>: a page fills the canvas, and switching the device frame is what flips the
         desktop and mobile arrangements. -->
    <hd:Preview PreviewName="Full Board" Visibility="Collapsed">
        <local:PipelinePage DataContext="{x:Bind mock:PipelinePageMockData.Data}" />
    </hd:Preview>

    <hd:Preview PreviewName="Empty Board" Visibility="Collapsed">
        <local:PipelinePage DataContext="{x:Bind mock:PipelinePageMockData.EmptyBoard}" />
    </hd:Preview>

</hd:PreviewGroup>
