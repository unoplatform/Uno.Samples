<hd:Preview x:Class="UnoCRM.Previews.PipelineCardWonPreview"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:controls="using:UnoCRM.Controls"
            xmlns:hd="using:Uno.UI.HotDesign"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            mc:Ignorable="d"
            Width="260"
            Height="150">

    <!-- Closed won -> IsWon swaps the status dot for a green check and the meta reads "Won". -->
    <controls:PipelineCard Company="Summit Retail"
                           Amount="$156,000"
                           Owner="Paul Martinez"
                           Meta="Won"
                           IsWon="True"
                           Accent="{ThemeResource DashboardGreenBrush}"
                           VerticalAlignment="Center" />
</hd:Preview>
