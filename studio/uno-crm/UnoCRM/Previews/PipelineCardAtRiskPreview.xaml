<hd:Preview x:Class="UnoCRM.Previews.PipelineCardAtRiskPreview"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:controls="using:UnoCRM.Controls"
            xmlns:hd="using:Uno.UI.HotDesign"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            mc:Ignorable="d"
            Width="260"
            Height="150">

    <!-- Open + at risk -> red status dot (the largest, most-stalled open deal). -->
    <controls:PipelineCard Company="Vertex Labs"
                           Amount="$210,000"
                           Owner="Kevin Zhang"
                           Meta="22d"
                           IsWon="False"
                           Accent="{ThemeResource DashboardRedBrush}"
                           VerticalAlignment="Center" />
</hd:Preview>
