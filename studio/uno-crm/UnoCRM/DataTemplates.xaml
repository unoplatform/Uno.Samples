<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:uen="using:Uno.Extensions.Navigation.UI"
                    xmlns:controls="using:UnoCRM.Controls"
                    xmlns:sel="using:UnoCRM.Selectors">

  <!--
    Every item/content template in the app, keyed and shared rather than declared inline in a
    page's <Page.Resources>. Two reasons: a template defined here is a standalone design-time
    surface (it can be previewed and edited on its own, instead of only as part of whichever page
    happened to declare it), and a template that a preview inflates outside its page can still
    resolve its {StaticResource}s — an inline page resource cannot.

    Merged after Styles.xaml in App.xaml, so these templates consume that file's styles, tokens
    and converters by key. Templates that depend on another key here are declared after it.
  -->

  <!-- ══════════ ContactsPage ══════════ -->

  <!-- One contact, as a card: name + segment, company, then city + region. -->
  <DataTemplate x:Key="DesktopContactCardTemplate">
    <Border Style="{StaticResource DashboardKanbanCardStyle}"
            Margin="0,0,0,10">
      <StackPanel Spacing="6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Name}"
                     Style="{StaticResource DashboardBodyTextStyle}" />
          <TextBlock Grid.Column="1"
                     Text="{Binding Segment}"
                     Style="{StaticResource DashboardMicroTextStyle}" />
        </Grid>
        <TextBlock Text="{Binding Company}"
                   Style="{StaticResource DashboardSubtleTextStyle}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding City}"
                     Style="{StaticResource DashboardSubtleTextStyle}" />
          <TextBlock Grid.Column="1"
                     Text="{Binding Region}"
                     Foreground="{ThemeResource DashboardAccentBrush}"
                     FontSize="12" />
        </Grid>
      </StackPanel>
    </Border>
  </DataTemplate>

  <!-- The desktop FeedView's populated state: the materialized feed value in a ListView. The item
       container style is in Styles.xaml with the rest of the named styles. -->
  <DataTemplate x:Key="DesktopContactListTemplate">
    <ListView ItemsSource="{Binding Data}"
              BorderThickness="0"
              Background="Transparent"
              SelectionMode="None"
              ItemContainerStyle="{StaticResource ContactListItemStyle}"
              ItemTemplate="{StaticResource DesktopContactCardTemplate}" />
  </DataTemplate>

  <!-- The desktop FeedView's None state (a list feed emits None when it has no items). -->
  <DataTemplate x:Key="DesktopContactsEmptyTemplate">
    <TextBlock Text="No contacts match your filters."
               Style="{StaticResource DashboardSubtleTextStyle}"
               HorizontalAlignment="Center"
               VerticalAlignment="Top"
               Margin="0,24,0,0" />
  </DataTemplate>

  <!-- The same contact card, without the segment label the narrow layout has no room for. -->
  <DataTemplate x:Key="MobileContactCardTemplate">
    <Border Style="{StaticResource DashboardKanbanCardStyle}"
            Margin="0,0,0,10">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding Name}" Style="{StaticResource DashboardBodyTextStyle}" />
        <TextBlock Text="{Binding Company}" Style="{StaticResource DashboardSubtleTextStyle}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding City}" Style="{StaticResource DashboardSubtleTextStyle}" />
          <TextBlock Grid.Column="1" Text="{Binding Region}" Foreground="{ThemeResource DashboardAccentBrush}" FontSize="12" />
        </Grid>
      </StackPanel>
    </Border>
  </DataTemplate>

  <!-- The mobile FeedView's populated state. ItemsControl (not ListView) so the list has no inner
       scroll and the whole page scrolls as one — a nested ListView scroll would trap the gesture
       and never move the page offset. -->
  <DataTemplate x:Key="MobileContactListTemplate">
    <ItemsControl ItemsSource="{Binding Data}"
                  ItemTemplate="{StaticResource MobileContactCardTemplate}" />
  </DataTemplate>

  <!-- The mobile FeedView's None state. -->
  <DataTemplate x:Key="MobileContactsEmptyTemplate">
    <TextBlock Text="No contacts match your filters."
               Style="{StaticResource DashboardSubtleTextStyle}"
               HorizontalAlignment="Center"
               Margin="0,8,0,4" />
  </DataTemplate>

  <!-- ══════════ DashboardPage ══════════ -->

  <!-- Recent-activity rows, bound to the model's Activities: each shows a title, a detail line
       and a relative timestamp. -->
  <DataTemplate x:Key="DesktopActivityTemplate">
    <Border BorderBrush="{ThemeResource DashboardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,14">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding Title}" Style="{StaticResource DashboardBodyTextStyle}" />
          <TextBlock Text="{Binding Detail}" Style="{StaticResource DashboardSubtleTextStyle}" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding TimeAgo}"
                   Style="{StaticResource DashboardSubtleTextStyle}" FontSize="12" />
      </Grid>
    </Border>
  </DataTemplate>

  <DataTemplate x:Key="MobileActivityTemplate">
    <Border BorderBrush="{ThemeResource DashboardBorderBrush}" BorderThickness="0,0,0,1" Padding="16,16">
      <Grid ColumnSpacing="14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" Style="{StaticResource DashboardBodyTextStyle}" />
          <TextBlock Text="{Binding Detail}" Style="{StaticResource DashboardSubtleTextStyle}" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding TimeAgo}"
                   Style="{StaticResource DashboardSubtleTextStyle}" FontSize="12" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </DataTemplate>

  <!-- ══════════ LeadsPage ══════════ -->

  <!-- A "Top Open Leads" row, bound to the highest-value open deals in the shared dataset. -->
  <DataTemplate x:Key="TopLeadTemplate">
    <Border BorderBrush="{ThemeResource DashboardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Company}" Style="{StaticResource DashboardBodyTextStyle}" />
        <TextBlock Grid.Column="1" Text="{Binding AmountDisplay}"
                   Style="{StaticResource DashboardBodyTextStyle}"
                   Foreground="{ThemeResource DashboardAccentBrush}" />
      </Grid>
    </Border>
  </DataTemplate>

  <!-- ══════════ PipelinePage ══════════ -->

  <!-- One deal tile, bound to a Deal from the shared dataset. Reused by every stage column
       (desktop) and by the stacked stage list (mobile). -->
  <DataTemplate x:Key="DealCardTemplate">
    <!-- The whole card is a real Button (accessible + tactile press) that opens the deal detail
         via the navigation-data route. -->
    <Button Style="{StaticResource ClickableCardButtonStyle}"
            uen:Navigation.Request="DealDetail"
            uen:Navigation.Data="{Binding}"
            AutomationProperties.Name="{Binding Company}">
      <controls:PipelineCard Company="{Binding Company}"
                             Amount="{Binding AmountDisplay}"
                             Owner="{Binding Owner}"
                             Meta="{Binding MetaDisplay}"
                             IsWon="{Binding IsWon}"
                             Health="{Binding Health}" />
    </Button>
  </DataTemplate>

  <ItemsPanelTemplate x:Key="DealStackPanel">
    <StackPanel Spacing="12" />
  </ItemsPanelTemplate>

  <!-- Panel for the mobile list of stage sections (wider gap than between cards within a stage). -->
  <ItemsPanelTemplate x:Key="StageStackPanel">
    <StackPanel Spacing="18" />
  </ItemsPanelTemplate>

  <!-- A full mobile stage section: colored header with live count, then its deal cards. -->
  <DataTemplate x:Key="MobileStageTemplate">
    <StackPanel Spacing="12" Margin="0,0,0,6">
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                 Fill="{Binding AccentKey, Converter={StaticResource ResourceKeyToBrush}}" />
        <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource DashboardSectionLabelStyle}" VerticalAlignment="Center"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
        <Border Grid.Column="2" HorizontalAlignment="Left" CornerRadius="8" Padding="6,1" VerticalAlignment="Center"
                Background="{Binding SoftKey, Converter={StaticResource ResourceKeyToBrush}}">
          <TextBlock Text="{Binding Count}" FontSize="11"
                     Foreground="{Binding DeepKey, Converter={StaticResource ResourceKeyToBrush}}" />
        </Border>
      </Grid>
      <ItemsControl ItemsSource="{Binding Deals}"
                    ItemTemplate="{StaticResource DealCardTemplate}"
                    ItemsPanel="{StaticResource DealStackPanel}" />
    </StackPanel>
  </DataTemplate>

  <!-- ══════════ DealDetailPage ══════════ -->

  <!--
    Stage, health and dwell time each get ONE KEYED TEMPLATE PER STATE, chosen by a
    DataTemplateSelector over the deal (see UnoCRM.Selectors). Two reasons.

    Correctness: every color a state needs is a literal {ThemeResource} written in XAML, so it
    resolves against the element's own theme in light and dark, and against this app's resources
    inside a design-time preview host. Carrying a palette-key string on the deal and converting it
    to a Brush resolves app-wide instead, which is how the old health dot ended up invisible in the
    previews and the wrong gray in dark mode.

    Legibility: the states are told apart by FORM before color. The stage raises a different step
    on a five-step track; health changes silhouette, size and weight; dwell fills a gauge past two
    threshold notches. Read the page in grayscale and all three still answer their question.
  -->

  <!-- The five-step pipeline track, one template per stage. Steps already cleared are solid and
       mid-weight, steps still ahead are hairlines, and the step the deal is IN is the tallest bar
       and the only colored thing in the card - in the hue the Pipeline board gives that column. -->
  <DataTemplate x:Key="DealStageTrackNewLeadTemplate">
    <Grid ColumnSpacing="6" Height="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource StageTrackCurrentStyle}" Background="{ThemeResource DashboardBlueBrush}" />
      <Border Grid.Column="1" Style="{StaticResource StageTrackFutureStyle}" />
      <Border Grid.Column="2" Style="{StaticResource StageTrackFutureStyle}" />
      <Border Grid.Column="3" Style="{StaticResource StageTrackFutureStyle}" />
      <Border Grid.Column="4" Style="{StaticResource StageTrackFutureStyle}" />
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="DealStageTrackQualifiedTemplate">
    <Grid ColumnSpacing="6" Height="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource StageTrackDoneStyle}" />
      <Border Grid.Column="1" Style="{StaticResource StageTrackCurrentStyle}" Background="{ThemeResource DashboardPurpleBrush}" />
      <Border Grid.Column="2" Style="{StaticResource StageTrackFutureStyle}" />
      <Border Grid.Column="3" Style="{StaticResource StageTrackFutureStyle}" />
      <Border Grid.Column="4" Style="{StaticResource StageTrackFutureStyle}" />
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="DealStageTrackProposalTemplate">
    <Grid ColumnSpacing="6" Height="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource StageTrackDoneStyle}" />
      <Border Grid.Column="1" Style="{StaticResource StageTrackDoneStyle}" />
      <Border Grid.Column="2" Style="{StaticResource StageTrackCurrentStyle}" Background="{ThemeResource DashboardAmberBrush}" />
      <Border Grid.Column="3" Style="{StaticResource StageTrackFutureStyle}" />
      <Border Grid.Column="4" Style="{StaticResource StageTrackFutureStyle}" />
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="DealStageTrackNegotiationTemplate">
    <Grid ColumnSpacing="6" Height="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource StageTrackDoneStyle}" />
      <Border Grid.Column="1" Style="{StaticResource StageTrackDoneStyle}" />
      <Border Grid.Column="2" Style="{StaticResource StageTrackDoneStyle}" />
      <Border Grid.Column="3" Style="{StaticResource StageTrackCurrentStyle}" Background="{ThemeResource DashboardRedBrush}" />
      <Border Grid.Column="4" Style="{StaticResource StageTrackFutureStyle}" />
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="DealStageTrackClosedWonTemplate">
    <Grid ColumnSpacing="6" Height="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource StageTrackDoneStyle}" />
      <Border Grid.Column="1" Style="{StaticResource StageTrackDoneStyle}" />
      <Border Grid.Column="2" Style="{StaticResource StageTrackDoneStyle}" />
      <Border Grid.Column="3" Style="{StaticResource StageTrackDoneStyle}" />
      <Border Grid.Column="4" Style="{StaticResource StageTrackCurrentStyle}" Background="{ThemeResource DashboardGreenBrush}" />
    </Grid>
  </DataTemplate>

  <!-- Health, as an escalating mark. The silhouette carries it: a calm round dot (the same dot the
       Pipeline board puts on an open card), then a caution diamond, then an alarm triangle - each
       larger than the last, in a container that goes bare -> outlined -> filled, with a label that
       goes Regular -> SemiBold -> Bold. Color is the last layer, never the only one. -->
  <DataTemplate x:Key="DealHealthHealthyTemplate">
    <Border Style="{StaticResource HealthMarkBorderStyle}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Ellipse Width="10" Height="10"
                 VerticalAlignment="Center"
                 Fill="{ThemeResource DashboardGreenBrush}" />
        <TextBlock Text="{Binding HealthDisplay}"
                   Style="{StaticResource DashboardBodyTextStyle}"
                   VerticalAlignment="Center" />
      </StackPanel>
    </Border>
  </DataTemplate>

  <DataTemplate x:Key="DealHealthWatchTemplate">
    <Border Style="{StaticResource HealthMarkBorderStyle}"
            BorderBrush="{ThemeResource DashboardAmberBrush}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <!-- Caution diamond with the mark punched out (EvenOdd), sized as a Path with
             Stretch="Uniform" so the ink centres on its own tight bounds. -->
        <Path Width="14" Height="14"
              VerticalAlignment="Center"
              Stretch="Uniform"
              Data="F0 M12 2 L22 12 L12 22 L2 12 Z M10.9 8.4 L13.1 8.4 L13.1 14.4 L10.9 14.4 Z M10.9 16.1 L13.1 16.1 L13.1 18.3 L10.9 18.3 Z"
              Fill="{ThemeResource DashboardAmberDeepBrush}" />
        <TextBlock Text="{Binding HealthDisplay}"
                   Style="{StaticResource DashboardBodyTextStyle}"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />
      </StackPanel>
    </Border>
  </DataTemplate>

  <DataTemplate x:Key="DealHealthAtRiskTemplate">
    <Border Style="{StaticResource HealthMarkBorderStyle}"
            Background="{ThemeResource DashboardRedSoftBrush}"
            BorderBrush="{ThemeResource DashboardRedBrush}"
            BorderThickness="2">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <!-- Alarm triangle, the largest and only filled-container mark on the page. -->
        <Path Width="16" Height="16"
              VerticalAlignment="Center"
              Stretch="Uniform"
              Data="F0 M12 2.5 L22.6 21 L1.4 21 Z M10.9 9.6 L13.1 9.6 L13.1 15 L10.9 15 Z M10.9 16.7 L13.1 16.7 L13.1 18.9 L10.9 18.9 Z"
              Fill="{ThemeResource DashboardRedDeepBrush}" />
        <TextBlock Text="{Binding HealthDisplay}"
                   Style="{StaticResource DashboardBodyTextStyle}"
                   FontWeight="Bold"
                   Foreground="{ThemeResource DashboardRedDeepBrush}"
                   VerticalAlignment="Center" />
      </StackPanel>
    </Border>
  </DataTemplate>

  <!-- Dwell time. The gauge spans 30 days and is notched at day 8 and day 21 - the same two
       thresholds the band word names - so "how long has this sat" is answered by WHERE the fill
       stops, not by its color. Fresh and Stalling share this neutral treatment; only the stale
       band (below) spends color on it. -->
  <DataTemplate x:Key="DealDwellTrackedTemplate">
    <StackPanel Spacing="8">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="TIME IN STAGE"
                   Style="{StaticResource DashboardSectionLabelStyle}"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="1"
                   Text="{Binding AgeBandDisplay}"
                   Style="{StaticResource DashboardSubtleTextStyle}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center" />
      </Grid>
      <TextBlock Text="{Binding AgeInStageDisplay}"
                 Style="{StaticResource DashboardMetricValueStyle}"
                 FontSize="20" />
      <Grid Height="10" AutomationProperties.AccessibilityView="Raw">
        <Border Style="{StaticResource DwellGaugeTrackStyle}" />
        <Grid VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding AgeProgress, Converter={StaticResource DoubleToGridLength}}" />
            <ColumnDefinition Width="{Binding AgeProgress, Converter={StaticResource DoubleToGridLength}, ConverterParameter=Remainder}" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource DwellGaugeFillStyle}"
                  Background="{ThemeResource DashboardMutedTextBrush}" />
        </Grid>
        <!-- 8 / 13 / 9 = the 30-day span split at day 8 and day 21. -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="8*" />
            <ColumnDefinition Width="13*" />
            <ColumnDefinition Width="9*" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="1" Style="{StaticResource DwellGaugeThresholdStyle}" />
          <Border Grid.Column="2" Style="{StaticResource DwellGaugeThresholdStyle}" />
        </Grid>
      </Grid>
    </StackPanel>
  </DataTemplate>

  <!-- Past three weeks in one stage: the gauge is over its last notch, and this is the one band
       that earns color, with the band word set Bold to match. -->
  <DataTemplate x:Key="DealDwellStaleTemplate">
    <StackPanel Spacing="8">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="TIME IN STAGE"
                   Style="{StaticResource DashboardSectionLabelStyle}"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="1"
                   Text="{Binding AgeBandDisplay}"
                   Style="{StaticResource DashboardSubtleTextStyle}"
                   FontWeight="Bold"
                   Foreground="{ThemeResource DashboardRedDeepBrush}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center" />
      </Grid>
      <TextBlock Text="{Binding AgeInStageDisplay}"
                 Style="{StaticResource DashboardMetricValueStyle}"
                 FontSize="20" />
      <Grid Height="10" AutomationProperties.AccessibilityView="Raw">
        <Border Style="{StaticResource DwellGaugeTrackStyle}" />
        <Grid VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding AgeProgress, Converter={StaticResource DoubleToGridLength}}" />
            <ColumnDefinition Width="{Binding AgeProgress, Converter={StaticResource DoubleToGridLength}, ConverterParameter=Remainder}" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource DwellGaugeFillStyle}"
                  Background="{ThemeResource DashboardRedBrush}" />
        </Grid>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="8*" />
            <ColumnDefinition Width="13*" />
            <ColumnDefinition Width="9*" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="1" Style="{StaticResource DwellGaugeThresholdStyle}" />
          <Border Grid.Column="2" Style="{StaticResource DwellGaugeThresholdStyle}" />
        </Grid>
      </Grid>
    </StackPanel>
  </DataTemplate>

  <!-- A closed deal is not sitting in a stage, so there is no dwell time to show - and a day count
       or the card's "Won" badge in this slot would just be wrong. Say so instead. -->
  <DataTemplate x:Key="DealDwellClosedTemplate">
    <StackPanel Spacing="4">
      <TextBlock Text="TIME IN STAGE" Style="{StaticResource DashboardSectionLabelStyle}" />
      <TextBlock Text="Not tracked once a deal is closed."
                 Style="{StaticResource DashboardSubtleTextStyle}" />
    </StackPanel>
  </DataTemplate>

  <!-- The selectors, declared after the templates they point at. -->
  <sel:DealStageTrackTemplateSelector x:Key="DealStageTrackSelector"
                                      NewLead="{StaticResource DealStageTrackNewLeadTemplate}"
                                      Qualified="{StaticResource DealStageTrackQualifiedTemplate}"
                                      Proposal="{StaticResource DealStageTrackProposalTemplate}"
                                      Negotiation="{StaticResource DealStageTrackNegotiationTemplate}"
                                      ClosedWon="{StaticResource DealStageTrackClosedWonTemplate}" />

  <sel:DealHealthMarkTemplateSelector x:Key="DealHealthMarkSelector"
                                      Healthy="{StaticResource DealHealthHealthyTemplate}"
                                      Watch="{StaticResource DealHealthWatchTemplate}"
                                      AtRisk="{StaticResource DealHealthAtRiskTemplate}" />

  <sel:DealDwellTemplateSelector x:Key="DealDwellSelector"
                                 Tracked="{StaticResource DealDwellTrackedTemplate}"
                                 Stale="{StaticResource DealDwellStaleTemplate}"
                                 Closed="{StaticResource DealDwellClosedTemplate}" />

  <!-- ══════════════════════ FeedView failure state (shared) ══════════════════════ -->

  <!-- Every list read over ICrmService uses this as its ErrorTemplate, so an unreachable backend
       looks the same on every page. The FeedViewState's Refresh command re-runs the underlying
       request, so no Model command is needed. -->
  <DataTemplate x:Key="CrmErrorTemplate">
    <Border Style="{StaticResource DashboardKanbanCardStyle}" Margin="0,8,0,0">
      <StackPanel Spacing="8" Padding="4,8" HorizontalAlignment="Center">
        <TextBlock Text="Couldn't load this"
                   Style="{StaticResource DashboardBodyTextStyle}"
                   HorizontalAlignment="Center" />
        <TextBlock Text="Check your connection and try again."
                   Style="{StaticResource DashboardSubtleTextStyle}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
        <Button Content="Try again"
                AutomationProperties.Name="Try again"
                HorizontalAlignment="Center"
                Margin="0,4,0,0"
                Command="{Binding Refresh}" />
      </StackPanel>
    </Border>
  </DataTemplate>

  <!-- ══════════════════════ FeedView surfaces ══════════════════════ -->

  <!-- Recent activity, in the desktop and mobile treatments. Both render the SAME Activities feed,
       so the two arrangements stay in step by construction. -->
  <DataTemplate x:Key="DesktopActivityListTemplate">
    <ItemsControl ItemsSource="{Binding Data}"
                  ItemTemplate="{StaticResource DesktopActivityTemplate}" />
  </DataTemplate>

  <DataTemplate x:Key="MobileActivityListTemplate">
    <ItemsControl ItemsSource="{Binding Data}"
                  ItemTemplate="{StaticResource MobileActivityTemplate}" />
  </DataTemplate>

  <DataTemplate x:Key="NoActivityTemplate">
    <TextBlock Text="No recent activity."
               Style="{StaticResource DashboardSubtleTextStyle}"
               Margin="0,8,0,4"
               TextWrapping="Wrap" />
  </DataTemplate>

  <!-- The mobile pipeline board's stage list. -->
  <DataTemplate x:Key="MobileStageListTemplate">
    <ItemsControl ItemsSource="{Binding Data}"
                  ItemTemplate="{StaticResource MobileStageTemplate}"
                  ItemsPanel="{StaticResource StageStackPanel}" />
  </DataTemplate>

  <DataTemplate x:Key="NoStagesTemplate">
    <TextBlock Text="No pipeline stages to show."
               Style="{StaticResource DashboardSubtleTextStyle}"
               Margin="0,8,0,4"
               TextWrapping="Wrap" />
  </DataTemplate>

  <!-- The Leads page's top-open-leads list (desktop rail). -->
  <DataTemplate x:Key="TopLeadListTemplate">
    <ItemsControl ItemsSource="{Binding Data}"
                  ItemTemplate="{StaticResource TopLeadTemplate}" />
  </DataTemplate>

  <DataTemplate x:Key="NoOpenLeadsTemplate">
    <TextBlock Text="No open leads right now."
               Style="{StaticResource DashboardSubtleTextStyle}"
               Margin="0,8,0,4"
               TextWrapping="Wrap" />
  </DataTemplate>

  <!-- The desktop kanban board, hosted by a FeedView so the five columns cannot render a count until
       the stages have actually loaded. Columns are addressed by index into the loaded list; the label
       and accent above each one are fixed, so the index is unambiguous in place. -->
  <DataTemplate x:Key="DesktopStageBoardTemplate">
      <Grid ColumnSpacing="14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Spacing="12">
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center" Fill="{ThemeResource DashboardBlueBrush}" />
            <TextBlock Grid.Column="1" Text="NEW LEAD" Style="{StaticResource DashboardSectionLabelStyle}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            <Border Grid.Column="2" VerticalAlignment="Center" Background="{ThemeResource DashboardBlueSoftBrush}" CornerRadius="8" Padding="6,1">
              <TextBlock Text="{Binding Data[0].Count}" Foreground="{ThemeResource DashboardBlueDeepBrush}" FontSize="11" />
            </Border>
          </Grid>
          <ItemsControl ItemsSource="{Binding Data[0].Deals}"
                        ItemTemplate="{StaticResource DealCardTemplate}"
                        ItemsPanel="{StaticResource DealStackPanel}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="12">
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center" Fill="{ThemeResource DashboardPurpleBrush}" />
            <TextBlock Grid.Column="1" Text="QUALIFIED" Style="{StaticResource DashboardSectionLabelStyle}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            <Border Grid.Column="2" VerticalAlignment="Center" Background="{ThemeResource DashboardPurpleSoftBrush}" CornerRadius="8" Padding="6,1">
              <TextBlock Text="{Binding Data[1].Count}" Foreground="{ThemeResource DashboardPurpleDeepBrush}" FontSize="11" />
            </Border>
