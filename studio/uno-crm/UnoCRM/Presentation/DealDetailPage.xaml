<Page x:Class="UnoCRM.Presentation.DealDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource DashboardPageBackgroundBrush}">

  <!--
    Three cards, ordered by how much the reader has to decide on:

      1. IDENTITY    - who the deal is with, where it sits in the pipeline, what it is worth.
      2. STATUS      - the two facts that ask for a decision: health, and how long it has sat.
      3. ATTRIBUTION - the quiet reference facts: owner and lead source.

    Stage, health and dwell time used to share a four-cell grid with owner and lead source, which
    said that "at risk" mattered no more than "lead source". They are now the whole middle card
    (and, for the stage, part of the deal's identity), each drawn by a keyed per-state template from
    DataTemplates.xaml so the states differ in FORM first - a raised step on a five-step track, a
    different silhouette, a gauge past a labelled threshold - and only then in color.
  -->
  <Grid Background="{ThemeResource DashboardPageBackgroundBrush}"
        utu:SafeArea.Insets="Top,Bottom">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <Grid Padding="{utu:Responsive Narrow='20,16,20,32', Wide='28,24,28,28'}"
            HorizontalAlignment="Stretch">
        <Grid MaxWidth="720"
              HorizontalAlignment="Stretch"
              RowSpacing="20">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Header: back button + breadcrumb -->
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Button uen:Navigation.Request="-"
                    AutomationProperties.Name="Back"
                    Style="{StaticResource DashboardIconButtonStyle}">
              <!-- Sized Path with Stretch="Uniform" (not PathIcon) so the asymmetric chevron tight-centres in the round button. -->
              <Path Width="16" Height="16"
                    Data="F1 M15.5303 4.21967C15.8232 4.51256 15.8232 4.98744 15.5303 5.28033L8.81066 12L15.5303 18.7197C15.8232 19.0126 15.8232 19.4874 15.5303 19.7803C15.2374 20.0732 14.7626 20.0732 14.4697 19.7803L7.21967 12.5303C6.92678 12.2374 6.92678 11.7626 7.21967 11.4697L14.4697 4.21967C14.7626 3.92678 15.2374 3.92678 15.5303 4.21967Z"
                    Stretch="Uniform"
                    Fill="{ThemeResource DashboardPrimaryTextBrush}" />
            </Button>
            <TextBlock Text="DEAL DETAILS"
                       Style="{StaticResource DashboardSectionLabelStyle}"
                       VerticalAlignment="Center" />
          </StackPanel>

          <!-- 1. Identity: company, position in the pipeline, deal value -->
          <Border Grid.Row="1"
                  Style="{StaticResource DashboardPanelBorderStyle}"
                  Padding="28,26">
            <StackPanel Spacing="20">
              <TextBlock Text="{Binding Deal.Company}"
                         Style="{StaticResource DashboardCardTitleStyle}" />

              <!--
                Stage, stated three ways so none of them has to be the hue: the ordinal
                ("STEP 4 OF 5"), the name at section-title size, and the track underneath, whose
                raised step is the only colored mark in the card.
              -->
              <StackPanel Spacing="12">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Deal.StagePositionDisplay}"
                             Style="{StaticResource DashboardSectionLabelStyle}" />
                  <TextBlock Text="{Binding Deal.StageDisplay}"
                             Style="{StaticResource DashboardSectionTitleStyle}" />
                </StackPanel>
                <!-- ContentControl (not ContentPresenter) so the selected template gets its own
                     DataContext; Stretch on both axes or the track's star columns would size to
                     their content and collapse. The stage alone selects the template, and the
                     template draws five fixed bars, so nothing here binds. -->
                <ContentControl Content="{Binding Deal.Stage}"
                                ContentTemplateSelector="{StaticResource DealStageTrackSelector}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                IsTabStop="False"
                                AutomationProperties.AccessibilityView="Raw" />
              </StackPanel>

              <Border Height="1" Background="{ThemeResource DashboardDividerBrush}" />

              <StackPanel Spacing="2">
                <TextBlock Text="DEAL VALUE"
                           Style="{StaticResource DashboardSectionLabelStyle}" />
                <TextBlock Text="{Binding Deal.AmountDisplay}"
                           Style="{StaticResource DashboardMetricValueStyle}"
                           FontSize="44" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- 2. Status: the two facts that ask for a decision -->
          <Border Grid.Row="2"
                  Style="{StaticResource DashboardPanelBorderStyle}"
                  Padding="28,24">
            <StackPanel Spacing="18">
              <!-- Health reads as a definition row: label left, mark right, so the mark's own
                   size and container weight are what changes at the edge of the card. -->
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="HEALTH"
                           Style="{StaticResource DashboardSectionLabelStyle}"
                           VerticalAlignment="Center" />
                <ContentControl Grid.Column="1"
                                Content="{Binding Deal}"
                                ContentTemplateSelector="{StaticResource DealHealthMarkSelector}"
                                HorizontalAlignment="Right"
                                HorizontalContentAlignment="Right"
                                VerticalAlignment="Center"
                                IsTabStop="False" />
              </Grid>

              <Border Height="1" Background="{ThemeResource DashboardDividerBrush}" />

              <!-- Dwell time: the day count, its band, and a 30-day gauge notched at the two
                   thresholds. A closed deal swaps the whole read-out for a plain statement. -->
              <ContentControl Content="{Binding Deal}"
                              ContentTemplateSelector="{StaticResource DealDwellSelector}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              IsTabStop="False" />
            </StackPanel>
          </Border>

          <!-- 3. Attribution: the quiet reference facts -->
          <Border Grid.Row="3"
                  Style="{StaticResource DashboardPanelBorderStyle}"
                  Padding="28,24">
            <Grid ColumnSpacing="18">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <StackPanel Spacing="4">
                <TextBlock Text="OWNER" Style="{StaticResource DashboardSectionLabelStyle}" />
                <TextBlock Text="{Binding Deal.Owner}" Style="{StaticResource DashboardBodyTextStyle}" />
              </StackPanel>

              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="LEAD SOURCE" Style="{StaticResource DashboardSectionLabelStyle}" />
                <TextBlock Text="{Binding Deal.Source}" Style="{StaticResource DashboardBodyTextStyle}" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>
