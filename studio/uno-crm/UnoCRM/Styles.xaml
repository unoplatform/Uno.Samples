<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utu="using:Uno.Toolkit.UI"
                    xmlns:conv="using:UnoCRM.Converters">

  <!--
    App styling vocabulary: the shared converter, design tokens, the app-wide
    responsive breakpoint, and every named Style. Merged LAST in App.xaml so any well-known-key
    overrides win over the framework defaults. Pages only consume these keys.
  -->

  <!-- Converters -->
  <conv:ResourceKeyToBrushConverter x:Key="ResourceKeyToBrush" />
  <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  <conv:DoubleToGridLengthConverter x:Key="DoubleToGridLength" />

  <!-- App-wide responsive breakpoint: mobile below 900px, desktop at/above. Every {utu:Responsive}
       usage resolves this one key so the shell and every page share a single breakpoint. -->
  <utu:ResponsiveLayout x:Key="DefaultResponsiveLayout"
                        Narrow="0"
                        Wide="900" />

  <!-- Design tokens -->
  <!-- Radius scale: small controls / buttons+inputs / cards+panels -->
  <CornerRadius x:Key="RadiusSm">6</CornerRadius>
  <CornerRadius x:Key="RadiusMd">12</CornerRadius>
  <CornerRadius x:Key="RadiusLg">18</CornerRadius>
  <!-- Tactile press scale for buttons and clickable cards (design-polish house value) -->
  <x:Double x:Key="PressScale">0.98</x:Double>
  <!-- Type ramp: 11 micro / 12 caption / 13 label / 14 subtle / 15 body / 20 amount /
       22 section title / 30 page title + desktop metric / 32 mobile title / 44 hero metric.
       Pick a rung instead of inventing a new size. -->

  <Style x:Key="DashboardPanelBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource DashboardSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource DashboardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
  </Style>

  <Style x:Key="DashboardSectionLabelStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource DashboardMutedTextBrush}" />
    <Setter Property="CharacterSpacing" Value="280" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextWrapping" Value="WrapWholeWords" />
  </Style>

  <!-- Large page/card title. Roboto (framework font) with SemiBold weight + tightened tracking gives
       the editorial "display" feel the former Georgia serif was reaching for, but renders portably
       on every platform. -->
  <Style x:Key="DashboardCardTitleStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource DashboardPrimaryTextBrush}" />
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CharacterSpacing" Value="-15" />
    <Setter Property="TextWrapping" Value="WrapWholeWords" />
  </Style>

  <!-- Mid-size section/card heading (18-22px). Replaces the per-site Georgia headings with one
       shared style so the weight/tracking recipe lives in one place. -->
  <Style x:Key="DashboardSectionTitleStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource DashboardPrimaryTextBrush}" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CharacterSpacing" Value="-10" />
    <Setter Property="TextWrapping" Value="WrapWholeWords" />
  </Style>

  <Style x:Key="DashboardBodyTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource DashboardPrimaryTextBrush}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="TextWrapping" Value="WrapWholeWords" />
  </Style>

  <Style x:Key="DashboardSubtleTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource DashboardMutedTextBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="TextWrapping" Value="WrapWholeWords" />
  </Style>

  <Style x:Key="DashboardMicroTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource DashboardMutedTextBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="TextWrapping" Value="WrapWholeWords" />
  </Style>

  <Style x:Key="DashboardMetricValueStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource DashboardPrimaryTextBrush}" />
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <!-- A metric/currency value must never wrap to a second line. -->
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="DashboardSearchBoxStyle" TargetType="TextBox">
    <Setter Property="Background" Value="{ThemeResource DashboardSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource DashboardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="Foreground" Value="{ThemeResource DashboardPrimaryTextBrush}" />
    <Setter Property="PlaceholderForeground" Value="{ThemeResource DashboardMutedTextBrush}" />
  </Style>

  <Style x:Key="DashboardIconButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="38" />
    <Setter Property="Background" Value="{ThemeResource DashboardSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource DashboardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style x:Key="DashboardFilterButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource DashboardSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource DashboardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="Foreground" Value="{ThemeResource DashboardPrimaryTextBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style x:Key="DashboardPrimaryButtonStyle" TargetType="Button">
    <!-- A dedicated (slightly deeper in dark) teal so the White label clears AA — the accent brush
         used for text/links stays bright; darkening it there would hurt accent-on-surface contrast. -->
    <Setter Property="Background" Value="{ThemeResource DashboardPrimaryButtonBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource DashboardPrimaryButtonBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!--
    Chrome-less button that wraps a card so the whole card is a real, accessible activatable control
    (focus + keyboard Enter/Space + screen-reader Invoke) instead of a pointer-only tapped Border
    Adds the house tactile press: the content scales to 0.98 while pressed. The card's
    own visual (border/background) comes from its content, so this stays fully transparent.
  -->
  <Style x:Key="ClickableCardButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="CardRoot"
                Background="Transparent"
                RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver" />
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="CardScale.ScaleX" Value="{StaticResource PressScale}" />
                    <Setter Target="CardScale.ScaleY" Value="{StaticResource PressScale}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Stretch"
                              Content="{TemplateBinding Content}"
                              Padding="{TemplateBinding Padding}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DashboardKanbanCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource DashboardSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource DashboardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="14,12" />
  </Style>

  <!--
    Bottom-tab item that shows the FILLED icon variant when a tab is selected (outline otherwise) and
    tints both the icon and the label with the accent on selection. The filled glyph is supplied per
    item via Tag; Foreground is not inherited in WinUI/Uno, so the accent is applied per state to each.
    Applied to the stock bottom TabBar through its ItemContainerStyle.
  -->
  <Style x:Key="FilledSelectTabBarItemStyle"
         BasedOn="{StaticResource SimpleBottomTabBarItemStyle}"
         TargetType="utu:TabBarItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceMediumBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="utu:TabBarItem">
          <Grid x:Name="LayoutRoot"
                Background="{TemplateBinding Background}"
                Control.IsTemplateFocusTarget="True"
                RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform x:Name="PressScaleTransform" />
            </Grid.RenderTransform>

            <Grid HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  RowSpacing="2">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <!-- The item's Tag holds the icon overlay (outline/filled Paths toggled by IsSelected). -->
              <ContentPresenter Grid.Row="0"
                                Content="{TemplateBinding Tag}"
                                HorizontalAlignment="Center" />

              <ContentPresenter x:Name="ContentPresenter"
                                Grid.Row="1"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{TemplateBinding FontSize}"
                                HorizontalAlignment="Center"
                                TextWrapping="NoWrap"
                                AutomationProperties.AccessibilityView="Raw" />
            </Grid>

            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver" />
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="PressScaleTransform.ScaleX" Value="{StaticResource PressScale}" />
                    <Setter Target="PressScaleTransform.ScaleY" Value="{StaticResource PressScale}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Selected">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource PrimaryBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PointerOverSelected">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource PrimaryBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PressedSelected">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource PrimaryBrush}" />
                    <Setter Target="PressScaleTransform.ScaleX" Value="{StaticResource PressScale}" />
                    <Setter Target="PressScaleTransform.ScaleY" Value="{StaticResource PressScale}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="DisabledStates">
                <VisualState x:Name="Enabled" />
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="LayoutRoot.Opacity" Value="0.38" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="TabBarIconPositionStates">
                <VisualState x:Name="IconOnTop" />
                <VisualState x:Name="IconOnly" />
                <VisualState x:Name="ContentOnly" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Contact list item container: replaces the default WinUI item chrome (the square gray
    hover/press rectangle) with a hover ring that exactly matches the contact card's rounded
    shape and bottom margin. The ring sits above the card (hit-test transparent) and turns
    accent on pointer-over / press.
  -->
  <Style x:Key="ContactListItemStyle" TargetType="ListViewItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListViewItem">
          <Grid>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="HoverRing.BorderBrush" Value="{ThemeResource DashboardAccentBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="HoverRing.BorderBrush" Value="{ThemeResource DashboardAccentBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              ContentTransitions="{TemplateBinding ContentTransitions}" />
            <Border x:Name="HoverRing"
                    Margin="0,0,0,10"
                    CornerRadius="12"
                    BorderThickness="1.5"
                    BorderBrush="Transparent"
                    IsHitTestVisible="False" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
