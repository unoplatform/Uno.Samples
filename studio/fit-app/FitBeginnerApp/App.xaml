<Application x:Class="FitBeginnerApp.App"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:utus="using:Uno.Toolkit.UI.Simple">

  <!-- App.xaml is a thin manifest: it only merges the dedicated dictionaries, each with one
       concern. The palette lives in ThemeColors.xaml, the motion/feel tokens in MotionTokens.xaml,
       the app's styling vocabulary (converters, styles, tokens) in Styles.xaml, and every keyed
       item/content template in DataTemplates.xaml. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Load WinUI resources -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <!-- Ocean-blue FitStart palette (light + dark) layered onto the Simple theme. Uses the Simple
             theme's default font (no bundled custom font). -->
        <utus:SimpleToolkitTheme ColorOverrideSource="ms-appx:///ThemeColors.xaml" />
        <!-- House motion/feel tokens (easing, duration, radius, press) — give numbers, not adjectives. -->
        <ResourceDictionary Source="ms-appx:///MotionTokens.xaml" />
        <!-- App styling vocabulary. Merged after the theme so its well-known-key overrides
             (ControlCornerRadius*, OverlayCornerRadius) beat the theme defaults. -->
        <ResourceDictionary Source="ms-appx:///Styles.xaml" />
        <!-- Every shared item/content template, keyed. Merged LAST: the templates consume the type
             scale, styles and converters above by key, and being app-merged is what makes each one
             a standalone design-time surface. -->
        <ResourceDictionary Source="ms-appx:///DataTemplates.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>
