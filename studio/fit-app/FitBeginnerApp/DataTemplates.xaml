<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:uen="using:Uno.Extensions.Navigation.UI"
                    xmlns:presentation="using:FitBeginnerApp.Presentation">

  <!--
    Every item/content template in FitStart, keyed and shared here rather than declared inline in
    the page that happens to use it. Two reasons: a keyed template in an app-merged dictionary is a
    standalone design-time surface (it can be previewed and edited on its own instead of only as
    part of its page), and a template inflated outside its page — by a preview, or by a second page
    — can still resolve its {StaticResource}s, which an inline page resource cannot.

    Merged into App.xaml AFTER Styles.xaml, so these templates consume that file's type scale,
    card/label styles, converters and tokens by key. A template that depends on another key HERE is
    declared after it — the Feeling-pill selector after the four pills it aggregates, and the
    workout-result card after the selector. (A {StaticResource} inside a template BODY resolves at
    inflation, so it can reach any merged dictionary; a key referenced on an attribute, like the
    selector's, resolves at parse and really does need to come later in the file.)

    Nothing here reached the page namescope through ElementName, so the move needed no rewriting:
    every item surface is display-only except PlannedWorkoutTemplate, whose card opens the session
    via uen:Navigation.Request. That is an attached property the navigator resolves by walking up to
    the nearest region at runtime — namescope-independent, so it survives relocation. In a standalone
    preview there is no region above the template, so the card is simply inert; expected.
  -->

  <!-- ══════════════════════ Feeling pills (shared: Home + Progress) ══════════════════════ -->

  <!-- One {ThemeResource}-based template per value, chosen by the selector below. Colour lives in
       XAML (theme-reactive, and resolved against the correct app under Studio Live's ALC) rather
       than in a brush-returning converter reading Application.Current.Resources. -->

  <DataTemplate x:Key="FeelingPillGreatTemplate">
    <Border Background="{ThemeResource PrimaryContainerBrush}" CornerRadius="8" Padding="10,5" VerticalAlignment="Center">
      <TextBlock Text="{Binding}" FontSize="{StaticResource FontSizeLabel}" CharacterSpacing="140" Foreground="{ThemeResource OnPrimaryContainerBrush}" VerticalAlignment="Center" HorizontalTextAlignment="Center" />
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="FeelingPillGoodTemplate">
    <Border Background="{ThemeResource TertiaryContainerBrush}" CornerRadius="8" Padding="10,5" VerticalAlignment="Center">
      <TextBlock Text="{Binding}" FontSize="{StaticResource FontSizeLabel}" CharacterSpacing="140" Foreground="{ThemeResource OnTertiaryContainerBrush}" VerticalAlignment="Center" HorizontalTextAlignment="Center" />
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="FeelingPillToughTemplate">
    <Border Background="{ThemeResource SecondaryContainerBrush}" CornerRadius="8" Padding="10,5" VerticalAlignment="Center">
      <TextBlock Text="{Binding}" FontSize="{StaticResource FontSizeLabel}" CharacterSpacing="140" Foreground="{ThemeResource OnSecondaryContainerBrush}" VerticalAlignment="Center" HorizontalTextAlignment="Center" />
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="FeelingPillEasyTemplate">
    <Border Background="{ThemeResource SurfaceVariantBrush}" CornerRadius="8" Padding="10,5" VerticalAlignment="Center">
      <TextBlock Text="{Binding}" FontSize="{StaticResource FontSizeLabel}" CharacterSpacing="140" Foreground="{ThemeResource OnSurfaceVariantBrush}" VerticalAlignment="Center" HorizontalTextAlignment="Center" />
    </Border>
  </DataTemplate>
  <presentation:FeelingPillTemplateSelector x:Key="FeelingPillSelector"
                                            Great="{StaticResource FeelingPillGreatTemplate}"
                                            Good="{StaticResource FeelingPillGoodTemplate}"
                                            Tough="{StaticResource FeelingPillToughTemplate}"
                                            Easy="{StaticResource FeelingPillEasyTemplate}" />

  <!-- ══════════════════════ Shared across pages ══════════════════════ -->

  <!-- One completed workout as a result card: title, duration and calories, with the
       feeling pill on the right. Shared verbatim by HomePage's "Recent results" strip and
       ProgressPage's full history — they were byte-identical copies before this file existed. -->
  <DataTemplate x:Key="WorkoutResultTemplate">
    <Border Style="{StaticResource CardBorderStyle}" CornerRadius="14">
        <Grid Padding="16,13">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="3">
                <TextBlock Text="{Binding WorkoutTitle}"
                           FontSize="{StaticResource FontSizeSubtitle}"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1"
                           Foreground="{ThemeResource OnSurfaceBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding DurationMinutes}" FontSize="{StaticResource FontSizeCaption}" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                    <TextBlock Text="min" FontSize="{StaticResource FontSizeCaption}" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                    <TextBlock Text="&#x2022;" FontSize="{StaticResource FontSizeCaption}" Foreground="{ThemeResource OutlineVariantBrush}" />
                    <TextBlock Text="{Binding CaloriesBurned}" FontSize="{StaticResource FontSizeCaption}" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                    <TextBlock Text="kcal" FontSize="{StaticResource FontSizeCaption}" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                </StackPanel>
            </StackPanel>
            <ContentControl Grid.Column="1" Content="{Binding Feeling}" ContentTemplateSelector="{StaticResource FeelingPillSelector}" IsTabStop="False" VerticalAlignment="Center" />
        </Grid>
    </Border>
  </DataTemplate>

  <!-- ══════════════════════ HomePage ══════════════════════ -->

  <!-- A beginner tip as a card: heading plus one line of advice. -->
  <DataTemplate x:Key="QuickTipTemplate">
    <Border Style="{StaticResource CardBorderStyle}" CornerRadius="14">
        <Grid Padding="16,13">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="11" Background="{ThemeResource SecondaryContainerBrush}">
                <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="F1 M12 2.00098C16.0041 2.00098 19.25 5.24691 19.25 9.25098C19.25 11.347 18.3493 13.2707 16.5869 14.9929C16.51 15.0681 16.4504 15.1586 16.4118 15.2582L16.3804 15.3605L15.2493 20.2561C15.0266 21.22 14.2035 21.9183 13.2302 21.993L13.057 21.9996H10.9433C9.95374 21.9996 9.08791 21.3545 8.79629 20.4228L8.75088 20.2555L7.62132 15.3607C7.58904 15.2208 7.51728 15.0931 7.41456 14.9928C5.73515 13.3526 4.83778 11.5297 4.75613 9.54923L4.75 9.25098L4.75388 9.01166C4.88014 5.11837 8.07601 2.00098 12 2.00098ZM14.115 18.499H9.884L10.2125 19.9182C10.2831 20.2245 10.5357 20.4504 10.8401 20.4925L10.9433 20.4996H13.057C13.3713 20.4996 13.6481 20.3044 13.7577 20.0174L13.7878 19.9184L14.115 18.499ZM12 3.50098C8.89821 3.50098 6.37006 5.95699 6.25415 9.03042L6.25 9.25098L6.25672 9.52799C6.33286 11.0913 7.05722 12.5471 8.46262 13.9197C8.72675 14.1777 8.92265 14.496 9.03422 14.846L9.08291 15.0235L9.538 16.999H14.461L14.9189 15.0228C15.0019 14.6634 15.1718 14.3309 15.4124 14.0539L15.5386 13.9201C16.9432 12.5475 17.6672 11.0916 17.7433 9.52803L17.75 9.25098L17.7458 9.03042C17.6299 5.95699 15.1018 3.50098 12 3.50098Z"
                          Fill="{ThemeResource OnSecondaryContainerBrush}"
                          Stretch="Uniform" />
                </Viewbox>
            </Border>
            <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}"
                           FontSize="{StaticResource FontSizeBody}"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1"
                           Foreground="{ThemeResource OnSurfaceBrush}" />
                <TextBlock Text="{Binding Body}"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
  </DataTemplate>

  <!-- ══════════════════════ PlanPage ══════════════════════ -->

  <!-- One scheduled session in the week list: the type glyph (mapped through WorkoutIcon so
       cardio / core / rest / stretching each read differently), title, type and duration, and the
       difficulty pill. The whole card is a Button that opens the guided session. -->
  <DataTemplate x:Key="PlannedWorkoutTemplate">
    <!-- A real Button (focus + Invoke + 0.98 press) wrapping the hairline card. -->
    <Button Style="{StaticResource FlatButtonStyle}"
            CornerRadius="14"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            AutomationProperties.Name="Open workout session"
            uen:Navigation.Request="WorkoutSession"
            uen:Navigation.Data="{Binding}">
        <Border Style="{StaticResource CardBorderStyle}" CornerRadius="14">
            <Grid Padding="16,13">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="{ThemeResource PrimaryContainerBrush}">
                    <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="{Binding Type, Converter={StaticResource WorkoutIcon}}"
                              Fill="{ThemeResource OnPrimaryContainerBrush}"
                              Stretch="Uniform" />
                    </Viewbox>
                </Border>
                <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               FontSize="{StaticResource FontSizeSubtitle}"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1"
                               Foreground="{ThemeResource OnSurfaceBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="{Binding Type}" FontSize="{StaticResource FontSizeCaption}" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                        <TextBlock Text="&#x2022;" FontSize="{StaticResource FontSizeCaption}" Foreground="{ThemeResource OutlineVariantBrush}" />
                        <TextBlock Text="{Binding DurationMinutes}" FontSize="{StaticResource FontSizeCaption}" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                        <TextBlock Text="min" FontSize="{StaticResource FontSizeCaption}" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="3" Background="{ThemeResource TertiaryContainerBrush}" CornerRadius="8" Padding="10,5" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Difficulty}"
                               FontSize="{StaticResource FontSizeLabel}"
                               CharacterSpacing="140"
                               Foreground="{ThemeResource OnTertiaryContainerBrush}" />
                </Border>
            </Grid>
        </Border>
    </Button>
  </DataTemplate>

  <!-- A suggested programme as a card: name, description, and its days/minutes/focus summary. -->
  <DataTemplate x:Key="SuggestedPlanTemplate">
    <Border Style="{StaticResource CardBorderStyle}">
        <Grid Padding="18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Name}"
                           FontSize="{StaticResource FontSizeTitle}"
                           Foreground="{ThemeResource OnSurfaceBrush}"
                           VerticalAlignment="Center" />
                <Border Background="{ThemeResource SecondaryContainerBrush}" CornerRadius="8" Padding="9,4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Focus}"
                               FontSize="{StaticResource FontSizeLabel}"
                               CharacterSpacing="140"
                               Foreground="{ThemeResource OnSecondaryContainerBrush}" />
                </Border>
            </StackPanel>
            <TextBlock Grid.Row="1"
                       Text="{Binding Description}"
                       FontSize="{StaticResource FontSizeCaption}"
                       Foreground="{ThemeResource OnSurfaceVariantBrush}"
                       TextWrapping="Wrap"
                       Margin="0,7,0,10" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="24">
                <StackPanel Spacing="1">
                    <TextBlock Text="{Binding DaysPerWeek}" FontSize="{StaticResource FontSizeTitle}" Foreground="{ThemeResource PrimaryBrush}" />
                    <TextBlock Text="DAYS/WEEK" FontSize="{StaticResource FontSizeLabel}" CharacterSpacing="140" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                </StackPanel>
                <StackPanel Spacing="1">
                    <TextBlock Text="{Binding MinutesPerSession}" FontSize="{StaticResource FontSizeTitle}" Foreground="{ThemeResource PrimaryBrush}" />
                    <TextBlock Text="MIN/SESSION" FontSize="{StaticResource FontSizeLabel}" CharacterSpacing="140" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
  </DataTemplate>

  <!-- ══════════════════════ ProfilePage ══════════════════════ -->

  <!-- A selectable fitness goal; the chosen one reads as selected via its IsSelected flag. -->
  <DataTemplate x:Key="FitnessGoalTemplate">
    <Border Style="{StaticResource CardBorderStyle}" CornerRadius="14">
        <Grid Padding="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="{ThemeResource SecondaryContainerBrush}">
                <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="F1 M11.9982 14.0002C13.1027 14.0002 13.9982 13.1047 13.9982 12.0002C13.9982 10.8956 13.1027 10.0002 11.9982 10.0002C10.8936 10.0002 9.99817 10.8956 9.99817 12.0002C9.99817 13.1047 10.8936 14.0002 11.9982 14.0002ZM5.99817 12.0002C5.99817 8.68644 8.68446 6.00015 11.9982 6.00015C15.3119 6.00015 17.9982 8.68644 17.9982 12.0002C17.9982 15.3139 15.3119 18.0002 11.9982 18.0002C8.68446 18.0002 5.99817 15.3139 5.99817 12.0002ZM11.9982 7.50015C9.51289 7.50015 7.49817 9.51487 7.49817 12.0002C7.49817 14.4854 9.51289 16.5002 11.9982 16.5002C14.4834 16.5002 16.4982 14.4854 16.4982 12.0002C16.4982 9.51487 14.4834 7.50015 11.9982 7.50015ZM1.99609 12.0001C1.99609 6.47614 6.47419 1.99805 11.9982 1.99805C17.5222 1.99805 22.0003 6.47614 22.0003 12.0001C22.0003 17.5242 17.5222 22.0022 11.9982 22.0022C6.47419 22.0022 1.99609 17.5242 1.99609 12.0001ZM11.9982 3.49805C7.30261 3.49805 3.49609 7.30457 3.49609 12.0001C3.49609 16.6957 7.30261 20.5022 11.9982 20.5022C16.6938 20.5022 20.5003 16.6957 20.5003 12.0001C20.5003 7.30457 16.6938 3.49805 11.9982 3.49805Z"
                          Fill="{ThemeResource OnSecondaryContainerBrush}"
                          Stretch="Uniform" />
                </Viewbox>
            </Border>
            <TextBlock Grid.Column="2" Text="{Binding Label}"
                       FontSize="{StaticResource FontSizeSubtitle}"
                       Foreground="{ThemeResource OnSurfaceBrush}"
                       VerticalAlignment="Center" />
            <!-- "Active" pill on the currently-selected goal (bool + BoolToVisibility) -->
            <Border Grid.Column="3" Background="{ThemeResource PrimaryBrush}" CornerRadius="8" Padding="10,4" VerticalAlignment="Center"
                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Active"
                           FontSize="{StaticResource FontSizeLabel}"
                           CharacterSpacing="140"
                           Foreground="{ThemeResource OnPrimaryBrush}"
                           VerticalAlignment="Center"
                           HorizontalTextAlignment="Center" />
            </Border>
        </Grid>
    </Border>
  </DataTemplate>

  <!-- One settings row: label on the left, current value on the right. -->
  <DataTemplate x:Key="SettingRowTemplate">
    <Grid Padding="16,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Label}"
                   FontSize="{StaticResource FontSizeBody}"
                   Foreground="{ThemeResource OnSurfaceBrush}"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Value}"
                   FontSize="{StaticResource FontSizeCaption}"
                   Foreground="{ThemeResource OnSurfaceVariantBrush}"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0" />
        <Viewbox Grid.Column="2" Width="16" Height="16" VerticalAlignment="Center">
            <Path Data="F1 M8.46967 4.21967C8.17678 4.51256 8.17678 4.98744 8.46967 5.28033L15.1893 12L8.46967 18.7197C8.17678 19.0126 8.17678 19.4874 8.46967 19.7803C8.76256 20.0732 9.23744 20.0732 9.53033 19.7803L16.7803 12.5303C17.0732 12.2374 17.0732 11.7626 16.7803 11.4697L9.53033 4.21967C9.23744 3.92678 8.76256 3.92678 8.46967 4.21967Z"
                  Fill="{ThemeResource OutlineBrush}"
                  Stretch="Uniform" />
        </Viewbox>
    </Grid>
  </DataTemplate>

  <!-- ══════════════════════ ProgressPage ══════════════════════ -->

  <!-- An achievement badge. The card itself is identical in both states — only the trailing pill
       swaps, from an accented "Done" to a muted "Locked", via two Borders toggled on IsUnlocked. -->
  <DataTemplate x:Key="MilestoneBadgeTemplate">
    <Border Style="{StaticResource CardBorderStyle}" CornerRadius="14">
        <Grid Padding="16,13">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="{ThemeResource PrimaryContainerBrush}">
                <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="F1 M15.2536 2C16.4119 2 17.3657 2.87524 17.4899 4.00044L18.7576 4C19.6758 4 20.4288 4.70711 20.5018 5.60647L20.5076 5.75V8.75C20.5076 10.483 19.1512 11.8992 17.4421 11.9949L17.2318 12.0007C16.564 14.0909 14.7334 15.6615 12.5007 15.9517L12.5001 17.5H14.2536C15.9866 17.5 17.4028 18.8565 17.4984 20.5656L17.5036 20.75V21.25C17.5036 21.6297 17.2214 21.9435 16.8554 21.9932L16.7536 22H6.75056C6.37086 22 6.05707 21.7178 6.00741 21.3518L6.00056 21.25V20.75C6.00056 19.017 7.35702 17.6008 9.06614 17.5051L9.25056 17.5H11.0001L11.0004 15.9513C8.76915 15.6601 6.93987 14.09 6.27235 12.0007L6.24609 12C4.45117 12 2.99609 10.5449 2.99609 8.75V5.75C2.99609 4.7835 3.7796 4 4.74609 4L6.01424 4.00044C6.13841 2.87524 7.09227 2 8.25056 2H15.2536ZM14.2536 19H9.25056C8.4208 19 7.72592 19.5775 7.54591 20.3525L7.51828 20.5H15.9859C15.8717 19.7018 15.2189 19.0774 14.4075 19.0067L14.2536 19ZM15.2536 3.5H8.25056C7.83635 3.5 7.50056 3.83579 7.50056 4.25V10.2485C7.50056 12.5965 9.40403 14.5 11.7521 14.5C14.1001 14.5 16.0036 12.5965 16.0036 10.2485V4.25C16.0036 3.83579 15.6678 3.5 15.2536 3.5ZM18.7576 5.5H17.5036V10.4829C18.3036 10.3703 18.93 9.71683 19.0009 8.90415L19.0076 8.75V5.75C19.0076 5.63165 18.9254 5.53251 18.815 5.5066L18.7576 5.5ZM6.00056 5.5H4.74609C4.60802 5.5 4.49609 5.61193 4.49609 5.75V8.75C4.49609 9.63317 5.15031 10.3635 6.00056 10.4829V5.5Z"
                          Fill="{ThemeResource OnPrimaryContainerBrush}"
                          Stretch="Uniform" />
                </Viewbox>
            </Border>
            <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}"
                           FontSize="{StaticResource FontSizeSubtitle}"
                           Foreground="{ThemeResource OnSurfaceBrush}"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1" />
                <TextBlock Text="{Binding Description}"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="3" Background="{ThemeResource PrimaryBrush}" CornerRadius="8" Padding="10,5" VerticalAlignment="Center"
                    Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Done"
                           FontSize="{StaticResource FontSizeLabel}"
                           CharacterSpacing="140"
                           Foreground="{ThemeResource OnPrimaryBrush}"
                           VerticalAlignment="Center"
                           HorizontalTextAlignment="Center" />
            </Border>
            <Border Grid.Column="3" Background="{ThemeResource SurfaceVariantBrush}" CornerRadius="8" Padding="10,5" VerticalAlignment="Center"
                    Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                <TextBlock Text="Locked"
                           FontSize="{StaticResource FontSizeLabel}"
                           CharacterSpacing="140"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}"
                           VerticalAlignment="Center"
                           HorizontalTextAlignment="Center" />
            </Border>
        </Grid>
    </Border>
  </DataTemplate>

  <!-- ══════════════════════ WorkoutSessionPage ══════════════════════ -->

  <!-- One exercise in the guided session: category glyph, name, sets/reps/duration and
       the how-to description. -->
  <DataTemplate x:Key="ExerciseTemplate">
    <Border Style="{StaticResource CardBorderStyle}">
        <StackPanel Padding="16,14"
                    Spacing="10">
            <StackPanel Orientation="Horizontal"
                        Spacing="12">
                <Border Width="44" Height="44"
                        CornerRadius="12"
                        Background="{ThemeResource PrimaryContainerBrush}">
                    <Viewbox Width="20" Height="20"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center">
                        <Path Data="{Binding Category, Converter={StaticResource WorkoutIcon}}"
                              Fill="{ThemeResource OnPrimaryContainerBrush}"
                              Stretch="Uniform" />
                    </Viewbox>
                </Border>
                <StackPanel Spacing="2"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               FontSize="{StaticResource FontSizeSubtitle}"
                               Foreground="{ThemeResource OnSurfaceBrush}" />
                    <TextBlock Text="{Binding Category}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                </StackPanel>
            </StackPanel>
            <TextBlock Text="{Binding Description}"
                       FontSize="{StaticResource FontSizeCaption}"
                       Foreground="{ThemeResource OnSurfaceVariantBrush}"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal"
                        Spacing="12">
                <Border Background="{ThemeResource TertiaryContainerBrush}"
                        CornerRadius="8"
                        Padding="10,4">
                    <StackPanel Orientation="Horizontal"
                                Spacing="4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding Sets}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{ThemeResource OnTertiaryContainerBrush}"
                                   HorizontalTextAlignment="Center" />
                        <TextBlock Text="SETS"
                                   FontSize="{StaticResource FontSizeLabel}"
                                   CharacterSpacing="140"
                                   Foreground="{ThemeResource OnTertiaryContainerBrush}"
                                   HorizontalTextAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Background="{ThemeResource SecondaryContainerBrush}"
                        CornerRadius="8"
                        Padding="10,4">
                    <StackPanel Orientation="Horizontal"
                                Spacing="4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding DurationSeconds}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{ThemeResource OnSecondaryContainerBrush}"
                                   HorizontalTextAlignment="Center" />
                        <TextBlock Text="SEC"
                                   FontSize="{StaticResource FontSizeLabel}"
                                   CharacterSpacing="140"
                                   Foreground="{ThemeResource OnSecondaryContainerBrush}"
                                   HorizontalTextAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
  </DataTemplate>

  <!-- A single form/technique note in the session's tips card. -->
  <DataTemplate x:Key="SessionTipTemplate">
    <!-- A Grid, NOT a horizontal StackPanel: a StackPanel measures its children with unbounded
         width on the stacking axis, so TextWrapping never engages and a long note is clipped at
         the card edge. The star column gives the note a real width to wrap in. -->
    <Grid Margin="0,4" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0"
                   Text="&#x2022;"
                   FontSize="{StaticResource FontSizeBody}"
                   Foreground="{ThemeResource PrimaryBrush}"
                   VerticalAlignment="Top" />
        <TextBlock Grid.Column="1"
                   Text="{Binding Note}"
                   FontSize="{StaticResource FontSizeCaption}"
                   Foreground="{ThemeResource OnSurfaceBrush}"
                   TextWrapping="Wrap" />
    </Grid>
  </DataTemplate>

</ResourceDictionary>
