<hd:PreviewGroup x:Class="FitBeginnerApp.Previews.ProfilePreviews"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="using:FitBeginnerApp.Presentation"
                 xmlns:mock="using:FitBeginnerApp.Presentation.MockData"
                 xmlns:hd="using:Uno.UI.HotDesign"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d">

    <!-- ProfilePage for an established member, and for a brand-new one with no goal chosen — the only
         way to see the goals list without an "Active" pill.
         Each child supplies the page's design-time DataContext in XAML — the only safe place for the
         generated-ViewModel mock, which must never be seeded from the page constructor. No size on
         the <hd:Preview>: a page fills the canvas / device frame. -->
    <hd:Preview PreviewName="Established" Visibility="Collapsed">
        <local:ProfilePage DataContext="{x:Bind mock:ProfilePageMockData.Data}" />
    </hd:Preview>

    <hd:Preview PreviewName="New Member" Visibility="Collapsed">
        <local:ProfilePage DataContext="{x:Bind mock:ProfilePageMockData.NewMember}" />
    </hd:Preview>

</hd:PreviewGroup>
