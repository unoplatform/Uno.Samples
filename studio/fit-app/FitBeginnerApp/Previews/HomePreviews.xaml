<hd:PreviewGroup x:Class="FitBeginnerApp.Previews.HomePreviews"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="using:FitBeginnerApp.Presentation"
                 xmlns:mock="using:FitBeginnerApp.Presentation.MockData"
                 xmlns:hd="using:Uno.UI.HotDesign"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d">

    <!-- HomePage across the states its data can be in: an active week, day one (the ring at zero and
         the results strip on its empty state), and a completed weekly goal.
         Each child supplies the page's design-time DataContext in XAML — the only safe place for the
         generated-ViewModel mock, which must never be seeded from the page constructor. No size on
         the <hd:Preview>: a page fills the canvas / device frame. -->
    <hd:Preview PreviewName="Active Week" Visibility="Collapsed">
        <local:HomePage DataContext="{x:Bind mock:HomePageMockData.Data}" />
    </hd:Preview>

    <hd:Preview PreviewName="First Day" Visibility="Collapsed">
        <local:HomePage DataContext="{x:Bind mock:HomePageMockData.FirstDay}" />
    </hd:Preview>

    <hd:Preview PreviewName="Goal Met" Visibility="Collapsed">
        <local:HomePage DataContext="{x:Bind mock:HomePageMockData.GoalMet}" />
    </hd:Preview>

</hd:PreviewGroup>
