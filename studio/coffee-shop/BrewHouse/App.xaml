<Application x:Class="BrewHouse.App"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:utus="using:Uno.Toolkit.UI.Simple"
       xmlns:ut="using:Uno.Themes">

  <!-- App.xaml is a thin manifest: it only merges the dedicated dictionaries, each with one
       concern. The visual vocabulary (styles, templates, brushes, tokens) lives in Styles.xaml;
       the item/content templates in DataTemplates.xaml; built-in control key overrides in
       ControlThemeOverrides.xaml. The palette is not hand-authored: three seed colours below
       generate every semantic role for both light and dark. See lesson 56. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Load WinUI resources -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <!--
          The warm BrewHouse palette, generated from three seeds. SeedColorMode defaults to
          Fidelity, so PrimaryColor in light mode is the espresso below verbatim and dark mode
          brightens it. DefaultCornerRadius and DefaultSpacing are left at their defaults (4):
          that already yields the radius ramp 8/12/16 and the spacing rhythm 4/8/12/16/24 this
          app was hand-authoring.
        -->
        <utus:SimpleToolkitTheme>
          <utus:SimpleToolkitTheme.Colors>
            <ut:ThemeColors PrimarySeed="#4A2810"
                            SecondarySeed="#8C5A28"
                            TertiarySeed="#6F4A2A"
                            OverrideSource="ms-appx:///ColorOverrides.xaml" />
          </utus:SimpleToolkitTheme.Colors>
        </utus:SimpleToolkitTheme>
        <!-- Merged after the Simple theme so its ThemeDictionaries win: pins the wide NavigationView
             pane's selection indicator to the warm palette (the bottom TabBar deliberately uses the
             Simple defaults — see ControlThemeOverrides.xaml). -->
        <ResourceDictionary Source="ms-appx:///ControlThemeOverrides.xaml" />
        <!-- App styling vocabulary. Merged after the theme so its WinUI-key aliases
             (ControlCornerRadius, OverlayCornerRadius) resolve against the generated Radius scale. -->
        <ResourceDictionary Source="ms-appx:///Styles.xaml" />
        <!-- Every shared item/content template, keyed. Merged LAST: the templates consume the
             styles, tokens and converters above by key, and being app-merged is what makes each
             one a standalone design-time surface. -->
        <ResourceDictionary Source="ms-appx:///DataTemplates.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>
