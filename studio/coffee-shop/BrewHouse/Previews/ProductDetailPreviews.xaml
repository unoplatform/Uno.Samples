<hd:PreviewGroup x:Class="BrewHouse.Previews.ProductDetailPreviews"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="using:BrewHouse.Presentation"
                 xmlns:mock="using:BrewHouse.Presentation.MockData"
                 xmlns:hd="using:Uno.UI.HotDesign"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d">

    <!-- ProductDetailPage: a "Today's Special" product (badge shown) vs. a standard one (badge hidden). -->
    <hd:Preview PreviewName="Today's Special" Visibility="Collapsed">
        <local:ProductDetailPage DataContext="{x:Bind mock:ProductDetailPageMockData.Data}" />
    </hd:Preview>

    <hd:Preview PreviewName="Standard" Visibility="Collapsed">
        <local:ProductDetailPage DataContext="{x:Bind mock:ProductDetailPageMockData.Standard}" />
    </hd:Preview>
</hd:PreviewGroup>
