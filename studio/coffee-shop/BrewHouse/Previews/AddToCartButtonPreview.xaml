<hd:Preview x:Class="BrewHouse.Previews.AddToCartButtonPreview"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:hd="using:Uno.UI.HotDesign"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            mc:Ignorable="d"
            Width="260"
            Height="120">

    <!-- A single control in isolation. styleKey on the [Preview] groups it under the BrewButtonStyle
         node in the Previews tree; the same key is applied here so it renders the branded style. -->
    <Button Content="+ Add to Cart"
            Style="{StaticResource BrewButtonStyle}"
            CornerRadius="8"
            Padding="10,4"
            FontSize="11"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />
</hd:Preview>
