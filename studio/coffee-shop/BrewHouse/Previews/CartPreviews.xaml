<hd:PreviewGroup x:Class="BrewHouse.Previews.CartPreviews"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="using:BrewHouse.Presentation"
                 xmlns:mock="using:BrewHouse.Presentation.MockData"
                 xmlns:hd="using:Uno.UI.HotDesign"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d">

    <!-- CartPage populated vs. empty. The page's third visual state — the "Your order has been
         placed!" toast — is driven from the code-behind by x:Name (not by model state), so no
         DataContext can reveal it and it is deliberately out of preview scope. -->
    <hd:Preview PreviewName="Items" Visibility="Collapsed">
        <local:CartPage DataContext="{x:Bind mock:CartPageMockData.Data}" />
    </hd:Preview>

    <hd:Preview PreviewName="Empty" Visibility="Collapsed">
        <local:CartPage DataContext="{x:Bind mock:CartPageMockData.Empty}" />
    </hd:Preview>
</hd:PreviewGroup>
