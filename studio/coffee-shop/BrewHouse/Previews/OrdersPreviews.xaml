<hd:PreviewGroup x:Class="BrewHouse.Previews.OrdersPreviews"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="using:BrewHouse.Presentation"
                 xmlns:mock="using:BrewHouse.Presentation.MockData"
                 xmlns:hd="using:Uno.UI.HotDesign"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d">

    <!-- OrdersPage with a seed history vs. empty. -->
    <hd:Preview PreviewName="History" Visibility="Collapsed">
        <local:OrdersPage DataContext="{x:Bind mock:OrdersPageMockData.Data}" />
    </hd:Preview>

    <hd:Preview PreviewName="Empty" Visibility="Collapsed">
        <local:OrdersPage DataContext="{x:Bind mock:OrdersPageMockData.Empty}" />
    </hd:Preview>
</hd:PreviewGroup>
