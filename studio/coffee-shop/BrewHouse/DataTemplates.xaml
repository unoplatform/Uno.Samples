<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utu="using:Uno.Toolkit.UI">

  <!--
    Every item/content template in BrewHouse, keyed and shared here rather than declared inline in
    the page that happens to use it. Two reasons: a keyed template in an app-merged dictionary is a
    standalone design-time surface (it can be previewed and edited on its own instead of only as
    part of its page), and a template inflated outside its page — by a preview, or by a second page
    — can still resolve its {StaticResource}s, which an inline page resource cannot.

    Merged into App.xaml AFTER Styles.xaml, so these templates consume that file's styles, tokens,
    brushes and converters by key. A template that depends on another key here is declared after it.

    Item templates reach their page Model with {utu:AncestorBinding AncestorType=Page,
    Path=DataContext.X} — never through ElementName, whose page namescope a dictionary template
    cannot see, and deliberately NOT through the item host (ItemsControlBinding / AncestorType=
    ItemsRepeater). Several of these templates are inflated inside a FeedView, where the host's
    DataContext is the FeedViewState wrapper rather than the page Model, so a host-relative lookup
    would silently resolve to nothing. The Page is the one ancestor whose DataContext is the Model
    in every case. In an isolated component preview there is no Page above the template, so the
    commands are simply inert — expected.
  -->

  <!-- ══════════════════════ Shared across pages ══════════════════════ -->

  <!-- Product card, bound to a ProductItem. Used by the Menu grid (MenuPage) and by the Hot Design
       product-card previews. The whole card is a focusable button that opens the product detail
       page; the inner "+ Add to Cart" is a nested button. Both commands reach the page Model via
       the Page ancestor (see the file header) — this template is inflated inside the Menu's
       FeedView, where the ItemsRepeater's own DataContext is the FeedViewState. -->
  <DataTemplate x:Key="ProductCardTemplate">
    <Button Style="{StaticResource FlatButtonStyle}"
            CornerRadius="16"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            AutomationProperties.Name="{Binding Name}"
            Command="{utu:AncestorBinding AncestorType=Page, Path=DataContext.ViewProduct}"
            CommandParameter="{Binding}">
      <Border Background="{ThemeResource SurfaceBrush}"
              CornerRadius="16"
              BorderBrush="{ThemeResource BrewCardBorderBrush}"
              BorderThickness="1"
              VerticalAlignment="Stretch">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>

          <!-- Product image: fills the card height; corners match the card -->
          <Border Grid.Column="0" CornerRadius="16,0,0,16">
            <Border.Background>
              <ImageBrush ImageSource="{Binding ImageUrl}" Stretch="UniformToFill" />
            </Border.Background>
          </Border>

          <!-- Product Info -->
          <StackPanel Grid.Column="1" Padding="12,8" Spacing="2" VerticalAlignment="Center">

            <!-- Name + right-aligned "Today's Special" badge on one row, so the badge never adds
                 height and every tile stays the same height -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0"
                         Text="{Binding Name}"
                         FontSize="16"
                         FontWeight="SemiBold"
                         Foreground="{ThemeResource OnSurfaceBrush}"
                         TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />
              <Border Grid.Column="1"
                      Background="{ThemeResource SurfaceVariantBrush}"
                      CornerRadius="6"
                      Padding="6,2"
                      Margin="8,0,0,0"
                      VerticalAlignment="Center"
                      Visibility="{Binding IsSpecial, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Today's Special"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource SecondaryBrush}" />
              </Border>
            </Grid>

            <TextBlock Text="{Binding Description}"
                       FontSize="12"
                       Foreground="{ThemeResource OnSurfaceVariantBrush}"
                       TextWrapping="Wrap"
                       MaxLines="1"
                       TextTrimming="CharacterEllipsis" />

            <Grid Margin="0,4,0,0" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" FontSize="17" FontWeight="Bold"
                         Foreground="{ThemeResource SecondaryBrush}" VerticalAlignment="Center">
                <Run Text="$" /><Run Text="{Binding Price}" />
              </TextBlock>
              <Button Grid.Column="1"
                      Style="{StaticResource BrewButtonStyle}"
                      Content="+ Add to Cart"
                      AutomationProperties.Name="Add to cart"
                      CornerRadius="8"
                      Padding="10,4"
                      FontSize="11"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Command="{utu:AncestorBinding AncestorType=Page, Path=DataContext.AddToCart}"
                      CommandParameter="{Binding}" />
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
    </Button>
  </DataTemplate>

  <!-- Order status badge, bound to an OrderRecord. Shared by the Orders list (OrdersPage) and the
       Hot Design status-badge previews. Three visibility-toggled coloured pills (one per status);
       the pill background carries the status colour and re-themes via {ThemeResource}. -->
  <DataTemplate x:Key="OrderStatusBadgeTemplate">
    <Grid VerticalAlignment="Center">
      <Border Background="{ThemeResource BrewStatusReadyContainerBrush}"
              CornerRadius="6"
              Padding="10,5"
              VerticalAlignment="Center"
              Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding Status}"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="{ThemeResource BrewStatusReadyOnContainerBrush}"
                   VerticalAlignment="Center" />
      </Border>
      <Border Background="{ThemeResource BrewStatusPreparingContainerBrush}"
              CornerRadius="6"
              Padding="10,5"
              VerticalAlignment="Center"
              Visibility="{Binding IsPreparing, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding Status}"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="{ThemeResource BrewStatusPreparingOnContainerBrush}"
                   VerticalAlignment="Center" />
      </Border>
      <Border Background="{ThemeResource BrewStatusCompletedContainerBrush}"
              CornerRadius="6"
              Padding="10,5"
              VerticalAlignment="Center"
              Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding Status}"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="{ThemeResource BrewStatusCompletedOnContainerBrush}"
                   VerticalAlignment="Center" />
      </Border>
    </Grid>
  </DataTemplate>

  <!-- ══════════════════════ HomePage ══════════════════════ -->

  <!-- One hero slide: photo, dark scrim, caption and an "Order Now" button that jumps to
       the Menu. Hosted by the HomePage FlipView. -->
  <DataTemplate x:Key="HeroBannerTemplate">
    <Grid>
        <!-- Decorative: the caption + carousel name carry the meaning -->
        <Image Source="{Binding ImageUrl}"
               Stretch="UniformToFill"
               AutomationProperties.AccessibilityView="Raw" />
        <!-- Dark scrim keeps the white caption legible over any photo -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00140800" Offset="0.0" />
                    <GradientStop Color="#40140800" Offset="0.45" />
                    <GradientStop Color="#F0140800" Offset="1.0" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <StackPanel VerticalAlignment="Bottom"
                    Padding="24,0,24,32"
                    Spacing="6">
            <TextBlock Text="{Binding Title}"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="White"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding Subtitle}"
                       FontSize="13"
                       Foreground="White"
                       TextWrapping="Wrap" />
            <Button Style="{StaticResource BrewButtonStyle}"
                    Content="Order Now"
                    AutomationProperties.Name="Order Now"
                    CornerRadius="12"
                    Padding="20,10"
                    FontSize="14"
                    HorizontalAlignment="Left"
                    Margin="0,6,0,0"
                    Command="{utu:AncestorBinding AncestorType=Page, Path=DataContext.OrderNow}" />
        </StackPanel>
    </Grid>
  </DataTemplate>

  <!-- A "Today's Special" as a narrow portrait card for the Home carousel row: banner
       image over name, price and an inline add-to-cart. The card itself opens the product. -->
  <DataTemplate x:Key="SpecialProductCardTemplate">
    <!-- Card is a focusable button -> product detail -->
    <Button Style="{StaticResource FlatButtonStyle}"
            CornerRadius="16"
            AutomationProperties.Name="{Binding Name}"
            Command="{utu:AncestorBinding AncestorType=Page, Path=DataContext.ViewProduct}"
            CommandParameter="{Binding}">
        <Border Width="158"
                Background="{ThemeResource SurfaceBrush}"
                CornerRadius="16"
                BorderBrush="{ThemeResource BrewCardBorderBrush}"
                BorderThickness="1">
            <StackPanel Spacing="0">
                <!-- Banner image; top corners match the card -->
                <Border CornerRadius="16,16,0,0"
                        Height="112">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding ImageUrl}"
                                    Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <StackPanel Padding="10,10,10,12" Spacing="4">
                    <TextBlock Text="{Binding Name}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource OnSurfaceBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock FontSize="13"
                               FontWeight="Bold"
                               Foreground="{ThemeResource SecondaryBrush}">
                        <Run Text="$" />
                        <Run Text="{Binding Price}" />
                    </TextBlock>
                    <Button Style="{StaticResource BrewButtonStyle}"
                            Content="+ Add to Cart"
                            AutomationProperties.Name="Add special to cart"
                            CornerRadius="8"
                            Padding="0,5"
                            FontSize="11"
                            HorizontalAlignment="Stretch"
                            Margin="0,4,0,0"
                            Command="{utu:AncestorBinding AncestorType=Page, Path=DataContext.AddToCart}"
                            CommandParameter="{Binding}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Button>
  </DataTemplate>

  <!-- A category as a plain pill shortcut on Home — tapping any of them jumps to the full
       Menu (unlike the Menu's own chips, this one carries no selected state). -->
  <DataTemplate x:Key="CategoryShortcutTemplate">
    <!-- Tap a category to jump to the full Menu -->
    <Button Style="{StaticResource FlatButtonStyle}"
            CornerRadius="12"
            AutomationProperties.Name="{Binding Name}"
            Command="{utu:AncestorBinding AncestorType=Page, Path=DataContext.GoToMenu}">
        <Border Background="{ThemeResource SurfaceVariantBrush}"
                CornerRadius="12"
                Padding="16,8">
            <TextBlock Text="{Binding Name}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource OnSurfaceVariantBrush}"
                       VerticalAlignment="Center" />
        </Border>
    </Button>
  </DataTemplate>

  <!-- A featured product as a wide landscape card for the Home grid: image beside name,
       description, price and a compact "+ Add". Hosted by an ItemsRepeater, so its commands use
       {utu:AncestorBinding}. Deliberately kept separate from ProductCardTemplate: the Menu card
       is wider, carries the "Today's Special" badge and spells out "+ Add to Cart". -->
  <DataTemplate x:Key="FeaturedProductCardTemplate">
    <!-- Card is a focusable button -> product detail; inner "+ Add" is its own button -->
    <Button Style="{StaticResource FlatButtonStyle}"
            CornerRadius="16"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            AutomationProperties.Name="{Binding Name}"
            Command="{utu:AncestorBinding AncestorType=Page, Path=DataContext.ViewProduct}"
            CommandParameter="{Binding}">
        <Border Background="{ThemeResource SurfaceBrush}"
                CornerRadius="16"
                BorderBrush="{ThemeResource BrewCardBorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <!-- Image fills the card height; corners match the card -->
                <Border Grid.Column="0"
                        CornerRadius="16,0,0,16">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding ImageUrl}"
                                    Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <StackPanel Grid.Column="1"
                            Padding="12,8"
                            Spacing="2"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource OnSurfaceBrush}" />
                    <TextBlock Text="{Binding Description}"
                               FontSize="12"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}"
                               TextWrapping="Wrap"
                               MaxLines="1"
                               TextTrimming="CharacterEllipsis" />
                    <Grid Margin="0,4,0,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontSize="17" FontWeight="Bold"
                                   Foreground="{ThemeResource SecondaryBrush}" VerticalAlignment="Center">
                            <Run Text="$" /><Run Text="{Binding Price}" />
                        </TextBlock>
                        <Button Grid.Column="1"
                                Style="{StaticResource BrewButtonStyle}"
                                Content="+ Add"
                                AutomationProperties.Name="Add product to cart"
                                CornerRadius="8"
                                Padding="10,4"
                                FontSize="11"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Command="{utu:AncestorBinding AncestorType=Page, Path=DataContext.AddToCart}"
                                CommandParameter="{Binding}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Button>
  </DataTemplate>

  <!-- ══════════════════════ MenuPage ══════════════════════ -->

  <!-- A category as a filter chip: two stacked pills, the accented one revealed by the
       item's IsSelected, so the active category reads at a glance. Tapping it sets the filter. -->
  <DataTemplate x:Key="CategoryFilterChipTemplate">
    <Button Style="{StaticResource FlatButtonStyle}"
            CornerRadius="12"
            AutomationProperties.Name="{Binding Name}"
            Command="{utu:AncestorBinding AncestorType=Page, Path=DataContext.FilterByCategory}"
            CommandParameter="{Binding Id}">
        <Grid>
            <!-- unselected pill -->
            <Border Background="{ThemeResource SurfaceVariantBrush}"
                    CornerRadius="12"
                    Padding="16,8">
                <TextBlock Text="{Binding Name}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}" />
            </Border>
            <!-- selected pill overlays when this category is active -->
            <Border Background="{ThemeResource PrimaryBrush}"
                    CornerRadius="12"
                    Padding="16,8"
                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Name}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource OnPrimaryBrush}" />
            </Border>
        </Grid>
    </Button>
  </DataTemplate>

  <!-- ══════════════════════ CartPage ══════════════════════ -->

  <!-- One cart line: thumbnail, name, unit and line price, and the quantity stepper. The
       +/- commands live on the page Model and are reached through the hosting ItemsControl. -->
  <DataTemplate x:Key="CartLineItemTemplate">
    <Border Background="{ThemeResource SurfaceBrush}"
            CornerRadius="16"
            Padding="12"
            BorderBrush="{ThemeResource BrewCardBorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Product Image -->
            <Border Grid.Column="0"
                    CornerRadius="10"
                    Width="72"
                    Height="72">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding ImageUrl}"
                                Stretch="UniformToFill" />
                </Border.Background>
            </Border>

            <!-- Product Info -->
            <StackPanel Grid.Column="1"
                        Padding="12,4,8,4"
                        Spacing="4"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource OnSurfaceBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock FontSize="13"
                           Foreground="{ThemeResource SecondaryBrush}"
                           FontWeight="SemiBold">
                    <Run Text="$" />
                    <Run Text="{Binding PriceFormatted}" />
                </TextBlock>
                <TextBlock FontSize="12"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}">
                    <Run Text="Line total: $" />
                    <Run Text="{Binding LineTotalFormatted}" />
                </TextBlock>
            </StackPanel>

            <!-- Quantity stepper: BrewButtonStyle at 28px (MinWidth/MinHeight zeroed so the theme minimum
                 can't inflate it); crisp rounded fill + foreground state layer for hover/pressed. The +/-
                 glyphs are centred Rectangles — explicit size + Center alignment = pixel-perfect, with no
                 text-baseline or PathIcon bounds offset. -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6" HorizontalAlignment="Center">
                <Button Style="{StaticResource BrewButtonStyle}"
                        AutomationProperties.Name="Increase quantity"
                        Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" CornerRadius="6"
                        Command="{utu:AncestorBinding AncestorType=Page, Path=DataContext.Increment}"
                        CommandParameter="{Binding}">
                    <Grid>
                        <Rectangle Width="12" Height="2" RadiusX="1" RadiusY="1" Fill="{ThemeResource OnPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Rectangle Width="2" Height="12" RadiusX="1" RadiusY="1" Fill="{ThemeResource OnPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Button>
                <TextBlock Text="{Binding Quantity}" FontSize="16" FontWeight="Bold"
                           Foreground="{ThemeResource OnSurfaceBrush}" HorizontalAlignment="Center" />
                <Button Style="{StaticResource BrewButtonStyle}"
                        AutomationProperties.Name="Decrease quantity"
                        Background="{ThemeResource SurfaceVariantBrush}"
                        Foreground="{ThemeResource OnSurfaceVariantBrush}"
                        Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" CornerRadius="6"
                        Command="{utu:AncestorBinding AncestorType=Page, Path=DataContext.Decrement}"
                        CommandParameter="{Binding}">
                    <Rectangle Width="12" Height="2" RadiusX="1" RadiusY="1" Fill="{ThemeResource OnSurfaceVariantBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
  </DataTemplate>

  <!-- A "popular choice" suggestion pill in the empty-cart hero; every one of them opens
       the Menu. -->
  <DataTemplate x:Key="PopularChoiceTemplate">
    <Button Style="{StaticResource FlatButtonStyle}"
            CornerRadius="12"
            AutomationProperties.Name="{Binding}"
            Command="{utu:AncestorBinding AncestorType=Page, Path=DataContext.GoToMenu}">
        <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="12" Padding="12,6">
            <TextBlock Text="{Binding}" FontSize="13" Foreground="{ThemeResource OnSurfaceBrush}" />
        </Border>
    </Button>
  </DataTemplate>

  <!-- ══════════════════════ OrdersPage ══════════════════════ -->

  <!-- One order in the history: id and placed-at beside the status badge
       (OrderStatusBadgeTemplate above), then the item summary and the order total. -->
  <DataTemplate x:Key="OrderCardTemplate">
    <Border Background="{ThemeResource SurfaceBrush}"
            CornerRadius="16"
            Padding="16"
            BorderBrush="{ThemeResource BrewCardBorderBrush}"
            BorderThickness="1"
            HorizontalAlignment="Stretch">
        <StackPanel Spacing="12">

            <!-- Order Header Row -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding Id}"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{ThemeResource OnSurfaceBrush}" />
                    <TextBlock Text="{Binding PlacedAt}"
                               FontSize="12"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                </StackPanel>

                <!-- Status badge: three visibility-toggled coloured pills, one per
                     status. OrderStatusBadgeTemplate is declared above and is shared with
                     the Hot Design status-badge previews. -->
                <ContentControl Grid.Column="1"
                                VerticalAlignment="Center"
                                ContentTemplate="{StaticResource OrderStatusBadgeTemplate}"
                                Content="{Binding}" />
            </Grid>

            <!-- Divider -->
            <Border Height="1"
                    Background="{ThemeResource OutlineVariantBrush}"
                    HorizontalAlignment="Stretch" />

            <!-- Items Summary -->
            <StackPanel Spacing="4">
                <TextBlock Text="Items"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}"
                           CharacterSpacing="50" />
                <TextBlock Text="{Binding ItemSummary}"
                           FontSize="13"
                           Foreground="{ThemeResource OnSurfaceBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- Total Row -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Order Total"
                           FontSize="13"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Column="1"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="{ThemeResource SecondaryBrush}">
                    <Run Text="$" />
                    <Run Text="{Binding TotalFormatted}" />
                </TextBlock>
            </Grid>

        </StackPanel>
    </Border>
  </DataTemplate>

  <!-- ══════════════════════ FeedView surfaces ══════════════════════ -->

  <!-- Shared failure state. Every page that reads the catalogue over ICatalogService uses this as
       its FeedView ErrorTemplate, so an unreachable backend looks the same everywhere. The
       FeedViewState's Refresh command re-runs the underlying request — no Model command needed. -->
  <DataTemplate x:Key="CatalogErrorTemplate">
    <Border Background="{ThemeResource SurfaceBrush}"
            CornerRadius="16"
            Padding="32,40"
            Margin="16,12,16,16"
            VerticalAlignment="Top"
            BorderBrush="{ThemeResource BrewCardBorderBrush}"
            BorderThickness="1">
      <StackPanel HorizontalAlignment="Center" Spacing="12">
        <Viewbox Width="44" Height="44" HorizontalAlignment="Center">
          <PathIcon Data="F1 M12 16C12.5523 16 13 16.4477 13 17C13 17.5523 12.5523 18 12 18C11.4477 18 11 17.5523 11 17C11 16.4477 11.4477 16 12 16ZM12 6.5C12.4142 6.5 12.75 6.83579 12.75 7.25V14.25C12.75 14.6642 12.4142 15 12 15C11.5858 15 11.25 14.6642 11.25 14.25V7.25C11.25 6.83579 11.5858 6.5 12 6.5ZM12 2C17.5228 2 22 6.47715 22 12C22 17.5228 17.5228 22 12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2ZM12 3.5C7.30558 3.5 3.5 7.30558 3.5 12C3.5 16.6944 7.30558 20.5 12 20.5C16.6944 20.5 20.5 16.6944 20.5 12C20.5 7.30558 16.6944 3.5 12 3.5Z"
                    Foreground="{ThemeResource SecondaryBrush}" />
        </Viewbox>
        <TextBlock Text="Couldn't reach the kitchen"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="{ThemeResource OnSurfaceBrush}"
                   HorizontalAlignment="Center" />
        <TextBlock Text="Check your connection and try again."
                   FontSize="13"
                   Foreground="{ThemeResource OnSurfaceVariantBrush}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="240" />
        <Button Style="{StaticResource BrewButtonStyle}"
                Content="Try again"
                AutomationProperties.Name="Try again"
                CornerRadius="12"
                Padding="24,10"
                FontSize="14"
                HorizontalAlignment="Center"
                Margin="0,4,0,0"
                Command="{Binding Refresh}" />
      </StackPanel>
    </Border>
  </DataTemplate>

  <!-- MenuPage: the product grid, and the empty result the search can legitimately produce. -->
  <DataTemplate x:Key="MenuGridTemplate">
    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                  Padding="16,4,16,16">
      <ItemsRepeater ItemsSource="{Binding Data}"
                     ItemTemplate="{StaticResource ProductCardTemplate}">
        <ItemsRepeater.Layout>
          <UniformGridLayout MinItemWidth="360"
                             MinColumnSpacing="12"
                             MinRowSpacing="12"
                             ItemsStretch="Fill" />
        </ItemsRepeater.Layout>
      </ItemsRepeater>
    </ScrollViewer>
  </DataTemplate>

  <DataTemplate x:Key="MenuNoResultsTemplate">
    <Border Background="{ThemeResource SurfaceBrush}"
            CornerRadius="16"
            Padding="32,40"
            Margin="16,12,16,16"
            VerticalAlignment="Top"
            BorderBrush="{ThemeResource BrewCardBorderBrush}"
            BorderThickness="1">
      <StackPanel HorizontalAlignment="Center" Spacing="12">
        <Viewbox Width="44" Height="44" HorizontalAlignment="Center">
          <PathIcon Data="F1 M16.1017 17.1624C14.717 18.3101 12.9391 19 11 19C6.58172 19 3 15.4183 3 11C3 6.58172 6.58172 3 11 3C15.4183 3 19 6.58172 19 11C19 12.9391 18.3101 14.717 17.1624 16.1018L21.7803 20.7197C22.0732 21.0126 22.0732 21.4874 21.7803 21.7803C21.4874 22.0732 21.0125 22.0732 20.7196 21.7803L16.1017 17.1624ZM17.5 11C17.5 7.41015 14.5899 4.5 11 4.5C7.41015 4.5 4.5 7.41015 4.5 11C4.5 14.5899 7.41015 17.5 11 17.5C14.5899 17.5 17.5 14.5899 17.5 11Z"
                    Foreground="{ThemeResource SecondaryBrush}" />
        </Viewbox>
        <TextBlock Text="No matches found"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="{ThemeResource OnSurfaceBrush}"
                   HorizontalAlignment="Center" />
        <TextBlock Text="Try a different category or search term."
                   FontSize="13"
                   Foreground="{ThemeResource OnSurfaceVariantBrush}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="240" />
      </StackPanel>
    </Border>
  </DataTemplate>

  <!-- OrdersPage: the history list, and the first-run "nothing here yet" state. -->
  <DataTemplate x:Key="OrderListTemplate">
    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                  Padding="20,0,20,16">
      <ItemsRepeater ItemsSource="{Binding Data}"
                     ItemTemplate="{StaticResource OrderCardTemplate}">
        <ItemsRepeater.Layout>
          <UniformGridLayout MinItemWidth="360"
                             MinColumnSpacing="12"
                             MinRowSpacing="12"
                             ItemsStretch="Fill" />
        </ItemsRepeater.Layout>
      </ItemsRepeater>
    </ScrollViewer>
  </DataTemplate>

  <DataTemplate x:Key="OrdersEmptyTemplate">
    <Border Background="{ThemeResource SurfaceBrush}"
            CornerRadius="16"
            Padding="32,40"
            Margin="20,0,20,16"
            VerticalAlignment="Top"
            BorderBrush="{ThemeResource BrewCardBorderBrush}"
            BorderThickness="1">
      <StackPanel HorizontalAlignment="Center" Spacing="12">
        <Viewbox Width="44" Height="44" HorizontalAlignment="Center">
          <PathIcon Data="F1 M3 5.25C3 4.00736 4.00736 3 5.25 3H14.75C15.9926 3 17 4.00736 17 5.25V14H21V17.75C21 19.5449 19.5449 21 17.75 21H6.25C4.45507 21 3 19.5449 3 17.75V5.25ZM17 19.5H17.75C18.7165 19.5 19.5 18.7165 19.5 17.75V15.5H17V19.5ZM5.25 4.5C4.83579 4.5 4.5 4.83579 4.5 5.25V17.75C4.5 18.7165 5.2835 19.5 6.25 19.5H15.5V5.25C15.5 4.83579 15.1642 4.5 14.75 4.5H5.25ZM7.25 7C6.83579 7 6.5 7.33579 6.5 7.75C6.5 8.16421 6.83579 8.5 7.25 8.5H12.75C13.1642 8.5 13.5 8.16421 13.5 7.75C13.5 7.33579 13.1642 7 12.75 7H7.25ZM6.5 11.75C6.5 11.3358 6.83579 11 7.25 11H12.75C13.1642 11 13.5 11.3358 13.5 11.75C13.5 12.1642 13.1642 12.5 12.75 12.5H7.25C6.83579 12.5 6.5 12.1642 6.5 11.75ZM7.25 15C6.83579 15 6.5 15.3358 6.5 15.75C6.5 16.1642 6.83579 16.5 7.25 16.5H10.25C10.6642 16.5 11 16.1642 11 15.75C11 15.3358 10.6642 15 10.25 15H7.25Z"
                    Foreground="{ThemeResource SecondaryBrush}" />
        </Viewbox>
        <TextBlock Text="No orders yet"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="{ThemeResource OnSurfaceBrush}"
                   HorizontalAlignment="Center" />
        <TextBlock Text="Your order history will appear here once you place your first order."
                   FontSize="13"
                   Foreground="{ThemeResource OnSurfaceVariantBrush}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="240" />
      </StackPanel>
    </Border>
  </DataTemplate>

  <!-- HomePage sections. Each is its own request, so each gets its own FeedView; the value
       templates just place the shared card template in the right layout. -->
  <DataTemplate x:Key="HomeSpecialsTemplate">
    <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                  VerticalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Enabled"
                  Padding="20,0,20,4">
      <ItemsControl ItemsSource="{Binding Data}"
                    ItemTemplate="{StaticResource SpecialProductCardTemplate}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="14" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </ScrollViewer>
  </DataTemplate>

  <DataTemplate x:Key="HomeFeaturedTemplate">
    <ItemsRepeater ItemsSource="{Binding Data}"
                   ItemTemplate="{StaticResource FeaturedProductCardTemplate}">
      <ItemsRepeater.Layout>
        <UniformGridLayout MinItemWidth="360"
                           MinColumnSpacing="12"
                           MinRowSpacing="12"
                           ItemsStretch="Fill" />
      </ItemsRepeater.Layout>
    </ItemsRepeater>
  </DataTemplate>

  <!-- A section that came back empty. Deliberately quiet: a missing promo row on the landing page
       is not an error, so it states the fact and stays out of the way. -->
  <DataTemplate x:Key="HomeSectionEmptyTemplate">
    <TextBlock Text="Nothing here today — check back soon."
               FontSize="13"
               Foreground="{ThemeResource OnSurfaceVariantBrush}"
               Margin="20,4,20,4"
               TextWrapping="Wrap" />
  </DataTemplate>

</ResourceDictionary>
