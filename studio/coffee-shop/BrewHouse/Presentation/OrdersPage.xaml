<Page x:Class="BrewHouse.Presentation.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      Background="{ThemeResource BackgroundBrush}">

    <utu:SafeArea Insets="VisibleBounds">
        <Grid x:Name="Root" MaxWidth="1100" HorizontalAlignment="Stretch">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header (shared style: consistent position/background/type across every page) -->
            <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
                <StackPanel>
                    <TextBlock Text="My Orders" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Track your current and past orders" Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
            </Border>

            <!-- The order book is a FeedView over the shared list STATE: the app edits it (Place
                 Order prepends), but its initial contents load from ICatalogService, so the history
                 genuinely has a loading state, a failure state, and a first-run empty state. All
                 three are templates keyed in DataTemplates.xaml — no bool feed, no converter. -->
            <mvux:FeedView Grid.Row="1"
                           Source="{Binding Orders}"
                           ValueTemplate="{StaticResource OrderListTemplate}"
                           NoneTemplate="{StaticResource OrdersEmptyTemplate}"
                           ErrorTemplate="{StaticResource CatalogErrorTemplate}" />

        </Grid>
    </utu:SafeArea>
</Page>
