<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utu="using:Uno.Toolkit.UI"
                    xmlns:presentation="using:BrewHouse.Presentation">

  <!--
    BrewHouse styling vocabulary: shared brushes, converters, button/header styles, control
    templates, and the design tokens (corner radii, spacing scale, the responsive breakpoint).
    Merged into App.xaml AFTER the Simple theme so the well-known-key overrides here
    (ControlCornerRadius*, OverlayCornerRadius) win over the theme defaults. Pages CONSUME these
    keys via {StaticResource}/{ThemeResource}; they never re-declare the look. See lesson 56.
  -->

  <!-- App-specific brushes. Only genuinely theme-VARYING chrome lives in ThemeDictionaries;
       everything theme-invariant (header, status pills, the ready dot) sits at the root. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <!-- Card separator: translucent black in light, translucent white in dark -->
      <SolidColorBrush x:Key="BrewCardBorderBrush" Color="#14000000" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="BrewCardBorderBrush" Color="#24FFFFFF" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Order-status pill containers: bright background + legible on-colour, read on light + dark -->
  <SolidColorBrush x:Key="BrewStatusReadyContainerBrush" Color="#3FB368" />
  <SolidColorBrush x:Key="BrewStatusReadyOnContainerBrush" Color="#0C3A1E" />
  <SolidColorBrush x:Key="BrewStatusPreparingContainerBrush" Color="#F0A23C" />
  <SolidColorBrush x:Key="BrewStatusPreparingOnContainerBrush" Color="#4A2A08" />
  <SolidColorBrush x:Key="BrewStatusCompletedContainerBrush" Color="#A99A88" />
  <SolidColorBrush x:Key="BrewStatusCompletedOnContainerBrush" Color="#33291F" />

  <!-- 'Ready' status dot (used by the Cart's ready note) -->
  <SolidColorBrush x:Key="BrewStatusReadyBrush" Color="#3FA34D" />

  <!-- Converter (content-free value transform; brush/visibility choices stay in XAML) -->
  <presentation:BoolToVisibilityConverter x:Key="BoolToVisibility" />

  <!-- Chrome-less, keyboard-focusable button: makes a card / chip / pill a real, accessible
       control (focus + Invoke automation peer) while the inner content defines the look. A
       foreground-neutral state layer (rounded to the button's CornerRadius) gives hover/pressed
       feedback; set CornerRadius on the button to match the content's rounding. -->
  <Style x:Key="FlatButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="Transparent">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="FlatStateLayer.Opacity" Value="0.06" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="FlatStateLayer.Opacity" Value="0.12" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="FlatContent.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter x:Name="FlatContent"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              Padding="{TemplateBinding Padding}"
                              Background="Transparent" />
            <Border x:Name="FlatStateLayer"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Background="{ThemeResource OnSurfaceBrush}"
                    Opacity="0"
                    IsHitTestVisible="False" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Filled action button: one crisp rounded Border for the fill (no themed border to alias at
       small sizes), plus a foreground-coloured state layer for hover/pressed. The canonical button
       for every coloured action (Add, Place Order, +/-, etc.); callers override Background/Foreground
       for secondary/neutral variants. -->
  <Style x:Key="BrewButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource PrimaryBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource OnPrimaryBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
              <!-- Tactile press: firm 0.98 scale (not a collapse), per the design-polish house value -->
              <ScaleTransform x:Name="RootScale" />
            </Border.RenderTransform>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="StateLayer.Opacity" Value="0.10" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="StateLayer.Opacity" Value="0.20" />
                    <Setter Target="RootScale.ScaleX" Value="0.98" />
                    <Setter Target="RootScale.ScaleY" Value="0.98" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid>
              <Border x:Name="StateLayer"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      Background="{TemplateBinding Foreground}"
                      Opacity="0"
                      IsHitTestVisible="False" />
              <ContentPresenter Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Padding="{TemplateBinding Padding}"
                                Foreground="{TemplateBinding Foreground}"
                                FontWeight="{TemplateBinding FontWeight}"
                                FontSize="{TemplateBinding FontSize}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Home hero carousel: minimal FlipView template with NO built-in flipper buttons. The default
       template's flippers stretch to the full FlipView height (their shape deforms across form
       factors), and hiding them after the fact is unreliable (style overrides are a no-op on Skia
       and a code-behind collapse races the control's own visual states). Removing them from the
       template makes doubling impossible on every head; paging is swipe + the fixed-size custom
       hero nav buttons. Keeps the template-part name "ScrollingHost" the control requires. -->
  <Style x:Key="HeroFlipViewStyle" TargetType="FlipView">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="TabNavigation" Value="Once" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="FlipView">
          <Grid Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
            <ScrollViewer x:Name="ScrollingHost"
                          AutomationProperties.AccessibilityView="Raw"
                          BringIntoViewOnFocusChange="{TemplateBinding ScrollViewer.BringIntoViewOnFocusChange}"
                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                          HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}"
                          HorizontalSnapPointsType="MandatorySingle"
                          IsDeferredScrollingEnabled="False"
                          IsHorizontalRailEnabled="False"
                          IsTabStop="False"
                          IsVerticalRailEnabled="False"
                          Padding="{TemplateBinding Padding}"
                          TabNavigation="{TemplateBinding TabNavigation}"
                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                          VerticalScrollMode="{TemplateBinding ScrollViewer.VerticalScrollMode}"
                          VerticalSnapPointsType="MandatorySingle"
                          ZoomMode="Disabled">
              <ItemsPresenter />
            </ScrollViewer>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Consistent circular hero nav button: a fixed 40×40 so it never deforms, on a translucent
       scrim that reads over any photo, with a vector `Path` chevron supplied as the button content. -->
  <Style x:Key="HeroNavButtonStyle" TargetType="Button" BasedOn="{StaticResource BrewButtonStyle}">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="#59000000" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Rounder controls to match the card language -->
  <CornerRadius x:Key="ControlCornerRadiusSmall">8</CornerRadius>
  <CornerRadius x:Key="ControlCornerRadius">12</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">16</CornerRadius>

  <!-- Spacing scale (design-system tokens) so padding/margins come from one rhythm -->
  <x:Double x:Key="SpacingXS">4</x:Double>
  <x:Double x:Key="SpacingSM">8</x:Double>
  <x:Double x:Key="SpacingMD">12</x:Double>
  <x:Double x:Key="SpacingLG">16</x:Double>
  <x:Double x:Key="SpacingXL">24</x:Double>

  <!-- Consistent page header: identical position, background and type on every page so the title
       doesn't jump when navigating (a plain BackgroundBrush strip; page content scrolls below). -->
  <Thickness x:Key="PageHeaderPadding">20,20,20,12</Thickness>
  <Style x:Key="PageHeaderStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource BackgroundBrush}" />
    <Setter Property="Padding" Value="{StaticResource PageHeaderPadding}" />
  </Style>
  <Style x:Key="PageTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{ThemeResource OnBackgroundBrush}" />
  </Style>
  <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>

  <!-- Window-width breakpoint shared by the shell + page layouts: phone below 900px
       (bottom TabBar), desktop/web at or above (NavigationView pane) -->
  <utu:ResponsiveLayout x:Key="DefaultResponsiveLayout"
                        Narrow="0"
                        Wide="900" />

  <!-- Product card, bound to a ProductItem. Used by the Menu grid (MenuPage) and by the Hot Design
       product-card previews. The whole card is a focusable button that opens the product detail
       page; the inner "+ Add to Cart" is a nested button. Both commands reach the page Model via
       {utu:AncestorBinding AncestorType=ItemsRepeater} at runtime; in an isolated preview those
       ancestor lookups find no ItemsRepeater and the buttons are simply inert. -->
  <DataTemplate x:Key="ProductCardTemplate">
    <Button Style="{StaticResource FlatButtonStyle}"
            CornerRadius="16"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            AutomationProperties.Name="{Binding Name}"
            Command="{utu:AncestorBinding AncestorType=ItemsRepeater, Path=DataContext.ViewProduct}"
            CommandParameter="{Binding}">
      <Border Background="{ThemeResource SurfaceBrush}"
              CornerRadius="16"
              BorderBrush="{ThemeResource BrewCardBorderBrush}"
              BorderThickness="1"
              VerticalAlignment="Stretch">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>

          <!-- Product image: fills the card height; corners match the card -->
          <Border Grid.Column="0" CornerRadius="16,0,0,16">
            <Border.Background>
              <ImageBrush ImageSource="{Binding ImageUrl}" Stretch="UniformToFill" />
            </Border.Background>
          </Border>

          <!-- Product Info -->
          <StackPanel Grid.Column="1" Padding="12,8" Spacing="2" VerticalAlignment="Center">

            <!-- Name + right-aligned "Today's Special" badge on one row, so the badge never adds
                 height and every tile stays the same height -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0"
                         Text="{Binding Name}"
                         FontSize="16"
                         FontWeight="SemiBold"
                         Foreground="{ThemeResource OnSurfaceBrush}"
                         TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />
              <Border Grid.Column="1"
                      Background="{ThemeResource SurfaceVariantBrush}"
                      CornerRadius="6"
                      Padding="6,2"
                      Margin="8,0,0,0"
                      VerticalAlignment="Center"
                      Visibility="{Binding IsSpecial, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Today's Special"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource SecondaryBrush}" />
              </Border>
            </Grid>

            <TextBlock Text="{Binding Description}"
                       FontSize="12"
                       Foreground="{ThemeResource OnSurfaceVariantBrush}"
                       TextWrapping="Wrap"
                       MaxLines="1"
                       TextTrimming="CharacterEllipsis" />

            <Grid Margin="0,4,0,0" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" FontSize="17" FontWeight="Bold"
                         Foreground="{ThemeResource SecondaryBrush}" VerticalAlignment="Center">
                <Run Text="$" /><Run Text="{Binding Price}" />
              </TextBlock>
              <Button Grid.Column="1"
                      Style="{StaticResource BrewButtonStyle}"
                      Content="+ Add to Cart"
                      AutomationProperties.Name="Add to cart"
                      CornerRadius="8"
                      Padding="10,4"
                      FontSize="11"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Command="{utu:AncestorBinding AncestorType=ItemsRepeater, Path=DataContext.AddToCart}"
                      CommandParameter="{Binding}" />
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
    </Button>
  </DataTemplate>

  <!-- Order status badge, bound to an OrderRecord. Shared by the Orders list (OrdersPage) and the
       Hot Design status-badge previews. Three visibility-toggled coloured pills (one per status);
       the pill background carries the status colour and re-themes via {ThemeResource}. -->
  <DataTemplate x:Key="OrderStatusBadgeTemplate">
    <Grid VerticalAlignment="Center">
      <Border Background="{ThemeResource BrewStatusReadyContainerBrush}"
              CornerRadius="6"
              Padding="10,5"
              VerticalAlignment="Center"
              Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding Status}"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="{ThemeResource BrewStatusReadyOnContainerBrush}"
                   VerticalAlignment="Center" />
      </Border>
      <Border Background="{ThemeResource BrewStatusPreparingContainerBrush}"
              CornerRadius="6"
              Padding="10,5"
              VerticalAlignment="Center"
              Visibility="{Binding IsPreparing, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding Status}"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="{ThemeResource BrewStatusPreparingOnContainerBrush}"
                   VerticalAlignment="Center" />
      </Border>
      <Border Background="{ThemeResource BrewStatusCompletedContainerBrush}"
              CornerRadius="6"
              Padding="10,5"
              VerticalAlignment="Center"
              Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding Status}"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="{ThemeResource BrewStatusCompletedOnContainerBrush}"
                   VerticalAlignment="Center" />
      </Border>
    </Grid>
  </DataTemplate>

</ResourceDictionary>
