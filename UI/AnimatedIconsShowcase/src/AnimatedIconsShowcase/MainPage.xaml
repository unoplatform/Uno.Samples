<Page x:Class="AnimatedIconsShowcase.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

  <Page.Resources>
    <Style x:Key="CardBorderStyle" TargetType="Border">
      <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,12" />
    </Style>

    <Style x:Key="CardCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="IconTileStyle" TargetType="Border">
      <Setter Property="Width" Value="88" />
      <Setter Property="Height" Value="88" />
      <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="6" />
    </Style>

    <Style x:Key="TileCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </Page.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Padding="20" RowSpacing="12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Spacing="2">
        <TextBlock AutomationProperties.AutomationId="PageTitle"
                   Style="{ThemeResource TitleTextBlockStyle}"
                   Text="AnimatedIcon and AnimatedVisualPlayer on Skia" />
        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Style="{ThemeResource BodyTextBlockStyle}"
                   Text="Uno Platform 6.7 plays the LottieGen-generated Fluent animations through real Composition visuals — these are the stock templates, with no custom animation code."
                   TextWrapping="Wrap" />
      </StackPanel>

      <Grid Grid.Row="1" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Left: stock Fluent controls whose built-in templates use AnimatedIcon  -->
        <StackPanel Grid.Column="0" Spacing="10">
          <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Built-in Fluent templates" />

          <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel Spacing="8">
              <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Expander" />
              <TextBlock Style="{StaticResource CardCaptionStyle}" Text="Chevron = AnimatedIcon + AnimatedChevronUpDownSmallVisualSource." />
              <Expander AutomationProperties.AutomationId="ChevronExpander"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Header="Expand to rotate the chevron"
                        IsExpanded="False">
                <TextBlock Style="{StaticResource CardCaptionStyle}" Text="Collapsing plays the same marker segment in reverse." />
              </Expander>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel Spacing="8">
              <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="CheckBox" />
              <TextBlock Style="{StaticResource CardCaptionStyle}" Text="Check glyph = AnimatedIcon + AnimatedAcceptVisualSource — it strokes itself in." />
              <StackPanel Orientation="Horizontal" Spacing="20">
                <CheckBox AutomationProperties.AutomationId="AnimatedCheckBox" Content="Draw the check" />
                <CheckBox AutomationProperties.AutomationId="ThreeStateCheckBox"
                          Content="Three state"
                          IsThreeState="True" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel Spacing="8">
              <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="NavigationView" />
              <TextBlock Style="{StaticResource CardCaptionStyle}" Text="Pane toggle = AnimatedGlobalNavigationButtonVisualSource; item chevron = AnimatedChevronUpDownSmallVisualSource." />
              <ToggleSwitch AutomationProperties.AutomationId="PaneOpenToggle"
                            IsOn="True"
                            OffContent="Pane closed"
                            OnContent="Pane open"
                            Toggled="OnPaneOpenToggled" />
              <Border Height="200"
                      HorizontalAlignment="Stretch"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      CornerRadius="6">
                <muxc:NavigationView x:Name="DemoNavigationView"
                                     AutomationProperties.AutomationId="DemoNavigationView"
                                     IsBackButtonVisible="Collapsed"
                                     IsSettingsVisible="True"
                                     OpenPaneLength="180"
                                     PaneDisplayMode="Left">
                  <muxc:NavigationView.MenuItems>
                    <muxc:NavigationViewItem AutomationProperties.AutomationId="NavItemHome"
                                             Content="Home"
                                             Icon="Home" />
                    <muxc:NavigationViewItem AutomationProperties.AutomationId="NavItemLibrary" Content="Library" Icon="Library">
                      <muxc:NavigationViewItem.MenuItems>
                        <muxc:NavigationViewItem Content="Recent" />
                        <muxc:NavigationViewItem Content="Favorites" />
                      </muxc:NavigationViewItem.MenuItems>
                    </muxc:NavigationViewItem>
                  </muxc:NavigationView.MenuItems>
                  <TextBlock Margin="16"
                             VerticalAlignment="Center"
                             Style="{StaticResource CardCaptionStyle}"
                             Text="Toggle the pane to see the hamburger, or expand Library for the item chevron." />
                </muxc:NavigationView>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <!--  Right: the AnimatedIcon / AnimatedVisualPlayer APIs used directly  -->
        <StackPanel Grid.Column="1" Spacing="10">
          <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Using the API directly" />

          <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel Spacing="8">
              <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="AnimatedIcon" />
              <TextBlock Style="{StaticResource CardCaptionStyle}" Text="AnimatedIcon.State is attached to each tile — changing it plays the matching &quot;FromToTo&quot; marker segment. Hover or press a tile to drive it live." />

              <!--  AnimatedIcon.State set on a tile is picked up by the AnimatedIcon inside it.  -->
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Border x:Name="BackIconTile"
                        muxc:AnimatedIcon.State="Normal"
                        AutomationProperties.AutomationId="BackIconTile"
                        PointerEntered="OnPointerIconEntered"
                        PointerExited="OnPointerIconExited"
                        PointerPressed="OnPointerIconPressed"
                        PointerReleased="OnPointerIconReleased"
                        Style="{StaticResource IconTileStyle}">
                  <StackPanel VerticalAlignment="Center" Spacing="6">
                    <muxc:AnimatedIcon Width="32"
                                       Height="32"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                      <animatedvisuals:AnimatedBackVisualSource />
                    </muxc:AnimatedIcon>
                    <TextBlock Style="{StaticResource TileCaptionStyle}" Text="Back" />
                  </StackPanel>
                </Border>

                <Border x:Name="FindIconTile"
                        muxc:AnimatedIcon.State="Normal"
                        AutomationProperties.AutomationId="FindIconTile"
                        PointerEntered="OnPointerIconEntered"
                        PointerExited="OnPointerIconExited"
                        PointerPressed="OnPointerIconPressed"
                        PointerReleased="OnPointerIconReleased"
                        Style="{StaticResource IconTileStyle}">
                  <StackPanel VerticalAlignment="Center" Spacing="6">
                    <muxc:AnimatedIcon Width="32"
                                       Height="32"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                      <animatedvisuals:AnimatedFindVisualSource />
                    </muxc:AnimatedIcon>
                    <TextBlock Style="{StaticResource TileCaptionStyle}" Text="Find" />
                  </StackPanel>
                </Border>

                <Border x:Name="SettingsIconTile"
                        muxc:AnimatedIcon.State="Normal"
                        AutomationProperties.AutomationId="SettingsIconTile"
                        PointerEntered="OnPointerIconEntered"
                        PointerExited="OnPointerIconExited"
                        PointerPressed="OnPointerIconPressed"
                        PointerReleased="OnPointerIconReleased"
                        Style="{StaticResource IconTileStyle}">
                  <StackPanel VerticalAlignment="Center" Spacing="6">
                    <muxc:AnimatedIcon Width="32"
                                       Height="32"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                      <animatedvisuals:AnimatedSettingsVisualSource />
                    </muxc:AnimatedIcon>
                    <TextBlock Style="{StaticResource TileCaptionStyle}" Text="Settings" />
                  </StackPanel>
                </Border>

                <Border x:Name="GlobalNavigationIconTile"
                        muxc:AnimatedIcon.State="Normal"
                        AutomationProperties.AutomationId="GlobalNavigationIconTile"
                        PointerEntered="OnPointerIconEntered"
                        PointerExited="OnPointerIconExited"
                        PointerPressed="OnPointerIconPressed"
                        PointerReleased="OnPointerIconReleased"
                        Style="{StaticResource IconTileStyle}">
                  <StackPanel VerticalAlignment="Center" Spacing="6">
                    <muxc:AnimatedIcon Width="32"
                                       Height="32"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                      <animatedvisuals:AnimatedGlobalNavigationButtonVisualSource />
                    </muxc:AnimatedIcon>
                    <TextBlock Style="{StaticResource TileCaptionStyle}" Text="Menu" />
                  </StackPanel>
                </Border>

                <Border x:Name="AcceptIconTile"
                        muxc:AnimatedIcon.State="NormalOn"
                        AutomationProperties.AutomationId="AcceptIconTile"
                        Style="{StaticResource IconTileStyle}">
                  <StackPanel VerticalAlignment="Center" Spacing="6">
                    <muxc:AnimatedIcon Width="32"
                                       Height="32"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">
                      <animatedvisuals:AnimatedAcceptVisualSource />
                    </muxc:AnimatedIcon>
                    <TextBlock Style="{StaticResource TileCaptionStyle}" Text="Accept" />
                  </StackPanel>
                </Border>

                <Border x:Name="ChevronIconTile"
                        muxc:AnimatedIcon.State="NormalOn"
                        AutomationProperties.AutomationId="ChevronIconTile"
                        Style="{StaticResource IconTileStyle}">
                  <StackPanel VerticalAlignment="Center" Spacing="6">
                    <muxc:AnimatedIcon Width="32"
                                       Height="32"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">
                      <animatedvisuals:AnimatedChevronUpDownSmallVisualSource />
                    </muxc:AnimatedIcon>
                    <TextBlock Style="{StaticResource TileCaptionStyle}" Text="Chevron" />
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="16">
                <Button x:Name="PulseIconsButton"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="PulseIconsButton"
                        Click="OnPulseIcons"
                        Content="Pulse pointer states" />
                <ToggleSwitch VerticalAlignment="Center"
                              AutomationProperties.AutomationId="OnOffStateToggle"
                              IsOn="True"
                              OffContent="Accept / Chevron off"
                              OnContent="Accept / Chevron on"
                              Toggled="OnOnOffStateToggled" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel Spacing="8">
              <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="AnimatedVisualPlayer" />
              <TextBlock Style="{StaticResource CardCaptionStyle}" Text="The same generated source hosted directly, with playback driven from code." />

              <StackPanel Orientation="Horizontal" Spacing="14">
                <Border Width="120"
                        Height="120"
                        Padding="18"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                  <muxc:AnimatedVisualPlayer x:Name="Player"
                                             AutomationProperties.AutomationId="AnimatedVisualPlayer"
                                             AutoPlay="False"
                                             Stretch="Uniform">
                    <animatedvisuals:AnimatedSettingsVisualSource />
                  </muxc:AnimatedVisualPlayer>
                </Border>

                <StackPanel VerticalAlignment="Center" Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button AutomationProperties.AutomationId="PlayButton"
                            Click="OnPlay"
                            Content="Play" />
                    <Button AutomationProperties.AutomationId="PauseButton"
                            Click="OnPause"
                            Content="Pause" />
                    <Button AutomationProperties.AutomationId="ResumeButton"
                            Click="OnResume"
                            Content="Resume" />
                    <Button AutomationProperties.AutomationId="StopButton"
                            Click="OnStop"
                            Content="Stop" />
                  </StackPanel>
                  <Slider x:Name="ProgressSlider"
                          Width="300"
                          AutomationProperties.AutomationId="ProgressSlider"
                          Header="SetProgress"
                          Maximum="1"
                          Minimum="0"
                          StepFrequency="0.01"
                          ValueChanged="OnProgressChanged" />
                </StackPanel>
              </StackPanel>

              <TextBlock x:Name="PlayerStatusText"
                         AutomationProperties.AutomationId="PlayerStatusText"
                         Style="{StaticResource CardCaptionStyle}"
                         Text="Stopped" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel Spacing="6">
              <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="What changed in 6.7" />
              <TextBlock Style="{StaticResource CardCaptionStyle}" Text="The generated sources build a real Composition tree — geometries, brushes and keyframe animations — instead of falling back to a static glyph. Every animation on this page is the one Microsoft ships in the Fluent templates." />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Grid>
  </ScrollViewer>
</Page>
