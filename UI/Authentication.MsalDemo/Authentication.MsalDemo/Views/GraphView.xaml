<UserControl x:Class="Authentication.MsalDemo.Views.GraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ScrollViewer>
    <StackPanel MaxWidth="920"
                Padding="16"
                Spacing="16">

      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="10">
          <TextBlock Text="USING THE TOKEN" Style="{StaticResource LabelTextStyle}" />
          <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap">
            A token is only worth having if an API accepts it. This calls Microsoft Graph's
            /v1.0/me endpoint with a plain HttpClient and the access token in an
            Authorization: Bearer header - the same thing any API call in your app would do.
          </TextBlock>
          <TextBlock Style="{StaticResource CodeTextStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}">
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", result.AccessToken);
          </TextBlock>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}"
              Background="#26D08700"
              BorderBrush="{StaticResource FlowWarningBrush}"
              Visibility="{Binding NeedsSignIn, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding SignInHint}"
                   Style="{StaticResource BodyTextBlockStyle}"
                   TextWrapping="Wrap" />
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Click="OnCallGraphClick"
                Content="GET /v1.0/me"
                IsEnabled="{Binding CanCall}"
                Style="{StaticResource AccentButtonStyle}" />
      </StackPanel>

      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="10">
          <TextBlock Text="RESULT" Style="{StaticResource LabelTextStyle}" />
          <TextBlock Text="{Binding Status}"
                     Style="{StaticResource BodyTextBlockStyle}"
                     TextWrapping="Wrap" />
          <ProgressBar IsIndeterminate="True"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="{Binding Profile}" Style="{StaticResource CodeTextStyle}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}"
              Visibility="{Binding HasResponse, Converter={StaticResource BoolToVisibility}}">
        <StackPanel Spacing="10">
          <TextBlock Text="RAW RESPONSE" Style="{StaticResource LabelTextStyle}" />
          <TextBlock Text="{Binding RawJson}" Style="{StaticResource CodeTextStyle}" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>

</UserControl>
