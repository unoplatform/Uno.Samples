<UserControl x:Class="Authentication.MsalDemo.Views.PlatformSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ScrollViewer>
    <StackPanel MaxWidth="920"
                Padding="16"
                Spacing="16">

      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="10">
          <TextBlock Text="WHAT EACH HEAD NEEDS" Style="{StaticResource LabelTextStyle}" />
          <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap">
            The authentication code in this sample is identical on every platform - the only
            per-platform work is the redirect URI and the plumbing that carries the callback back
            into the app. This page lists all of it. The head you are running on is marked.
          </TextBlock>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="12">
          <TextBlock Text="EVERY PLATFORM" Style="{StaticResource LabelTextStyle}" />
          <ItemsControl ItemsSource="{Binding CommonSteps}"
                        ItemTemplate="{StaticResource SetupStepTemplate}" />
        </StackPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding Platforms}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
              <StackPanel Spacing="14">

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock Text="{Binding Name}"
                             Style="{StaticResource SubtitleTextBlockStyle}"
                             TextWrapping="Wrap" />
                  <Border Grid.Column="1"
                          Padding="8,3"
                          VerticalAlignment="Top"
                          Background="{StaticResource FlowSuccessBrush}"
                          CornerRadius="4"
                          Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="RUNNING HERE"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="White" />
                  </Border>
                </Grid>

                <TextBlock Text="{Binding Summary}"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />

                <StackPanel Spacing="2">
                  <TextBlock Text="REDIRECT URI" Style="{StaticResource LabelTextStyle}" />
                  <TextBlock Text="{Binding RedirectUri}"
                             Style="{StaticResource CodeTextStyle}"
                             FontSize="13"
                             Foreground="{StaticResource FlowCallBrush}" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Steps}"
                              ItemTemplate="{StaticResource SetupStepTemplate}" />

              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>
  </ScrollViewer>

</UserControl>
