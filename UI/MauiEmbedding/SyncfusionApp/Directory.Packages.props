<Project ToolsVersion="15.0">
  <!--
    To update the version of Uno, you should instead update the Sdk version in the global.json file.

    See https://aka.platform.uno/using-uno-sdk for more information.
    See https://aka.platform.uno/using-uno-sdk#implicit-packages for more information regarding the Implicit Packages.
  -->
  <ItemGroup>
    <PackageVersion Include="Syncfusion.Maui.Core" Version="35.1.37" />
    <PackageVersion Include="Syncfusion.Maui.Charts" Version="35.1.37" />
    <PackageVersion Include="Syncfusion.Maui.TabView" Version="35.1.37" />
    <PackageVersion Include="Syncfusion.Maui.DataGrid" Version="35.1.37" />
    <PackageVersion Include="Syncfusion.Compression.NET" Version="35.1.37" />
    <PackageVersion Include="Syncfusion.Maui.PdfToImageConverter" Version="35.1.37" />
    <PackageVersion Include="Syncfusion.PDF.NET" Version="35.1.37" />
    <PackageVersion Include="Syncfusion.Maui.PdfViewer" Version="35.1.37" />
    <PackageVersion Include="Syncfusion.Maui.ListView" Version="35.1.37" />
    <PackageVersion Include="Syncfusion.Maui.DataSource" Version="35.1.37" />
    <PackageVersion Include="Syncfusion.Maui.GridCommon" Version="35.1.37" />
    <PackageVersion Include="Syncfusion.Pdf.Imaging.NET" Version="35.1.37" />
    <PackageVersion Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageVersion Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
  </ItemGroup>
</Project>
