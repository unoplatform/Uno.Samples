<Project Sdk="Uno.Sdk">
  <PropertyGroup>
	<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-browserwasm;net10.0-desktop</TargetFrameworks>
	<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows')) or '$(EnableWindowsTargeting)' == 'true'">$(TargetFrameworks);net10.0-windows10.0.26100</TargetFrameworks>
	<TargetFrameworks Condition="'$(OverrideTargetFrameworks)'!=''">$(OverrideTargetFrameworks)</TargetFrameworks>
	<OutputType>Exe</OutputType>
	<UnoSingleProject>true</UnoSingleProject>

	<!-- Display name -->
	<ApplicationTitle>SyncfusionApp</ApplicationTitle>
	<!-- App Identifier -->
	<ApplicationId>com.companyname.syncfusionapp</ApplicationId>
	<!-- Versions -->
	<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
	<ApplicationVersion>1</ApplicationVersion>
	<!-- Package Publisher -->
	<ApplicationPublisher>SyncfusionApp</ApplicationPublisher>
	<!-- Package Description -->
	<Description>SyncfusionApp powered by Uno Platform.</Description>

	<!--
	  UnoFeatures let's you quickly add and manage implicit package references based on the features you want to use.
	  https://aka.platform.uno/singleproject-features
	-->
	<UnoFeatures>
	  Hosting;
	  Toolkit;
	  Logging;
	  LoggingSerilog;
	  Mvvm;
	  Configuration;
	  Http;
	  HttpRefit;
	  Serialization;
	  Localization;
	  Navigation;
	  SkiaRenderer;
	</UnoFeatures>
	<!--
	  MAUI embedding: MauiEmbedding (Uno.Maui.Embedding) on the desktop and WebAssembly targets,
	  MauiNativeEmbedding (the native embedding of Uno.Extensions) on Android, iOS and Windows.
	  https://aka.platform.uno/feature-maui-embedding
	-->
	<UnoFeatures Condition="$(TargetFramework.Contains('-desktop')) or $(TargetFramework.Contains('-browserwasm'))">$(UnoFeatures);MauiEmbedding;</UnoFeatures>
	<UnoFeatures Condition="'$(TargetFramework)' != '' and !$(TargetFramework.Contains('-desktop')) and !$(TargetFramework.Contains('-browserwasm'))">$(UnoFeatures);MauiNativeEmbedding;</UnoFeatures>
  </PropertyGroup>

  <ItemGroup>
	<ProjectReference Include="..\SyncfusionApp.MauiControls\SyncfusionApp.MauiControls.csproj" />
  </ItemGroup>

</Project>
