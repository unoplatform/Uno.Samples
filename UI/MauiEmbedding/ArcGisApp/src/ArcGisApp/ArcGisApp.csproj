<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows')) or '$(EnableWindowsTargeting)' == 'true'">$(TargetFrameworks);net10.0-windows10.0.26100</TargetFrameworks>
    <!--
      The ArcGIS Maps SDK supports win-x64 and win-arm64 only (ArcGISMapsRID001 on win-x86).
      Uno.Sdk defaults RuntimeIdentifiers to win-x86;win-x64;win-arm64 on Windows when it is empty.
    -->
    <RuntimeIdentifiers Condition="$(TargetFramework.Contains('-windows'))">win-x64;win-arm64</RuntimeIdentifiers>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>ArcGisApp</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.companyname.ArcGisApp</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!--
      UnoFeatures let's you quickly add and manage implicit package references based on the features you want to use.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      SkiaRenderer;
    </UnoFeatures>
    <!--
      MAUI embedding: MauiNativeEmbedding (the native embedding of Uno.Extensions) on Android, iOS and Windows.
      There is no desktop or WebAssembly target: there, MAUI embedding goes through Uno.Maui.Embedding (the MauiEmbedding
      UnoFeature), and the ArcGIS Maps SDK needs its native runtime, which ships for Windows, Android, iOS and Mac Catalyst only.
      https://aka.platform.uno/feature-maui-embedding
    -->
    <UnoFeatures>$(UnoFeatures);MauiNativeEmbedding;</UnoFeatures>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArcGisApp.MauiControls\ArcGisApp.MauiControls.csproj" />
  </ItemGroup>

</Project>
