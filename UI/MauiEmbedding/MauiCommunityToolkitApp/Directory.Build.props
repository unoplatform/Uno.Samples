<Project>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!--
      The .NET MAUI version of the app and of its MAUI class library. Uno.Maui.Embedding (desktop and WebAssembly) is tested with 10.0.101,
      and CommunityToolkit.Maui needs 10.0.90 or later.
    -->
    <MauiVersion>10.0.101</MauiVersion>

    <!--
      Uno.Maui.Embedding (MauiEmbedding, desktop and WebAssembly) and Uno.WinUI.Retarget. 0.1.0-dev.4 is the first build with the API
      of Uno.Extensions' MAUI embedding (MauiHost and UseMauiEmbedding in Uno.Extensions.Maui); Uno.Sdk 7.0.5 still defaults to 0.1.0-dev.2.
    -->
    <UnoMauiVersion>0.1.0-dev.4</UnoMauiVersion>
    <UnoRetargetVersion>0.1.0-dev.4</UnoRetargetVersion>

    <!--
      Adding NoWarn to remove build warnings
      NU1507: Warning when there are multiple package sources when using CPM with no source mapping
      NETSDK1201: Warning that specifying RID won't create self containing app
      NETSDK1023:	Microsoft.Maui.Graphics reference required to avoid build error causes warning because it's already implicitly referenced by Maui SDK
      PRI257: Ignore default language (en) not being one of the included resources (eg en-us, en-uk)
    -->
    <NoWarn>$(NoWarn);NU1507;NETSDK1201;NETSDK1023;PRI257</NoWarn>
  </PropertyGroup>
</Project>
