<Project Sdk="Uno.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows')) or '$(EnableWindowsTargeting)' == 'true'">$(TargetFrameworks);net10.0-windows10.0.26100</TargetFrameworks>
		<TargetFrameworks Condition="'$(OverrideTargetFrameworks)'!=''">$(OverrideTargetFrameworks)</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<UnoSingleProject>true</UnoSingleProject>

		<!-- Display name -->
		<ApplicationTitle>GrapeCityApp</ApplicationTitle>
		<!-- App Identifier -->
		<ApplicationId>com.companyname.grapecityapp</ApplicationId>
		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<!-- Package Publisher -->
		<ApplicationPublisher>GrapeCityApp</ApplicationPublisher>
		<!-- Package Description -->
		<Description>GrapeCityApp powered by Uno Platform.</Description>

		<!--
		  UnoFeatures let's you quickly add and manage implicit package references based on the features you want to use.
		  https://aka.platform.uno/singleproject-features
		-->
		<UnoFeatures>
		  Dsp;
		  Hosting;
		  Toolkit;
		  Logging;
		  LoggingSerilog;
		  Mvvm;
		  Configuration;
		  Http;
		  Serialization;
		  Localization;
		  Navigation;
		  SkiaRenderer;
		</UnoFeatures>
		<!--
		  MAUI embedding: MauiNativeEmbedding (the native embedding of Uno.Extensions) on Android, iOS and Windows.
		  There is no desktop or WebAssembly target: there, MAUI embedding goes through Uno.Maui.Embedding (the MauiEmbedding
		  UnoFeature), and the Windows build of the ComponentOne controls needs C1.WinUI libraries that it does not restore on those targets.
		  https://aka.platform.uno/feature-maui-embedding
		-->
		<UnoFeatures>$(UnoFeatures);MauiNativeEmbedding;</UnoFeatures>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\GrapeCityApp.MauiControls\GrapeCityApp.MauiControls.csproj" />
	</ItemGroup>

</Project>
