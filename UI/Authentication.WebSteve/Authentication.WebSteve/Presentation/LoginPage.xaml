<Page x:Class="Authentication.WebSteve.Presentation.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Authentication.WebSteve.Presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      mc:Ignorable="d"
      NavigationCacheMode="Required"
      Background="{ThemeResource BackgroundBrush}">

  <Grid utu:SafeArea.Insets="VisibleBounds" RowDefinitions="Auto,*">

    <!-- Header: what this app is, and which head it is running on. -->
    <Border Grid.Row="0"
            Padding="16,12"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Web auth via Uno.Extensions"
                     Style="{StaticResource SubtitleTextBlockStyle}" />
          <TextBlock Text="AddWeb, configured entirely from the Web section of appsettings"
                     Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <Border Grid.Column="1"
                Padding="8,4"
                VerticalAlignment="Center"
                Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
          <TextBlock x:Name="PlatformChip"
                     FontSize="11"
                     FontWeight="SemiBold"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Border>
      </Grid>
    </Border>

    <ScrollViewer x:Name="RootScroll" Grid.Row="1">
      <StackPanel MaxWidth="920"
                  Padding="16"
                  Spacing="16">

        <!-- What the provider was handed; the redirect URI is derived per platform at runtime. -->
        <Border Style="{StaticResource CardStyle}">
          <StackPanel Spacing="14">
            <TextBlock Text="WEB PROVIDER CONFIGURATION (appsettings, section Web)"
                       Style="{StaticResource LabelTextStyle}" />

            <StackPanel Spacing="2">
              <TextBlock Text="Login page (LoginStartUri)" Style="{StaticResource LabelTextStyle}" />
              <TextBlock x:Name="LoginStartText" Style="{StaticResource CodeTextStyle}" />
            </StackPanel>

            <StackPanel Spacing="2">
              <TextBlock Text="Token keys on the redirect" Style="{StaticResource LabelTextStyle}" />
              <TextBlock x:Name="TokenKeysText" Style="{StaticResource CodeTextStyle}" />
            </StackPanel>

            <StackPanel Spacing="2">
              <TextBlock Text="Callback (LoginCallbackUri)" Style="{StaticResource LabelTextStyle}" />
              <TextBlock x:Name="RedirectText"
                         Style="{StaticResource CodeTextStyle}"
                         FontSize="13"
                         Foreground="{StaticResource FlowCallBrush}" />
              <TextBlock x:Name="SurfaceText"
                         Style="{StaticResource CodeTextStyle}"
                         Margin="0,4,0,0"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Button Content="Sign in"
                Command="{Binding Login}"
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Center" />

        <!-- Every authentication call, in order, with the reason it was made. -->
        <Border Style="{StaticResource CardStyle}">
          <StackPanel Spacing="12">
            <TextBlock Text="FLOW LOG" Style="{StaticResource LabelTextStyle}" />
            <ItemsControl x:Name="LogItems"
                          ItemTemplate="{StaticResource FlowStepTemplate}" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
