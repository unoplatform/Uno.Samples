<Page x:Class="NavigationViewShowcase.MainPage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:local="using:NavigationViewShowcase"
	  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

	<!--
		Every NavigationViewItem carries its one-line blurb in Tag, so selection
		can render the destination without a Frame or a lookup table.
	-->
	<NavigationView x:Name="Shell"
					AutomationProperties.AutomationId="Shell"
					PaneTitle="Contoso Ops"
					AlwaysShowHeader="True"
					IsBackButtonVisible="Collapsed"
					IsSettingsVisible="True"
					OverflowLabelMode="MoreLabel"
					Loaded="OnShellLoaded"
					SelectionChanged="OnShellSelectionChanged"
					DisplayModeChanged="OnShellDisplayModeChanged">

		<NavigationView.MenuItems>
			<NavigationViewItemHeader Content="Workspace" />

			<NavigationViewItem x:Name="DashboardItem"
								AutomationProperties.AutomationId="NavDashboard"
								Content="Dashboard"
								Tag="Today's shipments, incidents and on-call rotation at a glance.">
				<NavigationViewItem.Icon>
					<SymbolIcon Symbol="Home" />
				</NavigationViewItem.Icon>
			</NavigationViewItem>

			<NavigationViewItem AutomationProperties.AutomationId="NavAnalytics"
								Content="Analytics"
								Tag="Traffic, conversion and retention across every Contoso property.">
				<NavigationViewItem.Icon>
					<SymbolIcon Symbol="ShowResults" />
				</NavigationViewItem.Icon>
				<NavigationViewItem.MenuItems>
					<NavigationViewItem AutomationProperties.AutomationId="NavLiveTraffic"
										Content="Live traffic"
										Tag="Sessions, regions and referrers, refreshed every 30 seconds." />
					<NavigationViewItem AutomationProperties.AutomationId="NavConversions"
										Content="Conversions"
										Tag="Funnel drop-off by step, cohort and acquisition channel." />
				</NavigationViewItem.MenuItems>
			</NavigationViewItem>

			<NavigationViewItem AutomationProperties.AutomationId="NavProjects"
								Content="Projects"
								Tag="Everything the team is shipping this quarter.">
				<NavigationViewItem.Icon>
					<SymbolIcon Symbol="Folder" />
				</NavigationViewItem.Icon>
				<NavigationViewItem.MenuItems>
					<NavigationViewItem AutomationProperties.AutomationId="NavActiveProjects"
										Content="Active"
										Tag="14 projects in flight, 3 of them past their target date." />
					<NavigationViewItem AutomationProperties.AutomationId="NavArchivedProjects"
										Content="Archived"
										Tag="Read-only history, kept for audits and post-mortems." />
				</NavigationViewItem.MenuItems>
			</NavigationViewItem>

			<NavigationViewItemSeparator />

			<NavigationViewItem AutomationProperties.AutomationId="NavMessages"
								Content="Messages"
								Tag="Threads shared with the operations and support rotations.">
				<NavigationViewItem.Icon>
					<SymbolIcon Symbol="Message" />
				</NavigationViewItem.Icon>
			</NavigationViewItem>

			<NavigationViewItem AutomationProperties.AutomationId="NavCalendar"
								Content="Calendar"
								Tag="Release windows, code freezes and the maintenance calendar.">
				<NavigationViewItem.Icon>
					<SymbolIcon Symbol="Calendar" />
				</NavigationViewItem.Icon>
			</NavigationViewItem>

			<NavigationViewItem AutomationProperties.AutomationId="NavPeople"
								Content="People"
								Tag="Directory, on-call schedule and delegated permissions.">
				<NavigationViewItem.Icon>
					<SymbolIcon Symbol="People" />
				</NavigationViewItem.Icon>
			</NavigationViewItem>

			<NavigationViewItem AutomationProperties.AutomationId="NavDocuments"
								Content="Documents"
								Tag="Runbooks, contracts and the shared design library.">
				<NavigationViewItem.Icon>
					<SymbolIcon Symbol="Document" />
				</NavigationViewItem.Icon>
			</NavigationViewItem>

			<NavigationViewItem AutomationProperties.AutomationId="NavAutomations"
								Content="Automations"
								Tag="Scheduled jobs, webhooks and the alert escalation rules.">
				<NavigationViewItem.Icon>
					<SymbolIcon Symbol="Sync" />
				</NavigationViewItem.Icon>
			</NavigationViewItem>

			<NavigationViewItem AutomationProperties.AutomationId="NavIntegrations"
								Content="Integrations"
								Tag="Connected services, API keys and outbound event feeds.">
				<NavigationViewItem.Icon>
					<SymbolIcon Symbol="Globe" />
				</NavigationViewItem.Icon>
			</NavigationViewItem>
		</NavigationView.MenuItems>

		<NavigationView.FooterMenuItems>
			<NavigationViewItem AutomationProperties.AutomationId="NavHelp"
								Content="Help"
								Tag="Guides, keyboard shortcuts and how to reach support.">
				<NavigationViewItem.Icon>
					<SymbolIcon Symbol="Help" />
				</NavigationViewItem.Icon>
			</NavigationViewItem>
		</NavigationView.FooterMenuItems>

		<Grid Padding="28,20,28,28"
			  RowSpacing="20">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<Border Grid.Row="0"
					Padding="20,16"
					Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
					BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
					BorderThickness="1"
					CornerRadius="{ThemeResource OverlayCornerRadius}">
				<StackPanel Spacing="12">
					<TextBlock Foreground="{ThemeResource TextFillColorPrimaryBrush}"
							   Style="{ThemeResource BodyStrongTextBlockStyle}"
							   Text="Pane display mode" />
					<StackPanel Orientation="Horizontal"
								Spacing="12">
						<RadioButton x:Name="AutoPaneMode"
									 AutomationProperties.AutomationId="PaneModeAuto"
									 Checked="OnPaneModeChecked"
									 Content="Auto"
									 GroupName="PaneMode"
									 Tag="Auto" />
						<RadioButton AutomationProperties.AutomationId="PaneModeLeft"
									 Checked="OnPaneModeChecked"
									 Content="Left"
									 GroupName="PaneMode"
									 Tag="Left" />
						<RadioButton AutomationProperties.AutomationId="PaneModeLeftCompact"
									 Checked="OnPaneModeChecked"
									 Content="LeftCompact"
									 GroupName="PaneMode"
									 Tag="LeftCompact" />
						<RadioButton AutomationProperties.AutomationId="PaneModeLeftMinimal"
									 Checked="OnPaneModeChecked"
									 Content="LeftMinimal"
									 GroupName="PaneMode"
									 Tag="LeftMinimal" />
						<RadioButton AutomationProperties.AutomationId="PaneModeTop"
									 Checked="OnPaneModeChecked"
									 Content="Top"
									 GroupName="PaneMode"
									 Tag="Top" />
					</StackPanel>
					<TextBlock x:Name="DisplayModeText"
							   AutomationProperties.AutomationId="DisplayModeText"
							   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
							   Style="{ThemeResource CaptionTextBlockStyle}" />
				</StackPanel>
			</Border>

			<Border Grid.Row="1"
					Padding="24,20"
					Background="{ThemeResource LayerFillColorDefaultBrush}"
					BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
					BorderThickness="1"
					CornerRadius="{ThemeResource OverlayCornerRadius}">
				<StackPanel VerticalAlignment="Top"
							Spacing="10">
					<Rectangle Width="36"
							   Height="4"
							   HorizontalAlignment="Left"
							   Fill="{ThemeResource AccentFillColorDefaultBrush}"
							   RadiusX="2"
							   RadiusY="2" />
					<TextBlock x:Name="DestinationTitle"
							   AutomationProperties.AutomationId="DestinationTitle"
							   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
							   Style="{ThemeResource BodyStrongTextBlockStyle}" />
					<TextBlock x:Name="DestinationSummary"
							   AutomationProperties.AutomationId="DestinationSummary"
							   MaxWidth="520"
							   HorizontalAlignment="Left"
							   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
							   Style="{ThemeResource BodyTextBlockStyle}"
							   TextWrapping="Wrap" />
					<TextBlock MaxWidth="520"
							   Margin="0,8,0,0"
							   HorizontalAlignment="Left"
							   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
							   Style="{ThemeResource CaptionTextBlockStyle}"
							   Text="SelectionChanged swaps this panel in place — there is no Frame in the sample."
							   TextWrapping="Wrap" />
				</StackPanel>
			</Border>
		</Grid>
	</NavigationView>
</Page>
