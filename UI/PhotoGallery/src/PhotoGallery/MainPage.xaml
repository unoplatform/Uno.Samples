<Page x:Class="PhotoGallery.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:PhotoGallery"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid ColumnSpacing="16" Padding="24,20,24,24" RowSpacing="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="300" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.ColumnSpan="2" Spacing="4">
      <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Photo Gallery" />
      <TextBlock Style="{StaticResource BodyTextBlockStyle}"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 Text="Thirty frames, justified into even lines by LinedFlowLayout inside an ItemsView." />
    </StackPanel>

    <ItemsView x:Name="Gallery"
               Grid.Row="1"
               AutomationProperties.AutomationId="GalleryItemsView"
               ItemsSource="{x:Bind Photos}"
               SelectionMode="Single">
      <ItemsView.Layout>
        <LinedFlowLayout x:Name="GalleryLayout"
                         ItemsInfoRequested="OnItemsInfoRequested"
                         ItemsJustification="Start"
                         ItemsStretch="Fill"
                         LineHeight="220"
                         LineSpacing="8"
                         MinItemSpacing="8" />
      </ItemsView.Layout>
      <ItemsView.ItemTemplate>
        <DataTemplate x:DataType="local:Photo">
          <ItemContainer AutomationProperties.Name="{x:Bind Title}"
                         CornerRadius="{ThemeResource OverlayCornerRadius}">
            <Border CornerRadius="{ThemeResource OverlayCornerRadius}">
              <Border.Background>
                <ImageBrush ImageSource="{x:Bind Source}" Stretch="UniformToFill" />
              </Border.Background>
              <Grid VerticalAlignment="Bottom" Padding="12,24,12,10">
                <Grid.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0" />
                    <GradientStop Color="#99000000" Offset="1" />
                  </LinearGradientBrush>
                </Grid.Background>
                <StackPanel>
                  <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                             Foreground="White"
                             Text="{x:Bind Title}"
                             MaxLines="1" TextTrimming="CharacterEllipsis" />
                  <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                             Foreground="#CCFFFFFF"
                             Text="{x:Bind Place}"
                             MaxLines="1" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </Border>
          </ItemContainer>
        </DataTemplate>
      </ItemsView.ItemTemplate>
    </ItemsView>

    <Border Grid.Row="1"
            Grid.Column="1"
            Padding="20"
            VerticalAlignment="Top"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}">
      <StackPanel Spacing="16">
        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Layout" />

        <StackPanel Spacing="4">
          <Grid>
            <TextBlock Text="LineHeight" />
            <TextBlock HorizontalAlignment="Right"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind LineHeightSlider.Value, Mode=OneWay}" />
          </Grid>
          <Slider x:Name="LineHeightSlider"
                  AutomationProperties.AutomationId="LineHeightSlider"
                  Maximum="360"
                  Minimum="120"
                  StepFrequency="10"
                  ValueChanged="OnLineHeightChanged"
                  Value="220" />
        </StackPanel>

        <StackPanel Spacing="4">
          <Grid>
            <TextBlock Text="LineSpacing" />
            <TextBlock HorizontalAlignment="Right"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind LineSpacingSlider.Value, Mode=OneWay}" />
          </Grid>
          <Slider x:Name="LineSpacingSlider"
                  AutomationProperties.AutomationId="LineSpacingSlider"
                  Maximum="32"
                  Minimum="0"
                  StepFrequency="2"
                  ValueChanged="OnLineSpacingChanged"
                  Value="8" />
        </StackPanel>

        <StackPanel Spacing="4">
          <Grid>
            <TextBlock Text="MinItemSpacing" />
            <TextBlock HorizontalAlignment="Right"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind ItemSpacingSlider.Value, Mode=OneWay}" />
          </Grid>
          <Slider x:Name="ItemSpacingSlider"
                  AutomationProperties.AutomationId="MinItemSpacingSlider"
                  Maximum="32"
                  Minimum="0"
                  StepFrequency="2"
                  ValueChanged="OnItemSpacingChanged"
                  Value="8" />
        </StackPanel>

        <ComboBox x:Name="JustificationCombo"
                  HorizontalAlignment="Stretch"
                  AutomationProperties.AutomationId="ItemsJustificationComboBox"
                  Header="ItemsJustification"
                  SelectionChanged="OnJustificationChanged" />

        <ComboBox x:Name="StretchCombo"
                  HorizontalAlignment="Stretch"
                  AutomationProperties.AutomationId="ItemsStretchComboBox"
                  Header="ItemsStretch"
                  SelectionChanged="OnStretchChanged" />

        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <StackPanel Spacing="2">
          <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     Text="ActualLineHeight" />
          <TextBlock x:Name="ActualLineHeightText"
                     AutomationProperties.AutomationId="ActualLineHeightText"
                     Style="{StaticResource BodyStrongTextBlockStyle}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Page>
