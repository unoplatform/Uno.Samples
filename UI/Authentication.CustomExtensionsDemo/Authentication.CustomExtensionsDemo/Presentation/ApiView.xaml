<UserControl x:Class="Authentication.CustomExtensionsDemo.Presentation.ApiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ScrollViewer>
    <StackPanel MaxWidth="920"
                Padding="16"
                Spacing="16">

      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="10">
          <TextBlock Text="USING THE TOKEN" Style="{StaticResource LabelTextStyle}" />
          <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap">
            A token is only worth having if an API accepts it. This calls the demo server's
            protected /api/profile endpoint, which says whose access token it received, through the
            Kiota client registered inside UseHttp. The app never touches the token: the handler
            Uno.Extensions chains into that client adds the Authorization header, and on a 401 it
            runs the app's Refresh callback and retries once before giving up and clearing the
            session. Access tokens from the demo server live 60 seconds, so waiting a minute and
            calling again shows the refresh.
          </TextBlock>
          <TextBlock Style="{StaticResource CodeTextStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}">
            services.AddKiotaClient&lt;DemoServerClient&gt;(context, name: "DemoServer");   // inside UseHttp
          </TextBlock>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}"
              AutomationProperties.AutomationId="NeedsSignInCard"
              Background="#26D08700"
              BorderBrush="{StaticResource FlowWarningBrush}"
              Visibility="{Binding NeedsSignIn, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding SignInHint}"
                   Style="{StaticResource BodyTextBlockStyle}"
                   TextWrapping="Wrap" />
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Click="OnCallApiClick"
                AutomationProperties.AutomationId="CallApiButton"
                Content="GET /api/profile"
                IsEnabled="{Binding CanCall}"
                Style="{StaticResource AccentButtonStyle}" />
      </StackPanel>

      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="10">
          <TextBlock Text="RESULT" Style="{StaticResource LabelTextStyle}" />
          <TextBlock Text="{Binding Status}"
                     AutomationProperties.AutomationId="ApiStatus"
                     Style="{StaticResource BodyTextBlockStyle}"
                     TextWrapping="Wrap" />
          <ProgressBar AutomationProperties.AutomationId="ApiBusyBar"
                       IsIndeterminate="True"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}"
              Visibility="{Binding HasResponse, Converter={StaticResource BoolToVisibility}}">
        <StackPanel Spacing="10">
          <TextBlock Text="WHAT THE API SAW" Style="{StaticResource LabelTextStyle}" />
          <TextBlock Text="{Binding Body}"
                     AutomationProperties.AutomationId="ApiBody"
                     Style="{StaticResource CodeTextStyle}" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>

</UserControl>
