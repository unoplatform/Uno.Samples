<UserControl x:Class="LottieBuiltIn.LottieCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Microsoft.UI.Xaml.Controls"
             xmlns:lottie="using:CommunityToolkit.WinUI.Lottie"
             HorizontalContentAlignment="Stretch">
  <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="{StaticResource OverlayCornerRadius}"
          Padding="16">
    <Grid RowSpacing="12">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
              CornerRadius="{StaticResource ControlCornerRadius}">
        <controls:AnimatedVisualPlayer x:Name="Player"
                                       AutoPlay="True"
                                       Stretch="Uniform"
                                       Margin="12">
          <lottie:LottieVisualSource x:Name="Source" />
        </controls:AnimatedVisualPlayer>
      </Border>

      <StackPanel Grid.Row="1" Spacing="2">
        <TextBlock x:Name="TitleText" Style="{StaticResource BodyStrongTextBlockStyle}" />
        <TextBlock x:Name="CaptionText"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap"
                   MinHeight="32" />
      </StackPanel>

      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
        <Button x:Name="PlayButton" Click="OnPlay">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE768;" FontSize="14" />
            <TextBlock Text="Play" />
          </StackPanel>
        </Button>
        <Button x:Name="PauseButton" Click="OnPause">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE769;" FontSize="14" />
            <TextBlock Text="Pause" />
          </StackPanel>
        </Button>
        <Button x:Name="StopButton" Click="OnStop">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE71A;" FontSize="14" />
            <TextBlock Text="Stop" />
          </StackPanel>
        </Button>
      </StackPanel>

      <Slider x:Name="ProgressSlider"
              Grid.Row="3"
              Minimum="0"
              Maximum="1"
              StepFrequency="0.01"
              ValueChanged="OnProgressChanged" />
    </Grid>
  </Border>
</UserControl>
