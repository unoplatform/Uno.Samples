<Page x:Class="LottieBuiltIn.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:LottieBuiltIn"
      xmlns:controls="using:Microsoft.UI.Xaml.Controls"
      xmlns:visuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
      xmlns:generated="using:LottieBuiltIn.AnimatedVisuals"
      xmlns:lottie="using:CommunityToolkit.WinUI.Lottie"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <ScrollViewer>
    <Grid Padding="32,24" RowSpacing="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="300" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid ColumnSpacing="24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="4">
          <TextBlock Text="Lottie, built in" Style="{StaticResource TitleTextBlockStyle}" />
          <TextBlock Text="AnimatedVisualPlayer and LottieVisualSource ship inside Uno.WinUI. No package, no UnoFeature."
                     Style="{StaticResource BodyTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <Slider x:Name="SpeedSlider"
                Grid.Column="1"
                Header="PlaybackRate"
                Minimum="0.25"
                Maximum="2"
                StepFrequency="0.25"
                Value="1"
                TickFrequency="0.25"
                TickPlacement="Outside"
                ValueChanged="OnSpeedChanged"
                AutomationProperties.AutomationId="SpeedSlider" />
      </Grid>

      <Grid Grid.Row="1" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <local:LottieCard x:Name="LoaderCard"
                          Key="Loader"
                          Title="Bouncing loader"
                          Caption="Three shape layers with eased position and squash keyframes."
                          AnimationUri="ms-appx:///Assets/Lottie/bouncing-loader.json" />
        <local:LottieCard x:Name="CheckCard"
                          Grid.Column="1"
                          Key="Check"
                          Title="Checkmark draw-on"
                          Caption="Trim paths animate a stroked ring and a check."
                          AnimationUri="ms-appx:///Assets/Lottie/checkmark.json" />
        <local:LottieCard x:Name="HeartCard"
                          Grid.Column="2"
                          Key="Heart"
                          Title="Pulsing heart"
                          Caption="A bezier path with a double-beat scale and a fading pulse."
                          AnimationUri="ms-appx:///Assets/Lottie/pulsing-heart.json" />
      </Grid>

      <StackPanel Grid.Row="2" Spacing="2">
        <TextBlock Text="LottieGen output runs unmodified" Style="{StaticResource SubtitleTextBlockStyle}" />
        <TextBlock Text="The same animation twice: generated Composition code on the left, the raw JSON on the right."
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>

      <Grid Grid.Row="3" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="12">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="128" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="{StaticResource ControlCornerRadius}">
              <controls:AnimatedVisualPlayer x:Name="GenPlayer"
                                             AutoPlay="True"
                                             Stretch="Uniform"
                                             Margin="4"
                                             AutomationProperties.AutomationId="GenPlayer">
                <generated:Sunrise />
              </controls:AnimatedVisualPlayer>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="Compiled with LottieGen" Style="{StaticResource BodyStrongTextBlockStyle}" />
              <TextBlock Text="Sunrise.cs is an IAnimatedVisualSource built from Composition gradients, color keyframes, trim paths and expression animations. No JSON parsing at runtime."
                         Style="{StaticResource CaptionTextBlockStyle}"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="12">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="128" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="{StaticResource ControlCornerRadius}">
              <controls:AnimatedVisualPlayer x:Name="JsonPlayer"
                                             AutoPlay="True"
                                             Stretch="Uniform"
                                             Margin="4"
                                             AutomationProperties.AutomationId="JsonPlayer">
                <lottie:LottieVisualSource UriSource="ms-appx:///Assets/Lottie/sunrise.json" />
              </controls:AnimatedVisualPlayer>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="Loaded from JSON" Style="{StaticResource BodyStrongTextBlockStyle}" />
              <TextBlock Text="The same sunrise.json parsed at runtime by LottieVisualSource and drawn by the Skottie renderer."
                         Style="{StaticResource CaptionTextBlockStyle}"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <StackPanel Grid.Row="4" Spacing="2">
        <TextBlock Text="WinUI's own animations" Style="{StaticResource SubtitleTextBlockStyle}" />
        <TextBlock Text="ProgressRing and AnimatedIcon now play the same ported visuals as on Windows."
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>

      <Grid Grid.Row="5" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource CardBorder}">
          <StackPanel Orientation="Horizontal" Spacing="16">
            <ProgressRing IsActive="True"
                          Width="64"
                          Height="64"
                          AutomationProperties.AutomationId="IndeterminateRing" />
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="Indeterminate" Style="{StaticResource BodyStrongTextBlockStyle}" />
              <TextBlock Text="IsActive = True"
                         Style="{StaticResource CaptionTextBlockStyle}"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource CardBorder}">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ProgressRing IsIndeterminate="False"
                          Minimum="0"
                          Maximum="100"
                          Value="{x:Bind RingSlider.Value, Mode=OneWay}"
                          Width="64"
                          Height="64"
                          AutomationProperties.AutomationId="DeterminateRing" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                         Text="{x:Bind local:MainPage.FormatPercent(RingSlider.Value), Mode=OneWay}"
                         AutomationProperties.AutomationId="DeterminateValue" />
              <Slider x:Name="RingSlider"
                      Minimum="0"
                      Maximum="100"
                      Value="65"
                      AutomationProperties.AutomationId="RingSlider" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource CardBorder}">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Width="64"
                    Height="64"
                    AutomationProperties.AutomationId="AnimatedSettingsButton"
                    AutomationProperties.Name="Settings">
              <controls:AnimatedIcon Width="32" Height="32">
                <controls:AnimatedIcon.Source>
                  <visuals:AnimatedSettingsVisualSource />
                </controls:AnimatedIcon.Source>
                <controls:AnimatedIcon.FallbackIconSource>
                  <controls:SymbolIconSource Symbol="Setting" />
                </controls:AnimatedIcon.FallbackIconSource>
              </controls:AnimatedIcon>
            </Button>
            <Button Width="64"
                    Height="64"
                    AutomationProperties.AutomationId="AnimatedBackButton"
                    AutomationProperties.Name="Back">
              <controls:AnimatedIcon Width="32" Height="32">
                <controls:AnimatedIcon.Source>
                  <visuals:AnimatedBackVisualSource />
                </controls:AnimatedIcon.Source>
                <controls:AnimatedIcon.FallbackIconSource>
                  <controls:SymbolIconSource Symbol="Back" />
                </controls:AnimatedIcon.FallbackIconSource>
              </controls:AnimatedIcon>
            </Button>
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="AnimatedIcon" Style="{StaticResource BodyStrongTextBlockStyle}" />
              <TextBlock Text="Hover or press a button"
                         Style="{StaticResource CaptionTextBlockStyle}"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</Page>
