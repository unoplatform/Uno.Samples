<UserControl x:Class="TextScalingShowcase.ProfileCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:TextScalingShowcase"
             AutomationProperties.AutomationId="ProfileCard">

    <Border MaxWidth="660"
            Padding="20"
            HorizontalAlignment="Left"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <StackPanel Spacing="10">

            <StackPanel Orientation="Horizontal" Spacing="14">
                <Grid Width="52" Height="52">
                    <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                               Text="MZ" />
                </Grid>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock AutomationProperties.AutomationId="ProfileName"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Text="Martin Zikmund" />
                    <TextBlock FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Product designer · Brno" />
                </StackPanel>
            </StackPanel>

            <TextBlock FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="The same 14 pt line twice — the right one sets IsTextScaleFactorEnabled=&quot;False&quot;"
                       TextWrapping="Wrap" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Padding="12"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        CornerRadius="6">
                    <TextBlock AutomationProperties.AutomationId="ScaledSample"
                               FontSize="14"
                               Text="Two-factor authentication is on."
                               TextWrapping="Wrap" />
                </Border>
                <Border Grid.Column="1"
                        Padding="12"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        CornerRadius="6">
                    <TextBlock AutomationProperties.AutomationId="PinnedSample"
                               FontSize="14"
                               IsTextScaleFactorEnabled="False"
                               Text="Two-factor authentication is on."
                               TextWrapping="Wrap" />
                </Border>
            </Grid>

            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <StackPanel Spacing="4">
                <TextBlock FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Display name" />
                <TextBox AutomationProperties.AutomationId="DisplayNameBox" Text="Martin Zikmund" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Email" />
                <TextBox AutomationProperties.AutomationId="EmailBox" Text="martin@contoso.com" />
            </StackPanel>

            <ToggleSwitch AutomationProperties.AutomationId="NotificationsToggle"
                          Header="Email notifications"
                          IsOn="True"
                          OffContent="Off"
                          OnContent="On" />

            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <TextBlock FontSize="14"
                       FontWeight="SemiBold"
                       Text="Recent activity" />
            <ListView AutomationProperties.AutomationId="ActivityList"
                      Padding="0"
                      SelectionMode="None">
                <ListViewItem AutomationProperties.AutomationId="ActivityItem1">
                    <StackPanel Spacing="2">
                        <TextBlock FontSize="14" Text="Signed in from a new device" />
                        <TextBlock FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Yesterday at 21:14 · Surface Laptop" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem AutomationProperties.AutomationId="ActivityItem2">
                    <StackPanel Spacing="2">
                        <TextBlock FontSize="14" Text="Recovery e-mail confirmed" />
                        <TextBlock FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Monday at 08:02 · Web" />
                    </StackPanel>
                </ListViewItem>
            </ListView>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button AutomationProperties.AutomationId="SaveButton"
                        Content="Save changes"
                        Style="{StaticResource AccentButtonStyle}" />
                <Button AutomationProperties.AutomationId="CancelButton" Content="Cancel" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
