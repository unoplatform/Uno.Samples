<Page x:Class="ScrollViewerZoom.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ScrollViewerZoom"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

  <Page.Resources>
    <Style x:Key="RoomStyle" TargetType="Rectangle">
      <Setter Property="Fill" Value="{ThemeResource LayerFillColorDefaultBrush}" />
      <Setter Property="Stroke" Value="{ThemeResource TextFillColorSecondaryBrush}" />
      <Setter Property="StrokeThickness" Value="3" />
    </Style>

    <Style x:Key="WetRoomStyle" TargetType="Rectangle" BasedOn="{StaticResource RoomStyle}">
      <Setter Property="Fill" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="FurnitureStyle" TargetType="Rectangle">
      <Setter Property="Fill" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
      <Setter Property="Stroke" Value="{ThemeResource TextFillColorTertiaryBrush}" />
      <Setter Property="StrokeThickness" Value="1.5" />
    </Style>

    <Style x:Key="FurnitureEllipseStyle" TargetType="Ellipse">
      <Setter Property="Fill" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
      <Setter Property="Stroke" Value="{ThemeResource TextFillColorTertiaryBrush}" />
      <Setter Property="StrokeThickness" Value="1.5" />
    </Style>

    <Style x:Key="RoomNameStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="RoomAreaStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- Only legible once zoomed in — this is what makes the zoom worth doing. -->
    <Style x:Key="FinePrintStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="7" />
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
    </Style>

    <Style x:Key="DimensionLineStyle" TargetType="Line">
      <Setter Property="Stroke" Value="{ThemeResource AccentFillColorDefaultBrush}" />
      <Setter Property="StrokeThickness" Value="1.5" />
    </Style>

    <Style x:Key="ThinLineStyle" TargetType="Line">
      <Setter Property="Stroke" Value="{ThemeResource TextFillColorTertiaryBrush}" />
      <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <Style x:Key="DoorStyle" TargetType="Path">
      <Setter Property="Stroke" Value="{ThemeResource TextFillColorTertiaryBrush}" />
      <Setter Property="StrokeThickness" Value="1.5" />
    </Style>
  </Page.Resources>

  <Grid RowSpacing="12" Padding="20,16,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Spacing="2">
      <TextBlock AutomationProperties.AutomationId="PageTitleText"
                 Style="{StaticResource TitleTextBlockStyle}"
                 Text="ScrollViewer zoom" />
      <TextBlock AutomationProperties.AutomationId="PageSubtitleText"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 Style="{StaticResource BodyTextBlockStyle}"
                 Text="A plain ScrollViewer with ZoomMode=&quot;Enabled&quot;. Pinch, Ctrl+wheel and Ctrl+plus/minus now zoom on Skia targets." />
    </StackPanel>

    <!-- Toolbar -->
    <Grid Grid.Row="1" ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
        <Button AutomationProperties.AutomationId="ZoomFitButton"
                Click="OnZoomToFit"
                Content="Fit" />
        <Button AutomationProperties.AutomationId="Zoom1xButton"
                Click="OnZoomToPreset"
                Content="1x"
                Tag="1" />
        <Button AutomationProperties.AutomationId="Zoom2xButton"
                Click="OnZoomToPreset"
                Content="2x"
                Tag="2" />
        <Button AutomationProperties.AutomationId="Zoom4xButton"
                Click="OnZoomToPreset"
                Content="4x"
                Tag="4" />
      </StackPanel>

      <Border Grid.Column="2"
              Padding="14,6"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="6">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     Style="{StaticResource CaptionTextBlockStyle}"
                     Text="ZoomFactor"
                     VerticalAlignment="Center" />
          <TextBlock x:Name="ZoomFactorText"
                     AutomationProperties.AutomationId="ZoomFactorText"
                     FontFamily="Consolas"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                     Text="1.00x"
                     VerticalAlignment="Center" />
          <TextBlock AutomationProperties.AutomationId="ZoomRangeText"
                     Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                     Style="{StaticResource CaptionTextBlockStyle}"
                     Text="0.5x – 6x"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>

