<Application x:Class="Authentication.OidcSteve.App"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:common="using:Authentication.OidcSteve.Common"
       xmlns:utus="using:Uno.Toolkit.UI.Simple">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Load WinUI resources -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <utus:SimpleToolkitTheme xmlns:utus="using:Uno.Toolkit.UI.Simple" />
      </ResourceDictionary.MergedDictionaries>

      <common:BoolToVisibilityConverter x:Key="BoolToVisibility" />
      <common:FlowStepKindToBrushConverter x:Key="FlowStepKindToBrush" />

      <!--
        A monospaced family is listed per platform; Uno falls back to the default font when none
        of them resolve, which only affects how token and JSON text lines up.
      -->
      <FontFamily x:Key="CodeFontFamily">Menlo, Consolas, Courier New, monospace</FontFamily>

      <!-- Flow log accents, chosen to stay readable in both light and dark themes. -->
      <SolidColorBrush x:Key="FlowInfoBrush" Color="#8A8A8E" />
      <SolidColorBrush x:Key="FlowCallBrush" Color="#3B82F6" />
      <SolidColorBrush x:Key="FlowSuccessBrush" Color="#22A06B" />
      <SolidColorBrush x:Key="FlowWarningBrush" Color="#D08700" />
      <SolidColorBrush x:Key="FlowErrorBrush" Color="#E5484D" />

      <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
      </Style>

      <Style x:Key="CodeTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CodeFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>

      <Style x:Key="LabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="80" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
      </Style>

      <!-- One entry of the authentication flow log, shared by the Login and Main pages. -->
      <DataTemplate x:Key="FlowStepTemplate">
        <Grid Margin="0,0,0,12"
              ColumnDefinitions="16,Auto,*"
              ColumnSpacing="8">
          <TextBlock Grid.Column="0"
                     Text="{Binding Glyph}"
                     FontWeight="Bold"
                     Foreground="{Binding Kind, Converter={StaticResource FlowStepKindToBrush}}" />
          <TextBlock Grid.Column="1"
                     Text="{Binding Time}"
                     Style="{StaticResource CodeTextStyle}"
                     Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
          <StackPanel Grid.Column="2" Spacing="3">
            <TextBlock Text="{Binding Title}"
                       Style="{StaticResource BodyStrongTextBlockStyle}"
                       Foreground="{Binding Kind, Converter={StaticResource FlowStepKindToBrush}}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding Detail}"
                       Style="{StaticResource CodeTextStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
        </Grid>
      </DataTemplate>

    </ResourceDictionary>
  </Application.Resources>

</Application>
