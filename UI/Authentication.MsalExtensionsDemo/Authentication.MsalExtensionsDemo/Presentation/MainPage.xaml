<Page x:Class="Authentication.MsalExtensionsDemo.Presentation.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:toolkit="using:Uno.UI.Toolkit"
      xmlns:views="using:Authentication.MsalExtensionsDemo.Presentation"
      NavigationCacheMode="Required"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

  <Grid RowDefinitions="Auto,*">

    <!-- PaddingMask keeps the header clear of the status bar / notch on mobile. -->
    <Border Grid.Row="0"
            Padding="16,12"
            toolkit:VisibleBoundsPadding.PaddingMask="Top"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="MSAL on Uno Platform"
                     Style="{StaticResource SubtitleTextBlockStyle}" />
          <TextBlock Text="Uno.Extensions.Authentication.MSAL, configured from appsettings"
                     Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <Border Grid.Column="1"
                Padding="8,4"
                VerticalAlignment="Center"
                Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
          <TextBlock x:Name="PlatformChip"
                     FontSize="11"
                     FontWeight="SemiBold"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Border>
      </Grid>
    </Border>

    <!--
      The three views are all kept alive and toggled, rather than navigated to with a Frame, so
      the flow log and the Graph response survive switching pages.
    -->
    <NavigationView x:Name="Nav"
                    Grid.Row="1"
                    IsBackButtonVisible="Collapsed"
                    IsPaneToggleButtonVisible="False"
                    IsSettingsVisible="False"
                    PaneDisplayMode="Top"
                    SelectionChanged="OnSectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Sign in" IsSelected="True" Tag="signin" />
        <NavigationViewItem Content="Microsoft Graph" Tag="graph" />
        <NavigationViewItem Content="Platform setup" Tag="setup" />
      </NavigationView.MenuItems>

      <Grid>
        <views:SignInView x:Name="SignInSection" DataContext="{Binding SignIn}" />
        <views:GraphView x:Name="GraphSection" DataContext="{Binding Graph}" Visibility="Collapsed" />
        <views:PlatformSetupView x:Name="SetupSection" DataContext="{Binding Setup}" Visibility="Collapsed" />
      </Grid>
    </NavigationView>

  </Grid>

</Page>
