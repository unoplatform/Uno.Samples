<UserControl x:Class="Authentication.MsalExtensionsDemo.Presentation.SignInView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ScrollViewer x:Name="RootScroll">
    <StackPanel MaxWidth="920"
                Padding="16"
                Spacing="16">

      <!-- Shown until the MsalAuthentication section contains a real client ID. -->
      <Border Style="{StaticResource CardStyle}"
              Background="#26D08700"
              BorderBrush="{StaticResource FlowWarningBrush}"
              Visibility="{Binding IsNotConfigured, Converter={StaticResource BoolToVisibility}}">
        <StackPanel Spacing="6">
          <TextBlock Text="No app registration configured"
                     Style="{StaticResource BodyStrongTextBlockStyle}" />
          <TextBlock Text="{Binding ConfigurationWarning}"
                     Style="{StaticResource BodyTextBlockStyle}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!--
        What the provider was handed. The redirect URI is derived per platform and is the value
        that has to be registered in Entra ID, so it is front and centre.
      -->
      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="14">
          <TextBlock Text="MSAL CONFIGURATION (appsettings, section MsalAuthentication)"
                     Style="{StaticResource LabelTextStyle}" />

          <StackPanel Spacing="2">
            <TextBlock Text="Running on" Style="{StaticResource LabelTextStyle}" />
            <TextBlock Text="{Binding PlatformName}" Style="{StaticResource BodyTextBlockStyle}" />
          </StackPanel>

          <StackPanel Spacing="2">
            <TextBlock Text="Client ID" Style="{StaticResource LabelTextStyle}" />
            <TextBlock Text="{Binding ClientIdDisplay}" Style="{StaticResource CodeTextStyle}" />
          </StackPanel>

          <StackPanel Spacing="2">
            <TextBlock Text="Tenant" Style="{StaticResource LabelTextStyle}" />
            <TextBlock Text="{Binding TenantDisplay}" Style="{StaticResource CodeTextStyle}" />
          </StackPanel>

          <StackPanel Spacing="2">
            <TextBlock Text="Scopes" Style="{StaticResource LabelTextStyle}" />
            <TextBlock Text="{Binding ScopesDisplay}" Style="{StaticResource CodeTextStyle}" />
          </StackPanel>

          <StackPanel Spacing="2">
            <TextBlock Text="Redirect URI to register" Style="{StaticResource LabelTextStyle}" />
            <TextBlock Text="{Binding RedirectUri}"
                       Style="{StaticResource CodeTextStyle}"
                       FontSize="13"
                       Foreground="{StaticResource FlowCallBrush}" />
            <TextBlock Text="{Binding RedirectUriSource}"
                       Style="{StaticResource CodeTextStyle}"
                       Margin="0,4,0,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Actions. Horizontally scrollable so the row survives narrow phone screens. -->
      <ScrollViewer HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Auto"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Click="OnSignInClick"
                  Content="Sign in"
                  IsEnabled="{Binding IsNotBusy}"
                  Style="{StaticResource AccentButtonStyle}" />
          <Button Click="OnRefreshClick"
                  Content="Silent only"
                  IsEnabled="{Binding IsNotBusy}" />
          <Button Click="OnSignOutClick"
                  Content="Sign out"
                  IsEnabled="{Binding IsNotBusy}" />
          <Button Click="OnClearLogClick"
                  Content="Clear log" />
        </StackPanel>
      </ScrollViewer>

      <!-- Result of the last acquisition. -->
      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="10">
          <TextBlock Text="TOKEN" Style="{StaticResource LabelTextStyle}" />
          <TextBlock Text="{Binding StatusHeadline}"
                     Style="{StaticResource SubtitleTextBlockStyle}"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding ResultDetail}" Style="{StaticResource CodeTextStyle}" />
          <TextBlock Text="{Binding TokensSummary}"
                     Style="{StaticResource CodeTextStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <ProgressBar IsIndeterminate="True"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </Border>

      <!-- Every authentication call, in order, with the reason it was made. -->
      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="12">
          <TextBlock Text="FLOW LOG" Style="{StaticResource LabelTextStyle}" />
          <ItemsControl ItemsSource="{Binding Log}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,12"
                      ColumnDefinitions="16,Auto,*"
                      ColumnSpacing="8">
                  <TextBlock Grid.Column="0"
                             Text="{Binding Glyph}"
                             FontWeight="Bold"
                             Foreground="{Binding Kind, Converter={StaticResource FlowStepKindToBrush}}" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding Time}"
                             Style="{StaticResource CodeTextStyle}"
                             Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                  <StackPanel Grid.Column="2" Spacing="3">
                    <TextBlock Text="{Binding Title}"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Foreground="{Binding Kind, Converter={StaticResource FlowStepKindToBrush}}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}"
                               Style="{StaticResource CodeTextStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>

</UserControl>
