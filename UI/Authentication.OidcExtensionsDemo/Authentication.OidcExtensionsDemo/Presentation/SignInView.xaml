<UserControl x:Class="Authentication.OidcExtensionsDemo.Presentation.SignInView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ScrollViewer x:Name="RootScroll">
    <StackPanel MaxWidth="920"
                Padding="16"
                Spacing="16">

      <!--
        What the provider was handed. The redirect URI is derived per platform by the
        WebAuthenticationBroker (AutoRedirectUriFromWebAuthenticationBroker), so it is shown live.
      -->
      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="14">
          <TextBlock Text="OIDC CONFIGURATION (App.xaml.cs, AddOidc)"
                     Style="{StaticResource LabelTextStyle}" />

          <StackPanel Spacing="2">
            <TextBlock Text="Running on" Style="{StaticResource LabelTextStyle}" />
            <TextBlock Text="{Binding PlatformName}" Style="{StaticResource BodyTextBlockStyle}" />
          </StackPanel>

          <StackPanel Spacing="2">
            <TextBlock Text="Authority" Style="{StaticResource LabelTextStyle}" />
            <TextBlock Text="{Binding Authority}" Style="{StaticResource CodeTextStyle}" />
          </StackPanel>

          <StackPanel Spacing="2">
            <TextBlock Text="Client" Style="{StaticResource LabelTextStyle}" />
            <TextBlock Text="{Binding ClientDisplay}" Style="{StaticResource CodeTextStyle}" />
          </StackPanel>

          <StackPanel Spacing="2">
            <TextBlock Text="Scope" Style="{StaticResource LabelTextStyle}" />
            <TextBlock Text="{Binding ScopeDisplay}" Style="{StaticResource CodeTextStyle}" />
          </StackPanel>

          <StackPanel Spacing="2">
            <TextBlock Text="Redirect URI (broker-derived)" Style="{StaticResource LabelTextStyle}" />
            <TextBlock Text="{Binding RedirectUri}"
                       Style="{StaticResource CodeTextStyle}"
                       FontSize="13"
                       Foreground="{StaticResource FlowCallBrush}" />
            <TextBlock Text="{Binding SignInSurface}"
                       Style="{StaticResource CodeTextStyle}"
                       Margin="0,4,0,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Actions. Horizontally scrollable so the row survives narrow phone screens. -->
      <ScrollViewer HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Auto"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Click="OnSignInClick"
                  Content="Sign in"
                  IsEnabled="{Binding IsNotBusy}"
                  Style="{StaticResource AccentButtonStyle}" />
          <Button Click="OnRefreshClick"
                  Content="Silent only"
                  IsEnabled="{Binding IsNotBusy}" />
          <Button Click="OnCallApiClick"
                  Content="Call demo API"
                  IsEnabled="{Binding IsNotBusy}" />
          <Button Click="OnSignOutClick"
                  Content="Sign out"
                  IsEnabled="{Binding IsNotBusy}" />
          <Button Click="OnClearLogClick"
                  Content="Clear log" />
        </StackPanel>
      </ScrollViewer>

      <!-- Result of the last acquisition. -->
      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="10">
          <TextBlock Text="TOKEN" Style="{StaticResource LabelTextStyle}" />
          <TextBlock Text="{Binding StatusHeadline}"
                     Style="{StaticResource SubtitleTextBlockStyle}"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding ResultDetail}" Style="{StaticResource CodeTextStyle}" />
          <TextBlock Text="{Binding TokensSummary}"
                     Style="{StaticResource CodeTextStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <ProgressBar IsIndeterminate="True"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </Border>

      <!-- The demo server's test API echoes the token's claims - proof the token works. -->
      <Border Style="{StaticResource CardStyle}"
              Visibility="{Binding HasApiResponse, Converter={StaticResource BoolToVisibility}}">
        <StackPanel Spacing="10">
          <TextBlock Text="DEMO API RESPONSE (GET /api/test)" Style="{StaticResource LabelTextStyle}" />
          <TextBlock Text="{Binding ApiResponse}"
                     Style="{StaticResource CodeTextStyle}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Every authentication call, in order, with the reason it was made. -->
      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="12">
          <TextBlock Text="FLOW LOG" Style="{StaticResource LabelTextStyle}" />
          <ItemsControl ItemsSource="{Binding Log}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,12"
                      ColumnDefinitions="16,Auto,*"
                      ColumnSpacing="8">
                  <TextBlock Grid.Column="0"
                             Text="{Binding Glyph}"
                             FontWeight="Bold"
                             Foreground="{Binding Kind, Converter={StaticResource FlowStepKindToBrush}}" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding Time}"
                             Style="{StaticResource CodeTextStyle}"
                             Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                  <StackPanel Grid.Column="2" Spacing="3">
                    <TextBlock Text="{Binding Title}"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Foreground="{Binding Kind, Converter={StaticResource FlowStepKindToBrush}}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}"
                               Style="{StaticResource CodeTextStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>

</UserControl>
