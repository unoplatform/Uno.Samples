<UserControl x:Class="Authentication.OidcExtensionsDemo.Presentation.ApiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ScrollViewer>
    <StackPanel MaxWidth="920"
                Padding="16"
                Spacing="16">

      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="10">
          <TextBlock Text="USING THE TOKEN" Style="{StaticResource LabelTextStyle}" />
          <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap">
            A token is only worth having if an API accepts it. This calls the demo server's
            protected /api/test endpoint, which echoes the claims of the access token it receives,
            through a Refit client registered inside UseHttp. The app never touches the token:
            the handler Uno.Extensions chains into that client adds the Authorization header, and
            on a 401 it refreshes the token and retries once before giving up and clearing the
            session.
          </TextBlock>
          <TextBlock Style="{StaticResource CodeTextStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}">
            services.AddRefitClient&lt;IDemoApi&gt;(context);   // inside UseHttp, in App.xaml.cs
          </TextBlock>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}"
              AutomationProperties.AutomationId="NeedsSignInCard"
              Background="#26D08700"
              BorderBrush="{StaticResource FlowWarningBrush}"
              Visibility="{Binding NeedsSignIn, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding SignInHint}"
                   Style="{StaticResource BodyTextBlockStyle}"
                   TextWrapping="Wrap" />
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Click="OnCallApiClick"
                AutomationProperties.AutomationId="CallApiButton"
                Content="GET /api/test"
                IsEnabled="{Binding CanCall}"
                Style="{StaticResource AccentButtonStyle}" />
      </StackPanel>

      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="10">
          <TextBlock Text="RESULT" Style="{StaticResource LabelTextStyle}" />
          <TextBlock Text="{Binding Status}"
                     AutomationProperties.AutomationId="ApiStatus"
                     Style="{StaticResource BodyTextBlockStyle}"
                     TextWrapping="Wrap" />
          <ProgressBar AutomationProperties.AutomationId="ApiBusyBar"
                       IsIndeterminate="True"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}"
              Visibility="{Binding HasResponse, Converter={StaticResource BoolToVisibility}}">
        <StackPanel Spacing="10">
          <TextBlock Text="CLAIMS THE API SAW" Style="{StaticResource LabelTextStyle}" />
          <TextBlock Text="{Binding Claims}"
                     AutomationProperties.AutomationId="ApiClaims"
                     Style="{StaticResource CodeTextStyle}" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>

</UserControl>
