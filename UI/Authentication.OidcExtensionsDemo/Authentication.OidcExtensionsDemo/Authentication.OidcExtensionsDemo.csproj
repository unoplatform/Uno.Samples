<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-browserwasm;net10.0-desktop</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>Authentication.OidcExtensionsDemo</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.companyname.authentication-oidcextensionsdemo</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>Authentication.OidcExtensionsDemo</ApplicationPublisher>
    <!-- Package Description -->
    <Description>Authentication.OidcExtensionsDemo powered by Uno Platform.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      SimpleTheme;
      Hosting;
      Toolkit;
      Logging;
      MVUX;
      Configuration;
      HttpRefit;
      Serialization;
      Localization;
      AuthenticationOidc;
      Navigation;
      ThemeService;
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

  <!--
    Debug builds carry Uno's Hot Design and App MCP tooling, whose current packages still reference
    Uno.UI.Lottie, which Uno.WinUI 7.0.0-dev.2509 (pinned by Uno.Sdk 7.0.0-dev.115) no longer ships:
    without this package a Debug build fails at startup with FileNotFoundException for Uno.UI.Lottie
    (unoplatform/uno.extensions#3262). Remove once those tooling packages ship without the reference.
  -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Uno.WinUI.Lottie" />
  </ItemGroup>

</Project>
