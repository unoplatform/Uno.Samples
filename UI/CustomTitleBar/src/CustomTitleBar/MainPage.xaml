<Page x:Class="CustomTitleBar.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid x:Name="AppTitleBar"
          AutomationProperties.AutomationId="AppTitleBar"
          Height="48"
          Padding="8,0,148,0"
          ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Button x:Name="BackButton"
              AutomationProperties.AutomationId="BackButton"
              AutomationProperties.Name="Back"
              Style="{StaticResource SubtleButtonStyle}"
              Width="40" Height="32" Padding="0"
              Visibility="{x:Bind ContentFrame.CanGoBack, Mode=OneWay}"
              Click="OnBackClick">
        <FontIcon Glyph="&#xE72B;" FontSize="14" />
      </Button>
      <Button x:Name="PaneToggleButton"
              Grid.Column="1"
              AutomationProperties.AutomationId="PaneToggleButton"
              AutomationProperties.Name="Toggle navigation pane"
              Style="{StaticResource SubtleButtonStyle}"
              Width="40" Height="32" Padding="0"
              Click="OnPaneToggleClick">
        <FontIcon Glyph="&#xE700;" FontSize="14" />
      </Button>
      <FontIcon Grid.Column="2" Glyph="&#xE70B;" FontSize="16" Margin="4,0,0,0"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock AutomationProperties.AutomationId="AppTitle" Text="Field Notes" Style="{StaticResource BodyStrongTextBlockStyle}" />
        <TextBlock Text="Preview" Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
      </StackPanel>

      <AutoSuggestBox x:Name="SearchBox"
                      Grid.Column="4"
                      AutomationProperties.AutomationId="SearchBox"
                      Width="360"
                      VerticalAlignment="Center"
                      PlaceholderText="Search notes and tags"
                      QueryIcon="Find"
                      TextChanged="OnSearchTextChanged"
                      SuggestionChosen="OnSuggestionChosen"
                      QuerySubmitted="OnQuerySubmitted" />

      <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <Button x:Name="NewNoteButton"
                AutomationProperties.AutomationId="NewNoteButton"
                AutomationProperties.Name="New note"
                Style="{StaticResource AccentButtonStyle}"
                Padding="12,4"
                Click="OnNewNoteClick">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE710;" FontSize="12" />
            <TextBlock Text="New note" />
          </StackPanel>
        </Button>
        <PersonPicture x:Name="Avatar"
                       AutomationProperties.AutomationId="Avatar"
                       Width="28" Height="28"
                       DisplayName="Ada Novak" />
      </StackPanel>
    </Grid>

    <NavigationView x:Name="NavView"
                    Grid.Row="1"
                    AutomationProperties.AutomationId="NavView"
                    PaneDisplayMode="Left"
                    OpenPaneLength="260"
                    IsBackButtonVisible="Collapsed"
                    IsPaneToggleButtonVisible="False"
                    IsSettingsVisible="False"
                    SelectionChanged="OnNavSelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Home" Tag="Home" AutomationProperties.AutomationId="NavHome">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Notes" Tag="Notes" AutomationProperties.AutomationId="NavNotes">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE70B;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Tags" Tag="Tags" AutomationProperties.AutomationId="NavTags">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE8EC;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems>
        <NavigationViewItem Content="Settings" Tag="Settings" AutomationProperties.AutomationId="NavSettings">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.FooterMenuItems>
      <Frame x:Name="ContentFrame" AutomationProperties.AutomationId="ContentFrame" />
    </NavigationView>
  </Grid>
</Page>
