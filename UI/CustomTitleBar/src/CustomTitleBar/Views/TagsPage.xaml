<Page x:Class="CustomTitleBar.Views.TagsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer>
    <Grid Padding="32,24" RowSpacing="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel Spacing="4">
        <TextBlock AutomationProperties.AutomationId="PageHeader" Text="Tags" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock Text="Organize notes across notebooks." Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
      <Grid Grid.Row="1" ColumnSpacing="16" RowSpacing="16" VerticalAlignment="Top">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Grid.Column="0" Padding="16" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <StackPanel Spacing="8">
            <FontIcon Glyph="&#xE8EC;" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Text="#birds" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock Text="9 notes" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </Border>
        <Border Grid.Row="0" Grid.Column="1" Padding="16" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <StackPanel Spacing="8">
            <FontIcon Glyph="&#xE8EC;" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Text="#trails" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock Text="6 notes" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </Border>
        <Border Grid.Row="0" Grid.Column="2" Padding="16" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <StackPanel Spacing="8">
            <FontIcon Glyph="&#xE8EC;" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Text="#soil" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock Text="4 notes" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Grid.Column="0" Padding="16" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <StackPanel Spacing="8">
            <FontIcon Glyph="&#xE8EC;" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Text="#fungi" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock Text="3 notes" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Grid.Column="1" Padding="16" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <StackPanel Spacing="8">
            <FontIcon Glyph="&#xE8EC;" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Text="#weather" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock Text="5 notes" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Grid.Column="2" Padding="16" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <StackPanel Spacing="8">
            <FontIcon Glyph="&#xE8EC;" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Text="#equipment" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock Text="2 notes" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</Page>
