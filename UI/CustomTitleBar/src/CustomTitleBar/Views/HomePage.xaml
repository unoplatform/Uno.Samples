<Page x:Class="CustomTitleBar.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer>
    <Grid Padding="32,24" RowSpacing="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel Spacing="4">
        <TextBlock AutomationProperties.AutomationId="PageHeader" Text="Good morning, Ada" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock Text="Pick up where you left off." Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
      <Grid Grid.Row="1" ColumnSpacing="16" RowSpacing="16" VerticalAlignment="Top">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Grid.Column="0" Padding="16" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <StackPanel Spacing="8">
            <FontIcon Glyph="&#xE707;" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Text="Trail map - Alder Ridge" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock Text="Edited today. Switchbacks above the creek are washed out; reroute marked in orange." Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </Border>
        <Border Grid.Row="0" Grid.Column="1" Padding="16" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <StackPanel Spacing="8">
            <FontIcon Glyph="&#xE7B3;" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Text="Heron sighting, 6 Oct" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock Text="Great blue heron at the east pond, 07:40. Two juveniles nearby." Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </Border>
        <Border Grid.Row="0" Grid.Column="2" Padding="16" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <StackPanel Spacing="8">
            <FontIcon Glyph="&#xE9D9;" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Text="Soil sample log" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock Text="Twelve samples from the lower meadow. pH trending slightly acidic." Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Grid.Column="0" Padding="16" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <StackPanel Spacing="8">
            <FontIcon Glyph="&#xE736;" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Text="Lichen field guide" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock Text="Draft of 18 species with photos and habitat notes." Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Grid.Column="1" Padding="16" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <StackPanel Spacing="8">
            <FontIcon Glyph="&#xE9CA;" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Text="Weather station notes" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock Text="Sensor drift on the rain gauge. Recalibrate after the next dry spell." Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Grid.Column="2" Padding="16" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <StackPanel Spacing="8">
            <FontIcon Glyph="&#xE722;" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Text="Camera trap schedule" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock Text="Swap SD cards on the 15th. Batteries at 40 percent on cams 2 and 5." Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</Page>
