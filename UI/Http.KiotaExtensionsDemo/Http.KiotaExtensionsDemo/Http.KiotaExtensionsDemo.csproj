<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-browserwasm;net10.0-desktop;net10.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>Http.KiotaExtensionsDemo</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.companyname.http-kiotaextensionsdemo</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>Http.KiotaExtensionsDemo</ApplicationPublisher>
    <!-- Package Description -->
    <Description>Http.KiotaExtensionsDemo powered by Uno Platform.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      SimpleTheme;
      Hosting;
      Toolkit;
      Logging;
      MVUX;
      Configuration;
      HttpKiota;
      Serialization;
      Localization;
      Navigation;
      ThemeService;
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

  <!--
    Debug builds carry Uno's Hot Design and App MCP tooling, whose current packages (Uno.UI.HotDesign
    2.0.0-dev.31 with Uno.Sdk 7.0.0-dev.115) still reference Uno.UI.Lottie, which Uno.WinUI no
    longer ships: without this package a Debug build hangs at startup with no window on desktop
    (unoplatform/uno.extensions#3262). Remove once those tooling packages ship without the reference.
  -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Uno.WinUI.Lottie" />
  </ItemGroup>

  <!--
    The plain net10.0 target exists so the test project can reference the app; it is not a head.
    Uno's source generators still emit a module initializer that loads the native ICU library
    (icuuc77) into it, which is not there under a test host: every test that touches an app type then
    fails with "System.Exception: Failed to load 'icuuc77'". Skip that generator for this target only.
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <SkipIcuDataInitializerGenerator>true</SkipIcuDataInitializerGenerator>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <CompilerVisibleProperty Include="SkipIcuDataInitializerGenerator" />
  </ItemGroup>

</Project>
