<?xml version="1.0" encoding="utf-8"?>
<!--
  The sample's server is plain HTTP on the development machine, which the emulator reaches at
  10.0.2.2 (App.xaml.cs, ApiUrl). Android blocks cleartext traffic by default; this allows it to that
  address only. A deployed API serves HTTPS and needs none of this.
-->
<network-security-config>
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">10.0.2.2</domain>
  </domain-config>
</network-security-config>
