<Page x:Class="Http.KiotaExtensionsDemo.Presentation.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      NavigationCacheMode="Required"
      Background="{ThemeResource BackgroundBrush}">

  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <utu:NavigationBar Content="Tasks">
      <utu:NavigationBar.PrimaryCommands>
        <AppBarButton Label="New task"
                      Command="{Binding NewTask}"
                      AutomationProperties.AutomationId="NewTaskButton">
          <AppBarButton.Icon>
            <SymbolIcon Symbol="Add" />
          </AppBarButton.Icon>
        </AppBarButton>
      </utu:NavigationBar.PrimaryCommands>
    </utu:NavigationBar>

    <!-- The summary: the server answers 503 to its first two calls; Kiota's retry handler waits out
         Retry-After, so this shows the progress template for about two seconds, then the numbers. -->
    <mvux:FeedView x:Name="SummaryFeed"
                   Grid.Row="1"
                   Margin="16,8"
                   Source="{Binding Summary}">
      <DataTemplate>
        <utu:CardContentControl Content="{Binding Data}"
                                IsClickable="False"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource FilledCardContentControlStyle}"
                                AutomationProperties.AutomationId="SummaryCard">
          <utu:CardContentControl.ContentTemplate>
            <DataTemplate>
              <StackPanel Padding="16" Spacing="4">
                <TextBlock Style="{StaticResource TitleMedium}" Text="Summary" />
                <StackPanel Orientation="Horizontal" Spacing="24">
                  <TextBlock Style="{StaticResource BodyLarge}" AutomationProperties.AutomationId="SummaryTotal">
                    <Run Text="{Binding Total}" /> <Run Text="tasks" />
                  </TextBlock>
                  <TextBlock Style="{StaticResource BodyLarge}">
                    <Run Text="{Binding Done}" /> <Run Text="done" />
                  </TextBlock>
                  <TextBlock Style="{StaticResource BodyLarge}" Foreground="{ThemeResource ErrorBrush}">
                    <Run Text="{Binding Overdue}" /> <Run Text="overdue" />
                  </TextBlock>
                </StackPanel>
                <TextBlock Style="{StaticResource BodySmall}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}"
                           Text="{Binding ByPriorityText}" />
              </StackPanel>
            </DataTemplate>
          </utu:CardContentControl.ContentTemplate>
        </utu:CardContentControl>
      </DataTemplate>
      <mvux:FeedView.ProgressTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal" Spacing="8" Padding="16">
            <ProgressRing IsActive="True" Width="20" Height="20" />
            <TextBlock Style="{StaticResource BodyMedium}" Text="Computing the summary (the server warms up first)..." />
          </StackPanel>
        </DataTemplate>
      </mvux:FeedView.ProgressTemplate>
      <mvux:FeedView.ErrorTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal" Spacing="8" Padding="16">
            <TextBlock Style="{StaticResource BodyMedium}"
                       Foreground="{ThemeResource ErrorBrush}"
                       VerticalAlignment="Center"
                       AutomationProperties.AutomationId="SummaryError"
                       Text="The summary could not be loaded." />
            <Button Content="Retry"
                    Command="{Binding Refresh, ElementName=SummaryFeed}"
                    AutomationProperties.AutomationId="SummaryRetryButton" />
          </StackPanel>
        </DataTemplate>
      </mvux:FeedView.ErrorTemplate>
    </mvux:FeedView>

    <Grid Grid.Row="2" Margin="16,0,16,8" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox PlaceholderText="Search titles"
               Text="{Binding Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               AutomationProperties.AutomationId="SearchBox" />
      <ComboBox Grid.Column="1"
                MinWidth="120"
                ItemsSource="{Binding Filters}"
                SelectedItem="{Binding Filter, Mode=TwoWay}"
                AutomationProperties.AutomationId="DoneFilterComboBox" />
    </Grid>

    <mvux:FeedView x:Name="TasksFeed" Grid.Row="3" Source="{Binding Items}">
      <DataTemplate>
        <ListView ItemsSource="{Binding Data}"
                  IsItemClickEnabled="True"
                  SelectionMode="None"
                  uen:Navigation.Request="TaskDetails"
                  AutomationProperties.AutomationId="TasksList">
          <ListView.ItemTemplate>
            <DataTemplate>
              <Grid Padding="16,8" ColumnSpacing="12" AutomationProperties.AutomationId="{Binding Id}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding Done}" IsEnabled="False" MinWidth="0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Style="{StaticResource BodyLarge}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Style="{StaticResource BodySmall}"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}"
                             Text="{Binding Details}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </DataTemplate>
      <mvux:FeedView.NoneTemplate>
        <DataTemplate>
          <TextBlock Margin="16"
                     Style="{StaticResource BodyMedium}"
                     AutomationProperties.AutomationId="TasksEmpty"
                     Text="No tasks match." />
        </DataTemplate>
      </mvux:FeedView.NoneTemplate>
      <mvux:FeedView.ErrorTemplate>
        <DataTemplate>
          <StackPanel Margin="16" Spacing="8">
            <TextBlock Style="{StaticResource TitleSmall}"
                       Foreground="{ThemeResource ErrorBrush}"
                       AutomationProperties.AutomationId="TasksError"
                       Text="The tasks could not be loaded." />
            <TextBlock Style="{StaticResource BodySmall}" TextWrapping="Wrap" Text="{Binding Message}" />
            <Button Content="Retry"
                    Command="{Binding Refresh, ElementName=TasksFeed}"
                    AutomationProperties.AutomationId="TasksRetryButton" />
          </StackPanel>
        </DataTemplate>
      </mvux:FeedView.ErrorTemplate>
    </mvux:FeedView>

    <!-- /api/status is text/plain. -->
    <mvux:FeedView Grid.Row="4" Padding="16,8" Source="{Binding Status}">
      <DataTemplate>
        <TextBlock Style="{StaticResource BodySmall}"
                   Foreground="{ThemeResource OnSurfaceVariantBrush}"
                   AutomationProperties.AutomationId="StatusText"
                   Text="{Binding Data}" />
      </DataTemplate>
      <mvux:FeedView.ErrorTemplate>
        <DataTemplate>
          <TextBlock Style="{StaticResource BodySmall}"
                     Foreground="{ThemeResource ErrorBrush}"
                     AutomationProperties.AutomationId="StatusError"
                     Text="Server unreachable." />
        </DataTemplate>
      </mvux:FeedView.ErrorTemplate>
    </mvux:FeedView>
  </Grid>
</Page>
